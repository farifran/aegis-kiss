{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.contract_ir.v2",
  "title": "Aegis Semantic Contract IR v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "changeKind", "clarifiedDemandDigest", "architecture", "scope", "behavior", "invariants", "proofObligations", "requirementCoverage"],
  "properties": {
    "schema": { "const": "aegis.contract_ir.v2" },
    "changeKind": { "enum": ["PRODUCT", "HARNESS"] },
    "clarifiedDemandDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyDigest", "appliedRuleIds", "amendmentIds"],
      "properties": {
        "policyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "appliedRuleIds": { "type": "array", "items": { "type": "string", "pattern": "^ARCH-[A-Z0-9][A-Z0-9-]+$" }, "uniqueItems": true },
        "amendmentIds": { "type": "array", "items": { "type": "string", "pattern": "^ARCH-AMEND-[A-Z0-9][A-Z0-9-]+$" }, "uniqueItems": true }
      }
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "stateModel": {
      "$ref": "#/$defs/stateModel"
    },
    "clarifications": { "type": "array", "items": { "$ref": "#/$defs/clarification" } },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorizedPaths"],
      "properties": {
        "authorizedPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+" }, "uniqueItems": true }
      }
    },
    "behavior": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/statement" }
    },
    "preconditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/statement" }
    },
    "invariants": {
      "type": "array",
      "items": { "$ref": "#/$defs/invariant" }
    },
    "postconditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/statement" }
    },
    "failureSemantics": {
      "type": "array",
      "items": { "$ref": "#/$defs/statement" }
    },
    "proofObligations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/proofObligation" }
    },
    "requirementCoverage": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirementCoverage" }
    },
    "continuity": {
      "$ref": "#/$defs/continuity"
    }
  },
  "$defs": {
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "proofIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^INV-[A-Z0-9][A-Z0-9-]+$" },
        "statement": { "type": "string", "minLength": 1 },
        "proofIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^PO-[A-Z0-9][A-Z0-9-]+$" }, "uniqueItems": true }
      }
    },
    "proofObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "risk", "statement"],
      "properties": {
        "id": { "type": "string", "pattern": "^PO-[A-Z0-9][A-Z0-9-]+$" },
        "risk": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["riskProfile"],
      "properties": {
        "riskProfile": { "enum": ["standard", "forensic"] },
        "independentReviewDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "riskProfile": { "const": "forensic" } }, "required": ["riskProfile"] },
          "then": { "required": ["independentReviewDigest"] }
        }
      ]
    },
    "semanticBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "statement", "requirementIds"],
      "properties": {
        "role": { "enum": ["STATE", "COMMAND", "IDENTITY", "RESOURCE", "TEMPORAL", "RESULT", "ATOMICITY", "CANONICALIZATION"] },
        "statement": { "type": "string", "minLength": 1 },
        "requirementIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9-]+$" }, "uniqueItems": true }
      }
    },
    "stateModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "bindings"],
      "properties": {
        "kind": { "enum": ["NONE", "STATE_TRANSITION"] },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/semanticBinding" } },
        "policies": { "type": "array", "items": { "$ref": "#/$defs/semanticPolicy" } }
      }
    },
    "semanticPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "provenance", "statement", "sourceUnitIds"],
      "properties": {
        "role": { "enum": ["STATE", "COMMAND", "IDENTITY", "RESOURCE", "TEMPORAL", "RESULT", "ATOMICITY", "CANONICALIZATION"] },
        "provenance": { "enum": ["USER", "USER_CLARIFICATION"] },
        "statement": { "type": "string", "minLength": 1 },
        "sourceUnitIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^UNIT-[0-9]{4}$" }, "uniqueItems": true }
      }
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "answerId", "recommended", "statement"],
      "properties": {
        "questionId": { "type": "string", "pattern": "^Q-[A-Z0-9][A-Z0-9-]+$" },
        "answerId": { "type": "string", "minLength": 1 },
        "recommended": { "type": "boolean" },
        "statement": { "type": "string", "minLength": 1 }
      }
    },
    "requirementCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "contractIds"],
      "properties": {
        "requirementId": { "type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9-]+$" },
        "contractIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^(?:[A-Z][A-Z0-9-]+|INV-[A-Z0-9][A-Z0-9-]+|PO-[A-Z0-9][A-Z0-9-]+)$" },
          "uniqueItems": true
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/retirement" }
        },
        "proofChanges": {
          "type": "array",
          "items": { "$ref": "#/$defs/proofChange" }
        }
      }
    },
    "retirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "reason", "demandEvidence"],
      "properties": {
        "kind": { "enum": ["proof", "target"] },
        "id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "demandEvidence": { "type": "string", "minLength": 1 },
        "successor": { "type": "string", "minLength": 1 }
      }
    },
    "proofChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason", "demandEvidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^PO-[A-Z0-9][A-Z0-9-]+$" },
        "reason": { "type": "string", "minLength": 1 },
        "demandEvidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
