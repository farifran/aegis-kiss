{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.semantic_opinion.v2",
  "title": "Aegis Semantic Opinion v2",
  "description": "Preencha somente juízos semânticos. Todos os índices são base zero. Índices de requisitos, invariantes, riscos, decisões, notas, caminhos e regras de fronteira apontam para arrays deste parecer. intentSignalIndexes apontam para intentSignals.signals da solicitação; contextIndex para policy.contexts; ruleIndex e amendmentIndex para policy.rules e policy.amendments; resolutionIndex e targets RESOLVED_DECISION para revision.answers. Cada determinismReview.dimension declara kind e subject; kinds podem repetir para subjects diferentes e todos os kinds exigidos pela worksheet devem estar cobertos. O Harness valida os vínculos e compila schema final, IDs, referências resolvidas, estados agregados, digests, envelope e aprovação.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "worksheetDigest",
    "title",
    "interpretation",
    "changeKind",
    "scope",
    "intentClaims",
    "nonNormativeItems",
    "pathReferences",
    "architectureContexts",
    "policyAssessments",
    "complexityReview",
    "requirements",
    "invariants",
    "riskReview",
    "risks",
    "adversarialReview",
    "determinismReview",
    "boundaryRules",
    "unknowns",
    "decisions"
  ],
  "properties": {
    "schema": {
      "const": "aegis.semantic_opinion.v2"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "changeKind": {
      "enum": [
        "PRODUCT",
        "HARNESS"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "description": "Declare somente comportamentos e fronteiras públicas observáveis. Caminhos são classificados separadamente em pathReferences.",
      "required": [
        "inScope",
        "outOfScope"
      ],
      "properties": {
        "inScope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "outOfScope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "intentClaims": {
      "type": "array",
      "minItems": 1,
      "description": "Mapa auditável e atômico das afirmações materiais da demanda. Cada citação é literal e recebe uma única destinação. Afirmações normativas repetem a citação em contractEffect, que deve aparecer literalmente no requisito ou prova de destino.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quote",
          "kind",
          "disposition",
          "contractEffect",
          "targets",
          "rationale"
        ],
        "properties": {
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "kind": {
            "enum": [
              "OBLIGATION",
              "PROHIBITION",
              "GOAL",
              "OPTION",
              "EXAMPLE",
              "AMBIGUITY"
            ]
          },
          "disposition": {
            "enum": [
              "NORMATIVE",
              "DECISION",
              "POLICY_CORRECTION",
              "NON_NORMATIVE"
            ]
          },
          "contractEffect": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/targetRef"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "nonNormativeItems": {
      "type": "array",
      "description": "Preserva metas, opções e exemplos sem promovê-los a obrigação, meta numérica ou decisão artificial.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "statement",
          "intentSignalIndexes",
          "basis"
        ],
        "properties": {
          "kind": {
            "enum": [
              "GOAL",
              "OPTION",
              "EXAMPLE"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "$ref": "#/$defs/basis"
          },
          "intentSignalIndexes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          }
        }
      }
    },
    "pathReferences": {
      "type": "array",
      "description": "Classifica caminhos citados sem confundir superfície pública, restrição interna explícita, sugestão não normativa e evidência observada.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "role",
          "rationale",
          "requirementIndexes",
          "basis"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/repositoryPath"
          },
          "role": {
            "enum": [
              "PUBLIC_SURFACE",
              "IMPLEMENTATION_CONSTRAINT",
              "IMPLEMENTATION_SUGGESTION",
              "EVIDENCE_ONLY"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "$ref": "#/$defs/basis"
          },
          "requirementIndexes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          }
        }
      }
    },
    "architectureContexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contextIndex",
          "rationale",
          "basis"
        ],
        "properties": {
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "$ref": "#/$defs/basis"
          },
          "contextIndex": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "policyAssessments": {
      "type": "array",
      "description": "Avalie exatamente as regras ativadas pelos contextos declarados ou por referências explícitas da demanda.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleIndex",
          "demandStatus",
          "recommendedStatus",
          "rationale",
          "decisionIndex",
          "amendmentIndex"
        ],
        "properties": {
          "demandStatus": {
            "enum": [
              "COMPLIANT",
              "CONFLICT"
            ]
          },
          "recommendedStatus": {
            "enum": [
              "COMPLIANT",
              "AMENDED"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "ruleIndex": {
            "type": "integer",
            "minimum": 0
          },
          "decisionIndex": {
            "description": "Índice da decisão somente quando já existem alternativas maduras e materialmente distintas. Use null para lacuna material bloqueante que ainda não pode chegar ao Wizard.",
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "amendmentIndex": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "complexityReview": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pode simplificar automaticamente complexidade apenas sugerida. Não crie decisão quando KISS já determinar a resposta.",
      "required": [
        "status",
        "rationale",
        "alternatives"
      ],
      "properties": {
        "status": {
          "enum": [
            "NO_EXCESS",
            "SIMPLIFIED",
            "JUSTIFIED"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requested",
              "simpler",
              "rationale",
              "basis"
            ],
            "properties": {
              "requested": {
                "type": "string",
                "minLength": 1
              },
              "simpler": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "$ref": "#/$defs/basis"
              }
            }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "statement",
          "basis",
          "intentSignalIndexes",
          "measurement",
          "acceptanceCases"
        ],
        "properties": {
          "kind": {
            "enum": [
              "FUNCTIONAL",
              "QUALITY"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "$ref": "#/$defs/basis"
          },
          "measurement": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/measurement"
              }
            ]
          },
          "acceptanceCases": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "given",
                "when",
                "then",
                "outcomeKind",
                "decisionBinding",
                "boundaryBinding"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "HAPPY_PATH",
                    "FAILURE",
                    "BOUNDARY"
                  ]
                },
                "given": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "then": {
                  "type": "string",
                  "minLength": 1
                },
                "outcomeKind": {
                  "enum": [
                    "RETURN_VALUE",
                    "REJECTION",
                    "NO_OP",
                    "STATE_CHANGE",
                    "OBSERVABLE_EFFECT"
                  ]
                },
                "decisionBinding": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/decisionBinding"
                    }
                  ]
                },
                "boundaryBinding": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/boundaryBinding"
                    }
                  ]
                }
              }
            }
          },
          "intentSignalIndexes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "QUALITY"
                }
              }
            },
            "then": {
              "properties": {
                "measurement": {
                  "$ref": "#/$defs/measurement"
                }
              }
            },
            "else": {
              "properties": {
                "measurement": {
                  "const": null
                }
              }
            }
          }
        ]
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "falsification",
          "requirementIndexes"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "falsification": {
            "type": "string",
            "minLength": 1
          },
          "requirementIndexes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "level",
          "statement",
          "mitigation",
          "requirementIndexes",
          "basis"
        ],
        "properties": {
          "kind": {
            "enum": [
              "SECURITY",
              "RELIABILITY",
              "PRIVACY",
              "PERFORMANCE",
              "INTEGRITY",
              "COMPLEXITY"
            ]
          },
          "level": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "mitigation": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "$ref": "#/$defs/basis"
          },
          "requirementIndexes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          }
        }
      }
    },
    "riskReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certainty",
        "rationale"
      ],
      "properties": {
        "certainty": {
          "enum": [
            "ASSESSED",
            "UNKNOWN"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adversarialReview": {
      "type": "object",
      "additionalProperties": false,
      "description": "Revisão semântica residual: procure contradições, deriva semântica, omissões, lacunas de determinismo e perguntas artificiais depois das correções mecânicas e de política. Registre somente achados materiais já absorvidos pelo contrato.",
      "required": [
        "rationale",
        "findings"
      ],
      "properties": {
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "disposition",
              "challenge",
              "response",
              "targets",
              "basis"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "CONTRADICTION",
                  "SEMANTIC_DRIFT",
                  "OMISSION",
                  "DETERMINISM_GAP",
                  "ARTIFICIAL_DECISION",
                  "TECHNICAL_RISK"
                ]
              },
              "disposition": {
                "enum": [
                  "REQUIREMENT",
                  "DECISION",
                  "POLICY_CORRECTION",
                  "NON_NORMATIVE"
                ]
              },
              "challenge": {
                "type": "string",
                "minLength": 1
              },
              "response": {
                "type": "string",
                "minLength": 1,
                "description": "Trecho da correção já incorporada em pelo menos um targetId; não é promessa paralela."
              },
              "basis": {
                "$ref": "#/$defs/basis"
              },
              "targets": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/targetRef"
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "determinismReview": {
      "type": "object",
      "additionalProperties": false,
      "description": "Reporte somente dimensões de determinismo materialmente aplicáveis a um subject observável. Sem regra autorizada, ausência estrutural ou decisão material, preserve GAP_FOUND; não gere stubs para dimensões irrelevantes.",
      "required": [
        "rationale",
        "dimensions"
      ],
      "properties": {
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "description": "Cada item declara uma dimensão e seu subject. Uma dimensão pode repetir-se para subjects diferentes. SPECIFIED exige regra única e obrigação de prova vinculada ao witness; NOT_APPLICABLE exige ausência estrutural autorizada; DECISION_REQUIRED exige uma única decisão sobre o mesmo subject, cobrindo literalmente os dois lados do witness e resolvendo a própria dimensão em cada alternativa; GAP_FOUND preserva lacuna sem alternativas maduras.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "subject",
              "status",
              "rationale",
              "targets",
              "basis",
              "acceptanceCase",
              "proofObligation",
              "inapplicabilityProof"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "ORDERING",
                  "CANONICALIZATION",
                  "DUPLICATES",
                  "EMPTY_INPUT",
                  "ODD_CARDINALITY",
                  "ROUNDING",
                  "REMAINDER_DISTRIBUTION",
                  "ZERO_DIVISOR",
                  "TIE_BREAKING",
                  "COUNTING_IDENTITY",
                  "BOUNDED_ARITHMETIC"
                ]
              },
              "subject": {
                "oneOf": [
                  { "type": "null" },
                  { "$ref": "#/$defs/targetRef" }
                ]
              },
              "status": {
                "enum": [
                  "SPECIFIED",
                  "NOT_APPLICABLE",
                  "DECISION_REQUIRED",
                  "GAP_FOUND"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "description": "Para SPECIFIED, contém a regra autorizada que sustenta a resolução tipada; os resultados exatos do witness ficam em proofObligation e precisam ser reproduzidos exatamente no acceptance case."
              },
              "basis": {
                "$ref": "#/$defs/basis"
              },
              "targets": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/targetRef"
                },
                "uniqueItems": true
              },
              "acceptanceCase": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/acceptanceCaseRef"
                  }
                ]
              },
              "proofObligation": {
                "oneOf": [
                  { "type": "null" },
                  { "$ref": "#/$defs/determinismProofObligation" }
                ]
              },
              "inapplicabilityProof": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/inapplicabilityProof"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "boundaryRules": {
      "type": "array",
      "description": "Declara comportamento observável para representações finitas. Um campo posicional que codifica quantidade exige duas regras ligadas ao mesmo sinal: REPRESENTATION_WIDTH para a posição/largura e ENCODED_VALUE para domínio e extrapolação. Largura nunca prova overflow.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "representationKind",
          "lowerBound",
          "upperBound",
          "underflowBehavior",
          "overflowBehavior",
          "decisionIndex",
          "requirementIndexes",
          "acceptanceCases",
          "intentSignalIndexes",
          "basis"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "representationKind": {
            "enum": [
              "REPRESENTATION_WIDTH",
              "ENCODED_VALUE"
            ],
            "description": "REPRESENTATION_WIDTH prova apenas formato/largura. ENCODED_VALUE descreve o domínio do valor inserido e exige política para extrapolação."
          },
          "lowerBound": {
            "type": "string",
            "minLength": 1
          },
          "upperBound": {
            "type": "string",
            "minLength": 1
          },
          "underflowBehavior": {
            "$ref": "#/$defs/rangeBehavior"
          },
          "overflowBehavior": {
            "$ref": "#/$defs/rangeBehavior"
          },
          "basis": {
            "$ref": "#/$defs/basis"
          },
          "decisionIndex": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "requirementIndexes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          },
          "acceptanceCases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/acceptanceCaseRef"
            },
            "uniqueItems": true
          },
          "intentSignalIndexes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "material",
          "decisionIndex",
          "intentSignalIndexes",
          "basis"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "material": {
            "type": "boolean"
          },
          "basis": {
            "$ref": "#/$defs/basis"
          },
          "decisionIndex": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "intentSignalIndexes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "description": "Cada recomendação precisa estar materializada em ao menos um caso falsificável ligado ao answerId recomendado.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "recommendedAnswerIndex",
          "requirementIndexes",
          "invariantIndexes",
          "riskIndexes",
          "answers",
          "distinguishingCase"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answers": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "rationale",
                "contractEffect"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                },
                "contractEffect": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "recommendedAnswerIndex": {
            "type": "integer",
            "minimum": 0
          },
          "requirementIndexes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          },
          "invariantIndexes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          },
          "riskIndexes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "uniqueItems": true
          },
          "distinguishingCase": {
            "type": "object",
            "additionalProperties": false,
            "description": "Um mesmo cenário no qual as alternativas produzem resultados observáveis diferentes. Sem esse testemunho não existe decisão humana material.",
            "required": [
              "given",
              "when",
              "outcomes"
            ],
            "properties": {
              "given": {
                "type": "string",
                "minLength": 1
              },
              "when": {
                "type": "string",
                "minLength": 1
              },
              "outcomes": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "answerIndex",
                    "then"
                  ],
                  "properties": {
                    "answerIndex": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "then": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "worksheetDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Cópia obrigatória do worksheetDigest recebido; não é uma conclusão semântica."
    }
  },
  "$defs": {
    "basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/basisRef"
      }
    },
    "basisRef": {
      "description": "Selecione uma fonte verificável. resolutionIndex aponta para revision.answers; referências textuais são validadas pelo Harness contra a intenção, Constituição, política ou evidência disponível.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "resolutionIndex"
          ],
          "properties": {
            "source": {
              "const": "USER_DECISION"
            },
            "resolutionIndex": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "reference"
          ],
          "properties": {
            "source": {
              "enum": [
                "USER_INTENT",
                "CONSTITUTION",
                "ARCHITECTURE_POLICY",
                "SAFE_MECHANICAL_DEFAULT",
                "WORKSPACE_EVIDENCE",
                "MODEL_ANALYSIS"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        }
      ]
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\.\\.?$)(?!\\.\\./)(?!.*\\/\\.\\.(?:/|$))[^\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069]+$"
    },
    "decisionBinding": {
      "description": "Vínculo posicional com decisions[decisionIndex].answers[answerIndex] deste parecer.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionIndex",
        "answerIndex"
      ],
      "properties": {
        "decisionIndex": {
          "type": "integer",
          "minimum": 0
        },
        "answerIndex": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "boundaryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundaryIndex",
        "side",
        "expectedBehavior",
        "expectedValue"
      ],
      "properties": {
        "boundaryIndex": {
          "type": "integer",
          "minimum": 0
        },
        "side": {
          "enum": [
            "UNDERFLOW",
            "OVERFLOW",
            "EXACT_WIDTH"
          ]
        },
        "expectedBehavior": {
          "$ref": "#/$defs/rangeBehavior"
        },
        "expectedValue": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "metric",
        "target",
        "conditions"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "source",
                "resolutionIndex",
                "evidenceStatus"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "const": "USER_DECISION"
                },
                "resolutionIndex": {
                  "type": "integer",
                  "minimum": 0
                },
                "evidenceStatus": {
                  "enum": [
                    "EVIDENCE_BACKED",
                    "UNVERIFIED"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "source",
                "reference",
                "evidenceStatus"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "enum": [
                    "USER_INTENT",
                    "WORKSPACE_EVIDENCE"
                  ]
                },
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "evidenceStatus": {
                  "enum": [
                    "EVIDENCE_BACKED",
                    "UNVERIFIED"
                  ]
                }
              }
            }
          ]
        },
        "conditions": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rangeBehavior": {
      "enum": [
        "REJECT",
        "SATURATE",
        "EXPLICIT_SENTINEL",
        "WRAP",
        "NOT_APPLICABLE"
      ]
    },
    "targetRef": {
      "description": "Vínculo posicional. POLICY_RULE aponta para policy.rules da solicitação; RESOLVED_DECISION aponta para revision.answers; os demais tipos apontam para o array correspondente deste parecer.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "index"
      ],
      "properties": {
        "kind": {
          "enum": [
            "REQUIREMENT",
            "INVARIANT",
            "RISK",
            "DECISION",
            "RESOLVED_DECISION",
            "NON_NORMATIVE_ITEM",
            "PATH_REFERENCE",
            "BOUNDARY_RULE",
            "POLICY_RULE"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "acceptanceCaseRef": {
      "description": "Vínculo posicional com requirements[requirementIndex].acceptanceCases[caseIndex] deste parecer.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementIndex",
        "caseIndex"
      ],
      "properties": {
        "requirementIndex": {
          "type": "integer",
          "minimum": 0
        },
        "caseIndex": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "inapplicabilityProof": {
      "type": "object",
      "additionalProperties": false,
      "description": "Prova autorizada de que a estrutura que ativaria a dimensão não existe na fronteira pública contratada.",
      "required": [
        "proofKind",
        "structuralRule",
        "absentStructure",
        "evidence"
      ],
      "properties": {
        "proofKind": { "const": "STRUCTURAL_ABSENCE" },
        "structuralRule": {
          "enum": [
            "OPERATION_ABSENT",
            "INPUT_CLASS_FORBIDDEN",
            "INPUT_SCHEMA_EXCLUDES_CLASS"
          ]
        },
        "absentStructure": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "determinismProofObligation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Resolução semântica do witness. O Harness acrescenta witnessId, valida se resolutionKind pertence à dimensão, se relation é compatível e se o AC contém exatamente os dois resultados. O campo then do AC deve ser: Base: <baselineOutcome>; Variação: <variationOutcome>; Resolução: <resolutionKind>. Quando houver parâmetro: Resolução: <resolutionKind> (<resolutionParameter>).",
      "required": [
        "relation",
        "resolutionKind",
        "resolutionParameter",
        "baselineOutcome",
        "variationOutcome",
        "observables"
      ],
      "properties": {
        "relation": { "enum": ["OUTPUTS_EQUAL", "DEFINED_RESULT", "EXPLICIT_REJECTION"] },
        "resolutionKind": {
          "enum": [
            "INPUT_ORDER_PRESERVED",
            "CANONICAL_ORDER",
            "PERMUTATION_INVARIANT",
            "CANONICAL_REPRESENTATION",
            "DUPLICATES_PRESERVED",
            "DUPLICATES_MERGED",
            "DUPLICATES_REJECTED",
            "EMPTY_RETURNS_IDENTITY",
            "EMPTY_REJECTED",
            "ODD_DUPLICATE_LAST",
            "ODD_PROMOTE_LAST",
            "ODD_REJECTED",
            "ROUND_TRUNCATE_TOWARD_ZERO",
            "ROUND_FLOOR",
            "ROUND_CEILING",
            "ROUND_EXACT_ONLY",
            "REMAINDER_RETAINED",
            "REMAINDER_DISTRIBUTED_BY_RULE",
            "REMAINDER_REJECTED",
            "ZERO_DIVISOR_REJECTED",
            "ZERO_DIVISOR_RETURNS_ZERO",
            "ZERO_DIVISOR_RETURNS_SENTINEL",
            "TIE_BREAK_BY_KEY",
            "TIE_PRESERVE_INPUT_ORDER",
            "COUNT_UNIQUE_IDENTITIES",
            "COUNT_OCCURRENCES",
            "OVERFLOW_REJECT",
            "OVERFLOW_SATURATE",
            "OVERFLOW_WRAP",
            "OVERFLOW_MODULO"
          ]
        },
        "resolutionParameter": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 240
        },
        "baselineOutcome": { "type": "string", "minLength": 1, "maxLength": 240 },
        "variationOutcome": { "type": "string", "minLength": 1, "maxLength": 240 },
        "observables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 120 }
        }
      }
    }
  }
}
