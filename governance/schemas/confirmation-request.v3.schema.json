{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.confirmation_request.v3",
  "title": "Aegis Human Confirmation Request v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "executionId",
    "contractDraftDigest",
    "title",
    "recommendationPolicy",
    "requiredAttestation",
    "questions",
    "artifactPath"
  ],
  "properties": {
    "schema": { "const": "aegis.confirmation_request.v3" },
    "status": { "const": "USER_CONFIRMATION_REQUIRED" },
    "executionId": { "type": "string", "pattern": "^draft-[a-f0-9]{16}$" },
    "contractDraftDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "title": { "type": "string", "minLength": 1 },
    "recommendationPolicy": { "const": "RECOMMENDATIONS_ARE_NOT_HUMAN_DECISIONS" },
    "requiredAttestation": { "const": "CONTRACT_REVIEWED_AND_APPROVED" },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "recommendedAnswerId", "gaps", "requirementIds", "acceptanceCaseIds", "invariantIds", "riskIds", "answers"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "recommendedAnswerId": { "type": "string", "minLength": 1 },
          "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "requirementIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "acceptanceCaseIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "invariantIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "riskIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "answers": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "rationale", "recommended"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "rationale": { "type": "string", "minLength": 1 },
                "recommended": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "artifactPath": { "const": ".harness/runtime/contract.md" }
  }
}
