{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.semantic_draft.v9",
  "title": "Aegis Compiled Semantic Draft v9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "sourceContextDigest", "sourceEvidenceDigest", "title", "interpretation", "changeKind", "scope",
    "fragmentDispositions", "intentClaims", "nonNormativeItems", "pathReferences", "architectureContexts",
    "policyAssessments", "complexityReview", "requirements", "invariants", "riskReview", "risks",
    "adversarialReview", "determinismReview", "boundaryRules", "unknowns", "decisions"
  ],
  "properties": {
    "schema": { "const": "aegis.semantic_draft.v9" },
    "sourceContextDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceEvidenceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "title": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_title" },
    "interpretation": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_interpretation" },
    "changeKind": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_changeKind" },
    "scope": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_scope" },
    "fragmentDispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fragmentId", "status", "claimIds", "rationale"],
        "properties": {
          "fragmentId": { "type": "string", "pattern": "^FRAG-[0-9]{4}$" },
          "status": { "enum": ["CLAIMS_EXTRACTED", "CONTEXT_ONLY", "UNCLEAR"] },
          "claimIds": { "type": "array", "items": { "type": "string", "pattern": "^CLAIM-[A-Z0-9][A-Z0-9-]+$" }, "uniqueItems": true },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "intentClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "quote", "sourceFragmentIds", "kind", "disposition", "contractEffect", "targetIds", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^CLAIM-[A-Z0-9][A-Z0-9-]+$" },
          "quote": { "type": "string", "minLength": 1, "maxLength": 240 },
          "sourceFragmentIds": { "$ref": "#/$defs/sourceFragmentIds" },
          "kind": { "enum": ["OBLIGATION", "PROHIBITION", "GOAL", "OPTION", "EXAMPLE", "AMBIGUITY"] },
          "disposition": { "enum": ["NORMATIVE", "DECISION", "POLICY_CORRECTION", "NON_NORMATIVE"] },
          "contractEffect": { "type": ["string", "null"], "minLength": 1 },
          "targetIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(?:(REQ|Q|NOTE|PATH|ARCH|BOUND)-[A-Z0-9][A-Z0-9-]+|decision/[a-z0-9-]+/[a-z0-9-]+)$" }, "uniqueItems": true },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nonNormativeItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "statement", "status", "sourceFragmentIds", "basis"],
        "properties": {
          "id": { "type": "string", "pattern": "^NOTE-[A-Z0-9][A-Z0-9-]+$" },
          "kind": { "enum": ["GOAL", "OPTION", "EXAMPLE"] },
          "statement": { "type": "string", "minLength": 1 },
          "status": { "const": "NON_NORMATIVE" },
          "sourceFragmentIds": { "$ref": "#/$defs/sourceFragmentIds" },
          "basis": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_basis" }
        }
      }
    },
    "pathReferences": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_pathReferences" },
    "architectureContexts": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_architectureContexts" },
    "policyAssessments": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_policyAssessments" },
    "complexityReview": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_complexityReview" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "statement", "basis", "sourceFragmentIds", "measurement", "acceptanceCases"],
        "properties": {
          "id": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_requirements_items_properties_id" },
          "kind": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_requirements_items_properties_kind" },
          "statement": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_requirements_items_properties_statement" },
          "basis": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_basis" },
          "sourceFragmentIds": { "$ref": "#/$defs/sourceFragmentIds" },
          "measurement": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_requirements_items_properties_measurement" },
          "acceptanceCases": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_requirements_items_properties_acceptanceCases" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "QUALITY" } } },
            "then": { "properties": { "measurement": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_measurement" } } },
            "else": { "properties": { "measurement": { "const": null } } }
          }
        ]
      }
    },
    "invariants": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_invariants" },
    "riskReview": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_riskReview" },
    "risks": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_risks" },
    "adversarialReview": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_adversarialReview" },
    "determinismReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "sourceFragmentIds", "coverage", "dimensions"],
      "properties": {
        "status": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_determinismReview_properties_status" },
        "rationale": { "type": "string", "minLength": 1 },
        "sourceFragmentIds": { "type": "array", "items": { "type": "string", "pattern": "^FRAG-[0-9]{4}$" }, "uniqueItems": true },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claimId", "disposition", "dimensions", "rationale"],
            "properties": {
              "claimId": { "type": "string", "pattern": "^CLAIM-[A-Z0-9][A-Z0-9-]+$" },
              "disposition": { "enum": ["DIMENSIONS_DECLARED", "NO_DIMENSION_APPLICABLE"] },
              "dimensions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "subjectId"],
                  "properties": {
                    "kind": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,79}$" },
                    "subjectId": { "type": "string", "pattern": "^(PUBLIC_CONTRACT|REQ-[A-Z0-9][A-Z0-9-]+|BOUND-[A-Z0-9][A-Z0-9-]+)$" }
                  }
                }
              },
              "rationale": { "type": "string", "minLength": 1 }
            }
          }
        },
        "dimensions": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_determinismReview_properties_dimensions" }
      }
    },
    "boundaryRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject", "representationKind", "lowerBound", "upperBound", "underflowBehavior", "overflowBehavior", "decisionId", "requirementIds", "acceptanceCaseIds", "sourceFragmentIds", "basis"],
        "properties": {
          "id": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_boundaryRules_items_properties_id" },
          "subject": { "type": "string", "minLength": 1 },
          "representationKind": { "enum": ["REPRESENTATION_WIDTH", "ENCODED_VALUE"] },
          "lowerBound": { "type": "string", "minLength": 1 },
          "upperBound": { "type": "string", "minLength": 1 },
          "underflowBehavior": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_rangeBehavior" },
          "overflowBehavior": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_rangeBehavior" },
          "decisionId": { "type": ["string", "null"], "pattern": "^(?:Q-[A-Z0-9][A-Z0-9-]+|decision/[a-z0-9-]+/[a-z0-9-]+)$" },
          "requirementIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "acceptanceCaseIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "sourceFragmentIds": { "$ref": "#/$defs/sourceFragmentIds" },
          "basis": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_basis" }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "material", "decisionId", "sourceFragmentIds", "basis"],
        "properties": {
          "id": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_unknowns_items_properties_id" },
          "statement": { "type": "string", "minLength": 1 },
          "material": { "type": "boolean" },
          "decisionId": { "type": ["string", "null"] },
          "sourceFragmentIds": { "$ref": "#/$defs/sourceFragmentIds" },
          "basis": { "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_basis" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "aegis.semantic_draft_decision.v1" }
    },
    "stateModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entities",
        "operations",
        "observables"
      ],
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "fields"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "isCollection": {
                "type": "boolean"
              },
              "admissionPolicy": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "capacityPolicy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "maxEntries",
                  "overflowPolicy"
                ],
                "properties": {
                  "maxEntries": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "overflowPolicy": {
                    "enum": [
                      "REJECT_NEW",
                      "LRU_EVICTION",
                      "FIFO_EVICTION",
                      "FAIL_OPERATION",
                      "STATIC_SINGLETON",
                      "NO_CONTRACT_LIMIT"
                    ]
                  },
                  "provenance": {
                    "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_basis"
                  },
                  "unboundedRationale": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "overflowPolicy": {
                          "const": "NO_CONTRACT_LIMIT"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "unboundedRationale"
                      ],
                      "properties": {
                        "unboundedRationale": {
                          "type": "string",
                          "minLength": 1
                        },
                        "maxEntries": {
                          "const": null
                        }
                      }
                    }
                  }
                ]
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "type",
                    "initialization",
                    "mutations",
                    "reset",
                    "preservation",
                    "readBy"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "enum": [
                        "INTEGER",
                        "BOOLEAN",
                        "TIMESTAMP",
                        "STRING",
                        "MAP",
                        "SET",
                        "COLLECTION"
                      ]
                    },
                    "isCounter": {
                      "type": "boolean"
                    },
                    "bounds": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "lowerBound",
                        "upperBound",
                        "boundaryBehavior"
                      ],
                      "properties": {
                        "lowerBound": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "upperBound": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "boundaryBehavior": {
                          "enum": [
                            "SATURATE",
                            "REJECT",
                            "ROLLOVER_MODULO",
                            "PRESERVE",
                            "UNBOUNDED_ERROR"
                          ]
                        },
                        "provenance": {
                          "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_basis"
                        }
                      }
                    },
                    "initialization": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "value",
                        "rationale"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "EXPLICIT_VALUE",
                            "CONFIGURED",
                            "DERIVED",
                            "UNRESOLVED"
                          ]
                        },
                        "value": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "rationale": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "mutations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "operation",
                          "condition",
                          "effect",
                          "targetValue"
                        ],
                        "properties": {
                          "operation": {
                            "type": "string",
                            "minLength": 1
                          },
                          "condition": {
                            "type": "string",
                            "minLength": 1
                          },
                          "effect": {
                            "enum": [
                              "INCREMENT",
                              "DECREMENT",
                              "SET_VALUE",
                              "MUTATE_COLLECTION",
                              "CUSTOM"
                            ]
                          },
                          "targetValue": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    },
                    "reset": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "allowed",
                        "trigger",
                        "resetValue"
                      ],
                      "properties": {
                        "allowed": {
                          "type": "boolean"
                        },
                        "trigger": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "resetValue": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "preservation": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "readBy": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "derivation": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "formula",
                        "inputs",
                        "total"
                      ],
                      "properties": {
                        "formula": {
                          "type": "string",
                          "minLength": 1
                        },
                        "inputs": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "total": {
                          "type": "boolean"
                        },
                        "rationale": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "operations": {
          "$ref": "aegis.contract_components.v1#/$defs/state_operations"
        },
        "observables": {
          "$ref": "aegis.contract_components.v1#/$defs/state_observables"
        },
        "canonicalSerializations": {
          "$ref": "aegis.contract_components.v1#/$defs/state_canonicalSerializations"
        },
        "aggregations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sourceCollection",
              "aggregationKind",
              "filterPredicate"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "sourceCollection": {
                "type": "string",
                "minLength": 1
              },
              "aggregationKind": {
                "enum": [
                  "COUNT_DISTINCT",
                  "COUNT",
                  "SUM",
                  "TRAILING_STREAK",
                  "MAX_STREAK",
                  "EXISTS"
                ]
              },
              "filterPredicate": {
                "type": "string",
                "minLength": 1
              },
              "saturationLimit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provenance": {
                "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_basis"
              }
            }
          }
        },
        "producerConsumerBoundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "signalName",
              "producer",
              "consumer",
              "ownership"
            ],
            "properties": {
              "signalName": {
                "type": "string",
                "minLength": 1
              },
              "producer": {
                "type": "string",
                "minLength": 1
              },
              "consumer": {
                "type": "string",
                "minLength": 1
              },
              "ownership": {
                "enum": [
                  "SYSTEM_CONFIGURATION",
                  "REQUEST_INGRESS",
                  "ENTITY_LOCAL",
                  "COMPILATION_OUTPUT"
                ]
              },
              "recomputableByConsumer": {
                "type": "boolean"
              },
              "provenance": {
                "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_basis"
              }
            }
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "members"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "members": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "provenance": {
                "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_basis"
              }
            }
          }
        },
        "computabilityGraph": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "category", "dependencies"],
            "properties": {
              "symbol": { "type": "string", "minLength": 1 },
              "nodeId": { "type": "string", "minLength": 1 },
              "category": {
                "enum": [
                  "EXTERNAL_INPUT",
                  "STATE_FIELD",
                  "COMPUTED_VARIABLE",
                  "DERIVED_VALUE",
                  "MATHEMATICAL_RULE",
                  "SYSTEM_CONFIGURATION",
                  "HUMAN_DECISION"
                ]
              },
              "semanticType": {
                "enum": [
                  "VALUE",
                  "ENTITY",
                  "IDENTITY",
                  "COLLECTION",
                  "AGGREGATE",
                  "RELATION",
                  "STATE",
                  "EVENT",
                  "TRANSACTION",
                  "EXTERNAL_EFFECT"
                ]
              },
              "unit": {
                "type": "object",
                "additionalProperties": false,
                "required": ["family", "label"],
                "properties": {
                  "family": {
                    "enum": [
                      "DISCRETE_COUNT",
                      "PHYSICAL_VOLUME",
                      "PHYSICAL_MASS",
                      "PHYSICAL_WEIGHT",
                      "CURRENCY",
                      "TIME",
                      "RATIO",
                      "RAW_IDENTIFIER"
                    ]
                  },
                  "label": { "type": "string", "minLength": 1 },
                  "conversion": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["fromUnit", "toUnit"],
                    "properties": {
                      "fromUnit": { "type": "string", "minLength": 1 },
                      "toUnit": { "type": "string", "minLength": 1 },
                      "factor": {
                        "anyOf": [
                          { "type": "string", "minLength": 1 },
                          { "type": "number" }
                        ]
                      }
                    }
                  }
                }
              },
              "cardinality": {
                "enum": [
                  "SCALAR",
                  "AGGREGATE",
                  "COLLECTION"
                ]
              },
              "identityScope": {
                "type": "object",
                "additionalProperties": false,
                "required": ["entity"],
                "properties": {
                  "entity": { "type": "string", "minLength": 1 },
                  "identifierField": { "type": "string", "minLength": 1 },
                  "isPreservedSet": { "type": "boolean" }
                }
              },
              "transaction": {
                "type": "object",
                "additionalProperties": false,
                "required": ["scope", "candidateFields", "commitGuard"],
                "properties": {
                  "scope": { "type": "string", "minLength": 1 },
                  "candidateFields": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "commitGuard": { "type": "string", "minLength": 1 },
                  "onCommit": { "type": "string", "minLength": 1 },
                  "onRollback": { "type": "string", "minLength": 1 }
                }
              },
              "dependencies": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "derivationRule": { "type": "string" },
              "formula": { "type": "string" },
              "groundedIn": { "type": "string" },
              "target": { "type": "string" },
              "status": { "type": "string" },
              "edgeCaseRules": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tieBreaking": { "type": "string", "minLength": 1 },
                  "zeroDivisor": { "type": "string", "minLength": 1 },
                  "unfilledBuffer": { "type": "string", "minLength": 1 }
                }
              },
              "feedbackConfirmation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["executionMode"],
                "properties": {
                  "signal": { "type": "string", "minLength": 1 },
                  "confirmedBy": { "type": "string", "minLength": 1 },
                  "executionMode": {
                    "enum": [
                      "LOCAL_SYNCHRONOUS_FILL",
                      "EXTERNAL_ASYNCHRONOUS_REPORT",
                      "NO_FEEDBACK_REQUIRED"
                    ]
                  },
                  "onRejection": { "type": "string", "minLength": 1 }
                }
              },
              "computabilityStatus": {
                "enum": [
                  "COMPUTABLE",
                  "NOT_COMPUTABLE",
                  "OPEN_DEPENDENCY"
                ]
              },
              "provenance": {
                "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_basis"
              }
            }
          }
        }
      }
    },
    "closureCertificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unresolvedInventorySlots",
        "unresolvedStateFields",
        "unresolvedObservables",
        "unresolvedTransitions",
        "unresolvedAuthorities",
        "unresolvedDeterminismDimensions",
        "contradictoryRules",
        "orphanHumanDecisions",
        "unresolvedDependencies",
        "status",
        "gapLedger"
      ],
      "properties": {
        "unresolvedInventorySlots": { "type": "integer", "minimum": 0 },
        "unresolvedStateFields": { "type": "integer", "minimum": 0 },
        "unresolvedObservables": { "type": "integer", "minimum": 0 },
        "unresolvedTransitions": { "type": "integer", "minimum": 0 },
        "unresolvedAuthorities": { "type": "integer", "minimum": 0 },
        "unresolvedDeterminismDimensions": { "type": "integer", "minimum": 0 },
        "contradictoryRules": { "type": "integer", "minimum": 0 },
        "orphanHumanDecisions": { "type": "integer", "minimum": 0 },
        "unresolvedDependencies": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["CERTIFIED_CLOSED", "BLOCKED_BY_UNRESOLVED_SLOTS"] },
        "gapLedger": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gapId", "layer", "witness", "requiredAuthority"],
            "properties": {
              "gapId": { "type": "string", "pattern": "^GAP-[0-9]{4}$" },
              "layer": {
                "enum": [
                  "COMPUTABILITY_DEPENDENCY_CLOSURE",
                  "TRANSITION_CONSISTENCY",
                  "OBSERVABLE_DEPENDENCY_CLOSURE",
                  "AUTHORITY_PROVENANCE",
                  "COVERAGE_ACCOUNTING"
                ]
              },
              "witness": { "type": "string", "minLength": 1 },
              "requiredAuthority": {
                "enum": ["USER_INTENT", "ARCHITECTURE_POLICY", "USER_DECISION"]
              },
              "slotId": { "type": "string" },
              "details": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sourceFragmentIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^FRAG-[0-9]{4}$" },
      "uniqueItems": true
    }
  }
}
