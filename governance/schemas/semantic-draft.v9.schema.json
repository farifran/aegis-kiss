{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.semantic_draft.v9",
  "title": "Aegis Compiled Semantic Draft v9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceContextDigest",
    "sourceEvidenceDigest",
    "title",
    "interpretation",
    "changeKind",
    "scope",
    "fragmentDispositions",
    "intentClaims",
    "nonNormativeItems",
    "pathReferences",
    "architectureContexts",
    "policyAssessments",
    "complexityReview",
    "requirements",
    "invariants",
    "riskReview",
    "risks",
    "adversarialReview",
    "determinismReview",
    "boundaryRules",
    "unknowns",
    "decisions"
  ],
  "properties": {
    "schema": {
      "const": "aegis.semantic_draft.v9"
    },
    "sourceContextDigest": {
      "$ref": "aegis.contract_components.v1#/$defs/sha256_digest"
    },
    "sourceEvidenceDigest": {
      "$ref": "aegis.contract_components.v1#/$defs/sha256_digest"
    },
    "title": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_title"
    },
    "interpretation": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_interpretation"
    },
    "changeKind": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_changeKind"
    },
    "scope": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_scope"
    },
    "fragmentDispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fragmentId",
          "status",
          "claimIds",
          "rationale"
        ],
        "properties": {
          "fragmentId": {
            "type": "string",
            "pattern": "^FRAG-[0-9]{4}$"
          },
          "status": {
            "enum": [
              "CLAIMS_EXTRACTED",
              "CONTEXT_ONLY",
              "UNCLEAR"
            ]
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CLAIM-[A-Z0-9][A-Z0-9-]+$"
            },
            "uniqueItems": true
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "intentClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "quote",
          "sourceFragmentIds",
          "kind",
          "disposition",
          "contractEffect",
          "targetIds",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CLAIM-[A-Z0-9][A-Z0-9-]+$"
          },
          "quote": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_05"
          },
          "sourceFragmentIds": {
            "$ref": "#/$defs/sourceFragmentIds"
          },
          "kind": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_29"
          },
          "disposition": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_39"
          },
          "contractEffect": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_02"
          },
          "targetIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(?:(REQ|Q|NOTE|PATH|ARCH|BOUND)-[A-Z0-9][A-Z0-9-]+|decision/[a-z0-9-]+/[a-z0-9-]+)$"
            },
            "uniqueItems": true
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nonNormativeItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "statement",
          "status",
          "sourceFragmentIds",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^NOTE-[A-Z0-9][A-Z0-9-]+$"
          },
          "kind": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_48"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "NON_NORMATIVE"
          },
          "sourceFragmentIds": {
            "$ref": "#/$defs/sourceFragmentIds"
          },
          "basis": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_basis"
          }
        }
      }
    },
    "pathReferences": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_pathReferences"
    },
    "architectureContexts": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_architectureContexts"
    },
    "policyAssessments": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_policyAssessments"
    },
    "complexityReview": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_complexityReview"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "statement",
          "basis",
          "sourceFragmentIds",
          "measurement",
          "acceptanceCases"
        ],
        "properties": {
          "id": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_requirements_items_properties_id"
          },
          "kind": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_requirements_items_properties_kind"
          },
          "statement": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_requirements_items_properties_statement"
          },
          "basis": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_basis"
          },
          "sourceFragmentIds": {
            "$ref": "#/$defs/sourceFragmentIds"
          },
          "measurement": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_requirements_items_properties_measurement"
          },
          "acceptanceCases": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_requirements_items_properties_acceptanceCases"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "QUALITY"
                }
              }
            },
            "then": {
              "properties": {
                "measurement": {
                  "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_measurement"
                }
              }
            },
            "else": {
              "properties": {
                "measurement": {
                  "const": null
                }
              }
            }
          }
        ]
      }
    },
    "invariants": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_invariants"
    },
    "riskReview": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_riskReview"
    },
    "risks": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_risks"
    },
    "adversarialReview": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_adversarialReview"
    },
    "determinismReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale",
        "sourceFragmentIds",
        "coverage",
        "dimensions"
      ],
      "properties": {
        "status": {
          "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_determinismReview_properties_status"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "sourceFragmentIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^FRAG-[0-9]{4}$"
          },
          "uniqueItems": true
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claimId",
              "disposition",
              "dimensions",
              "rationale"
            ],
            "properties": {
              "claimId": {
                "type": "string",
                "pattern": "^CLAIM-[A-Z0-9][A-Z0-9-]+$"
              },
              "disposition": {
                "enum": [
                  "DIMENSIONS_DECLARED",
                  "NO_DIMENSION_APPLICABLE"
                ]
              },
              "dimensions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "subjectId"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_]{1,79}$"
                    },
                    "subjectId": {
                      "type": "string",
                      "pattern": "^(PUBLIC_CONTRACT|REQ-[A-Z0-9][A-Z0-9-]+|BOUND-[A-Z0-9][A-Z0-9-]+)$"
                    }
                  }
                }
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "dimensions": {
          "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_determinismReview_properties_dimensions"
        },
        "arithmetic": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "aegis.contract_components.v1#/$defs/arithmetic_policy_draft"
            }
          ]
        }
      }
    },
    "boundaryRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subject",
          "representationKind",
          "lowerBound",
          "upperBound",
          "underflowBehavior",
          "overflowBehavior",
          "decisionId",
          "requirementIds",
          "acceptanceCaseIds",
          "sourceFragmentIds",
          "basis"
        ],
        "properties": {
          "id": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_boundaryRules_items_properties_id"
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "representationKind": {
            "enum": [
              "REPRESENTATION_WIDTH",
              "ENCODED_VALUE"
            ]
          },
          "lowerBound": {
            "type": "string",
            "minLength": 1
          },
          "upperBound": {
            "type": "string",
            "minLength": 1
          },
          "underflowBehavior": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_rangeBehavior"
          },
          "overflowBehavior": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_rangeBehavior"
          },
          "decisionId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?:Q-[A-Z0-9][A-Z0-9-]+|decision/[a-z0-9-]+/[a-z0-9-]+)$"
          },
          "requirementIds": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_08"
          },
          "acceptanceCaseIds": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_08"
          },
          "sourceFragmentIds": {
            "$ref": "#/$defs/sourceFragmentIds"
          },
          "basis": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_basis"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "material",
          "decisionId",
          "sourceFragmentIds",
          "basis"
        ],
        "properties": {
          "id": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_unknowns_items_properties_id"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "material": {
            "type": "boolean"
          },
          "decisionId": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_01"
          },
          "sourceFragmentIds": {
            "$ref": "#/$defs/sourceFragmentIds"
          },
          "basis": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_basis"
          },
          "materialEffect": {
            "type": "string",
            "minLength": 1,
            "description": "Para unknown material, descreva qual resultado público do contrato pode mudar conforme a resposta. Use uma diferença concreta e fundamentada; não invente cenário nem requisito."
          }
        },
        "if": {
          "properties": {
            "material": {
              "const": true
            }
          },
          "required": [
            "material"
          ]
        },
        "then": {
          "properties": {
            "materialEffect": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "materialEffect"
          ]
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_decision"
      }
    },
    "stateModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entities",
        "operations",
        "observables"
      ],
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "fields"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "isCollection": {
                "type": "boolean"
              },
              "admissionPolicy": {
                "$ref": "aegis.contract_components.v1#/$defs/shared_component_01"
              },
              "capacityPolicy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "maxEntries",
                  "overflowPolicy"
                ],
                "properties": {
                  "maxEntries": {
                    "$ref": "aegis.contract_components.v1#/$defs/shared_component_01"
                  },
                  "overflowPolicy": {
                    "$ref": "aegis.contract_components.v1#/$defs/shared_component_20"
                  },
                  "provenance": {
                    "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_basis"
                  },
                  "unboundedRationale": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "overflowPolicy": {
                          "const": "NO_CONTRACT_LIMIT"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "unboundedRationale"
                      ],
                      "properties": {
                        "unboundedRationale": {
                          "type": "string",
                          "minLength": 1
                        },
                        "maxEntries": {
                          "const": null
                        }
                      }
                    }
                  }
                ]
              },
              "containerPolicy": {
                "$ref": "aegis.contract_components.v1#/$defs/state_containerPolicy"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "type",
                    "initialization",
                    "mutations",
                    "reset",
                    "preservation",
                    "readBy"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "$ref": "aegis.contract_components.v1#/$defs/shared_component_25"
                    },
                    "temporalUnit": {
                      "$ref": "aegis.contract_components.v1#/$defs/state_field_temporalUnit"
                    },
                    "temporalRole": {
                      "$ref": "aegis.contract_components.v1#/$defs/state_field_temporalRole"
                    },
                    "usedInLookup": {
                      "$ref": "aegis.contract_components.v1#/$defs/shared_component_03"
                    },
                    "usedInDeduplication": {
                      "$ref": "aegis.contract_components.v1#/$defs/shared_component_03"
                    },
                    "usedInPartition": {
                      "$ref": "aegis.contract_components.v1#/$defs/shared_component_03"
                    },
                    "allowedValues": {
                      "$ref": "aegis.contract_components.v1#/$defs/shared_component_11"
                    },
                    "isCounter": {
                      "type": "boolean"
                    },
                    "bounds": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "lowerBound",
                        "upperBound",
                        "boundaryBehavior"
                      ],
                      "properties": {
                        "lowerBound": {
                          "$ref": "aegis.contract_components.v1#/$defs/shared_component_01"
                        },
                        "upperBound": {
                          "$ref": "aegis.contract_components.v1#/$defs/shared_component_01"
                        },
                        "boundaryBehavior": {
                          "$ref": "aegis.contract_components.v1#/$defs/shared_component_32"
                        },
                        "provenance": {
                          "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_basis"
                        }
                      }
                    },
                    "initialization": {
                      "$ref": "aegis.contract_components.v1#/$defs/state_field_initialization"
                    },
                    "mutations": {
                      "$ref": "aegis.contract_components.v1#/$defs/state_field_mutations"
                    },
                    "reset": {
                      "$ref": "aegis.contract_components.v1#/$defs/state_field_reset"
                    },
                    "preservation": {
                      "$ref": "aegis.contract_components.v1#/$defs/shared_component_06"
                    },
                    "readBy": {
                      "$ref": "aegis.contract_components.v1#/$defs/shared_component_06"
                    }
                  }
                }
              }
            }
          }
        },
        "operations": {
          "$ref": "aegis.contract_components.v1#/$defs/state_operations"
        },
        "observables": {
          "$ref": "aegis.contract_components.v1#/$defs/state_observables"
        },
        "canonicalSerializations": {
          "$ref": "aegis.contract_components.v1#/$defs/state_canonicalSerializations"
        }
      }
    },
    "closureCertificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unresolvedInventorySlots",
        "unresolvedStateFields",
        "unresolvedObservables",
        "unresolvedTransitions",
        "unresolvedAuthorities",
        "unresolvedDeterminismDimensions",
        "contradictoryRules",
        "orphanHumanDecisions",
        "unresolvedDependencies",
        "status",
        "gapLedger"
      ],
      "properties": {
        "unresolvedInventorySlots": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedStateFields": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedObservables": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedTransitions": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedAuthorities": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedDeterminismDimensions": {
          "type": "integer",
          "minimum": 0
        },
        "contradictoryRules": {
          "type": "integer",
          "minimum": 0
        },
        "orphanHumanDecisions": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedDependencies": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "CERTIFIED_CLOSED",
            "CLOSED_WITH_ACKNOWLEDGED_SEMANTIC_REVIEW",
            "BLOCKED_BY_UNRESOLVED_SLOTS"
          ]
        },
        "gapLedger": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gapId",
              "layer",
              "witness",
              "requiredAuthority"
            ],
            "properties": {
              "gapId": {
                "type": "string",
                "pattern": "^GAP-[0-9]{4}$"
              },
              "layer": {
                "enum": [
                  "COMPUTABILITY_DEPENDENCY_CLOSURE",
                  "TRANSITION_CONSISTENCY",
                  "OBSERVABLE_DEPENDENCY_CLOSURE",
                  "AUTHORITY_PROVENANCE",
                  "COVERAGE_ACCOUNTING"
                ]
              },
              "witness": {
                "type": "string",
                "minLength": 1
              },
              "requiredAuthority": {
                "enum": [
                  "USER_INTENT",
                  "ARCHITECTURE_POLICY",
                  "USER_DECISION"
                ]
              },
              "slotId": {
                "type": "string"
              },
              "details": {
                "type": "string"
              }
            }
          }
        },
        "closureAudit": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "counts",
                "items"
              ],
              "properties": {
                "counts": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "MECHANICALLY_VERIFIED",
                    "AWAITING_HUMAN_DECISION",
                    "SEMANTIC_REVIEW_REQUIRED"
                  ],
                  "properties": {
                    "MECHANICALLY_VERIFIED": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "AWAITING_HUMAN_DECISION": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "SEMANTIC_REVIEW_REQUIRED": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "itemId",
                      "classification",
                      "category",
                      "summary"
                    ],
                    "properties": {
                      "itemId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "classification": {
                        "enum": [
                          "MECHANICALLY_VERIFIED",
                          "AWAITING_HUMAN_DECISION",
                          "SEMANTIC_REVIEW_REQUIRED"
                        ]
                      },
                      "category": {
                        "type": "string",
                        "minLength": 1
                      },
                      "summary": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "sourceFragmentIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^FRAG-[0-9]{4}$"
      },
      "uniqueItems": true
    }
  }
}
