{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.semantic_draft.v9",
  "title": "Aegis Compiled Semantic Draft v9",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "sourceContextDigest", "sourceEvidenceDigest", "title", "interpretation", "changeKind", "scope",
    "fragmentDispositions", "intentClaims", "nonNormativeItems", "pathReferences", "architectureContexts",
    "policyAssessments", "complexityReview", "requirements", "invariants", "riskReview", "risks",
    "adversarialReview", "determinismReview", "boundaryRules", "unknowns", "decisions"
  ],
  "properties": {
    "schema": { "const": "aegis.semantic_draft.v9" },
    "sourceContextDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceEvidenceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "title": { "$ref": "aegis.semantic_draft.v8#/properties/title" },
    "interpretation": { "$ref": "aegis.semantic_draft.v8#/properties/interpretation" },
    "changeKind": { "$ref": "aegis.semantic_draft.v8#/properties/changeKind" },
    "scope": { "$ref": "aegis.semantic_draft.v8#/properties/scope" },
    "fragmentDispositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fragmentId", "status", "claimIds", "rationale"],
        "properties": {
          "fragmentId": { "type": "string", "pattern": "^FRAG-[0-9]{4}$" },
          "status": { "enum": ["CLAIMS_EXTRACTED", "CONTEXT_ONLY", "UNCLEAR"] },
          "claimIds": { "type": "array", "items": { "type": "string", "pattern": "^CLAIM-[A-Z0-9][A-Z0-9-]+$" }, "uniqueItems": true },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "intentClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "quote", "sourceFragmentIds", "kind", "disposition", "contractEffect", "targetIds", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^CLAIM-[A-Z0-9][A-Z0-9-]+$" },
          "quote": { "type": "string", "minLength": 1, "maxLength": 240 },
          "sourceFragmentIds": { "$ref": "#/$defs/sourceFragmentIds" },
          "kind": { "enum": ["OBLIGATION", "PROHIBITION", "GOAL", "OPTION", "EXAMPLE", "AMBIGUITY"] },
          "disposition": { "enum": ["NORMATIVE", "DECISION", "POLICY_CORRECTION", "NON_NORMATIVE"] },
          "contractEffect": { "type": ["string", "null"], "minLength": 1 },
          "targetIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(?:(REQ|Q|NOTE|PATH|ARCH|BOUND)-[A-Z0-9][A-Z0-9-]+|decision/[a-z0-9-]+/[a-z0-9-]+)$" }, "uniqueItems": true },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nonNormativeItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "statement", "status", "sourceFragmentIds", "basis"],
        "properties": {
          "id": { "type": "string", "pattern": "^NOTE-[A-Z0-9][A-Z0-9-]+$" },
          "kind": { "enum": ["GOAL", "OPTION", "EXAMPLE"] },
          "statement": { "type": "string", "minLength": 1 },
          "status": { "const": "NON_NORMATIVE" },
          "sourceFragmentIds": { "$ref": "#/$defs/sourceFragmentIds" },
          "basis": { "$ref": "aegis.semantic_draft.v8#/$defs/basis" }
        }
      }
    },
    "pathReferences": { "$ref": "aegis.semantic_draft.v8#/properties/pathReferences" },
    "architectureContexts": { "$ref": "aegis.semantic_draft.v8#/properties/architectureContexts" },
    "policyAssessments": { "$ref": "aegis.semantic_draft.v8#/properties/policyAssessments" },
    "complexityReview": { "$ref": "aegis.semantic_draft.v8#/properties/complexityReview" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "statement", "basis", "sourceFragmentIds", "measurement", "acceptanceCases"],
        "properties": {
          "id": { "$ref": "aegis.semantic_draft.v8#/properties/requirements/items/properties/id" },
          "kind": { "$ref": "aegis.semantic_draft.v8#/properties/requirements/items/properties/kind" },
          "statement": { "$ref": "aegis.semantic_draft.v8#/properties/requirements/items/properties/statement" },
          "basis": { "$ref": "aegis.semantic_draft.v8#/$defs/basis" },
          "sourceFragmentIds": { "$ref": "#/$defs/sourceFragmentIds" },
          "measurement": { "$ref": "aegis.semantic_draft.v8#/properties/requirements/items/properties/measurement" },
          "acceptanceCases": { "$ref": "aegis.semantic_draft.v8#/properties/requirements/items/properties/acceptanceCases" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "QUALITY" } } },
            "then": { "properties": { "measurement": { "$ref": "aegis.semantic_draft.v8#/$defs/measurement" } } },
            "else": { "properties": { "measurement": { "const": null } } }
          }
        ]
      }
    },
    "invariants": { "$ref": "aegis.semantic_draft.v8#/properties/invariants" },
    "riskReview": { "$ref": "aegis.semantic_draft.v8#/properties/riskReview" },
    "risks": { "$ref": "aegis.semantic_draft.v8#/properties/risks" },
    "adversarialReview": { "$ref": "aegis.semantic_draft.v8#/properties/adversarialReview" },
    "determinismReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "sourceFragmentIds", "coverage", "dimensions"],
      "properties": {
        "status": { "$ref": "aegis.semantic_draft.v8#/properties/determinismReview/properties/status" },
        "rationale": { "type": "string", "minLength": 1 },
        "sourceFragmentIds": { "type": "array", "items": { "type": "string", "pattern": "^FRAG-[0-9]{4}$" }, "uniqueItems": true },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claimId", "disposition", "dimensions", "rationale"],
            "properties": {
              "claimId": { "type": "string", "pattern": "^CLAIM-[A-Z0-9][A-Z0-9-]+$" },
              "disposition": { "enum": ["DIMENSIONS_DECLARED", "NO_DIMENSION_APPLICABLE"] },
              "dimensions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "subjectId"],
                  "properties": {
                    "kind": { "enum": ["ORDERING", "CANONICALIZATION", "DUPLICATES", "EMPTY_INPUT", "ODD_CARDINALITY", "ROUNDING", "REMAINDER_DISTRIBUTION", "ZERO_DIVISOR", "TIE_BREAKING", "COUNTING_IDENTITY", "BOUNDED_ARITHMETIC"] },
                    "subjectId": { "type": "string", "pattern": "^(PUBLIC_CONTRACT|REQ-[A-Z0-9][A-Z0-9-]+|BOUND-[A-Z0-9][A-Z0-9-]+)$" }
                  }
                }
              },
              "rationale": { "type": "string", "minLength": 1 }
            }
          }
        },
        "dimensions": { "$ref": "aegis.semantic_draft.v8#/properties/determinismReview/properties/dimensions" }
      }
    },
    "boundaryRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject", "representationKind", "lowerBound", "upperBound", "underflowBehavior", "overflowBehavior", "decisionId", "requirementIds", "acceptanceCaseIds", "sourceFragmentIds", "basis"],
        "properties": {
          "id": { "$ref": "aegis.semantic_draft.v8#/properties/boundaryRules/items/properties/id" },
          "subject": { "type": "string", "minLength": 1 },
          "representationKind": { "enum": ["REPRESENTATION_WIDTH", "ENCODED_VALUE"] },
          "lowerBound": { "type": "string", "minLength": 1 },
          "upperBound": { "type": "string", "minLength": 1 },
          "underflowBehavior": { "$ref": "aegis.semantic_draft.v8#/$defs/rangeBehavior" },
          "overflowBehavior": { "$ref": "aegis.semantic_draft.v8#/$defs/rangeBehavior" },
          "decisionId": { "type": ["string", "null"], "pattern": "^(?:Q-[A-Z0-9][A-Z0-9-]+|decision/[a-z0-9-]+/[a-z0-9-]+)$" },
          "requirementIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "acceptanceCaseIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "sourceFragmentIds": { "$ref": "#/$defs/sourceFragmentIds" },
          "basis": { "$ref": "aegis.semantic_draft.v8#/$defs/basis" }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "material", "decisionId", "sourceFragmentIds", "basis"],
        "properties": {
          "id": { "$ref": "aegis.semantic_draft.v8#/properties/unknowns/items/properties/id" },
          "statement": { "type": "string", "minLength": 1 },
          "material": { "type": "boolean" },
          "decisionId": { "type": ["string", "null"] },
          "sourceFragmentIds": { "$ref": "#/$defs/sourceFragmentIds" },
          "basis": { "$ref": "aegis.semantic_draft.v8#/$defs/basis" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "aegis.semantic_draft_decision.v1" }
    },
    "stateModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities", "operations", "observables"],
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "fields"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "isCollection": { "type": "boolean" },
              "admissionPolicy": { "type": ["string", "null"] },
              "capacityPolicy": {
                "type": "object",
                "additionalProperties": false,
                "required": ["maxEntries", "overflowPolicy"],
                "properties": {
                  "maxEntries": { "type": ["string", "null"] },
                  "overflowPolicy": { "enum": ["REJECT_NEW", "LRU_EVICTION", "FIFO_EVICTION", "FAIL_OPERATION", "STATIC_SINGLETON"] },
                  "provenance": { "$ref": "aegis.semantic_draft.v8#/$defs/basis" }
                }
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "type", "initialization", "mutations", "reset", "preservation", "readBy"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "type": { "enum": ["INTEGER", "BOOLEAN", "TIMESTAMP", "STRING", "MAP", "SET", "COLLECTION"] },
                    "isCounter": { "type": "boolean" },
                    "bounds": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["lowerBound", "upperBound", "boundaryBehavior"],
                      "properties": {
                        "lowerBound": { "type": ["string", "null"] },
                        "upperBound": { "type": ["string", "null"] },
                        "boundaryBehavior": { "enum": ["SATURATE", "REJECT", "ROLLOVER_MODULO", "PRESERVE", "UNBOUNDED_ERROR"] },
                        "provenance": { "$ref": "aegis.semantic_draft.v8#/$defs/basis" }
                      }
                    },
                    "initialization": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "value", "rationale"],
                      "properties": {
                        "kind": { "enum": ["EXPLICIT_VALUE", "CONFIGURED", "DERIVED", "UNRESOLVED"] },
                        "value": { "type": ["string", "null"] },
                        "rationale": { "type": "string", "minLength": 1 }
                      }
                    },
                    "mutations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["operation", "condition", "effect", "targetValue"],
                        "properties": {
                          "operation": { "type": "string", "minLength": 1 },
                          "condition": { "type": "string", "minLength": 1 },
                          "effect": { "enum": ["INCREMENT", "DECREMENT", "SET_VALUE", "MUTATE_COLLECTION", "CUSTOM"] },
                          "targetValue": { "type": ["string", "null"] }
                        }
                      }
                    },
                    "reset": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["allowed", "trigger", "resetValue"],
                      "properties": {
                        "allowed": { "type": "boolean" },
                        "trigger": { "type": ["string", "null"] },
                        "resetValue": { "type": ["string", "null"] }
                      }
                    },
                    "preservation": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "readBy": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "guardPrecedence"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "guardPrecedence": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "branches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["branchId", "outcomeKind"],
                  "properties": {
                    "branchId": { "type": "string", "minLength": 1 },
                    "condition": { "type": "string" },
                    "outcomeKind": { "enum": ["RETURN_VALUE", "REJECTION", "NO_OP", "STATE_CHANGE", "OBSERVABLE_EFFECT"] },
                    "statusOrError": { "type": "string" },
                    "defaultPreservation": { "type": "boolean" },
                    "stateEffects": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["field", "effect"],
                        "properties": {
                          "field": { "type": "string", "minLength": 1 },
                          "effect": { "enum": ["SET", "INCREMENT", "DECREMENT", "PRESERVE", "MUTATE_COLLECTION", "CUSTOM"] },
                          "value": { "type": ["string", "null"] }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "observables": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "derivedFrom"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "derivedFrom": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "representation": { "enum": ["UINT32_BITMASK", "ENUM", "SCALAR", "RECORD", "BOOLEAN"] },
              "bitAllocation": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["slice", "field", "bitWidth"],
                  "properties": {
                    "slice": { "type": "string", "minLength": 1 },
                    "field": { "type": "string", "minLength": 1 },
                    "bitWidth": { "type": "integer", "minimum": 1 },
                    "mapping": { "type": ["string", "null"] }
                  }
                }
              },
              "emptyBehavior": { "type": ["string", "null"] }
            }
          }
        },
        "canonicalSerializations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "includedFields", "fieldEncodings", "recordOrderingKey", "emptyStateDigest"],
            "properties": {
              "target": { "type": "string", "minLength": 1 },
              "includedFields": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "fieldEncodings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["field", "encoding"],
                  "properties": {
                    "field": { "type": "string", "minLength": 1 },
                    "encoding": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "recordOrderingKey": { "type": "string", "minLength": 1 },
              "emptyStateDigest": { "type": "string", "minLength": 1 }
            }
          }
        },
        "aggregations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sourceCollection", "aggregationKind", "filterPredicate"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "sourceCollection": { "type": "string", "minLength": 1 },
              "aggregationKind": { "enum": ["COUNT_DISTINCT", "COUNT", "SUM", "TRAILING_STREAK", "MAX_STREAK", "EXISTS"] },
              "filterPredicate": { "type": "string", "minLength": 1 },
              "saturationLimit": { "type": ["string", "null"] },
              "provenance": { "$ref": "aegis.semantic_draft.v8#/$defs/basis" }
            }
          }
        },
        "producerConsumerBoundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signalName", "producer", "consumer", "ownership"],
            "properties": {
              "signalName": { "type": "string", "minLength": 1 },
              "producer": { "type": "string", "minLength": 1 },
              "consumer": { "type": "string", "minLength": 1 },
              "ownership": { "enum": ["SYSTEM_CONFIGURATION", "REQUEST_INGRESS", "ENTITY_LOCAL", "COMPILATION_OUTPUT"] },
              "recomputableByConsumer": { "type": "boolean" },
              "provenance": { "$ref": "aegis.semantic_draft.v8#/$defs/basis" }
            }
          }
        }
      }
    },
    "closureCertificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unresolvedInventorySlots",
        "unresolvedStateFields",
        "unresolvedObservables",
        "unresolvedTransitions",
        "unresolvedAuthorities",
        "unresolvedDeterminismDimensions",
        "contradictoryRules",
        "orphanHumanDecisions",
        "regressedSemanticDimensions",
        "status"
      ],
      "properties": {
        "unresolvedInventorySlots": { "type": "integer", "minimum": 0 },
        "unresolvedStateFields": { "type": "integer", "minimum": 0 },
        "unresolvedObservables": { "type": "integer", "minimum": 0 },
        "unresolvedTransitions": { "type": "integer", "minimum": 0 },
        "unresolvedAuthorities": { "type": "integer", "minimum": 0 },
        "unresolvedDeterminismDimensions": { "type": "integer", "minimum": 0 },
        "contradictoryRules": { "type": "integer", "minimum": 0 },
        "orphanHumanDecisions": { "type": "integer", "minimum": 0 },
        "regressedSemanticDimensions": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["CERTIFIED_CLOSED", "BLOCKED_BY_UNRESOLVED_SLOTS"] },
        "inventoryAudit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "normativeClaimsCount": { "type": "integer", "minimum": 0 },
            "expectedStateEntities": { "type": "integer", "minimum": 0 },
            "materializedStateEntities": { "type": "integer", "minimum": 0 },
            "expectedFields": { "type": "integer", "minimum": 0 },
            "materializedFields": { "type": "integer", "minimum": 0 },
            "closedFields": { "type": "integer", "minimum": 0 },
            "expectedOperations": { "type": "integer", "minimum": 0 },
            "materializedOperations": { "type": "integer", "minimum": 0 },
            "totalizedOperations": { "type": "integer", "minimum": 0 },
            "expectedObservables": { "type": "integer", "minimum": 0 },
            "materializedObservables": { "type": "integer", "minimum": 0 },
            "closedObservables": { "type": "integer", "minimum": 0 },
            "canonicalProfilesRequired": { "type": "integer", "minimum": 0 },
            "canonicalProfilesClosed": { "type": "integer", "minimum": 0 },
            "aggregationsClosed": { "type": "integer", "minimum": 0 },
            "boundariesClosed": { "type": "integer", "minimum": 0 },
            "divergenceWitnessesSurviving": { "type": "integer", "minimum": 0 }
          }
        },
        "gapLedger": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gapId", "layer", "witness", "requiredAuthority"],
            "properties": {
              "gapId": { "type": "string", "pattern": "^GAP-[0-9]{4}$" },
              "layer": {
                "enum": [
                  "TRANSITION_CONSISTENCY",
                  "OBSERVABLE_DEPENDENCY_CLOSURE",
                  "AUTHORITY_PROVENANCE",
                  "COVERAGE_ACCOUNTING"
                ]
              },
              "witness": { "type": "string", "minLength": 1 },
              "requiredAuthority": {
                "enum": ["USER_INTENT", "ARCHITECTURE_POLICY", "USER_DECISION"]
              },
              "slotId": { "type": "string" },
              "details": { "type": "string" }
            }
          }
        },
        "unresolvedSlots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slotId", "kind", "reason"],
            "properties": {
              "slotId": { "type": "string" },
              "kind": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sourceFragmentIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^FRAG-[0-9]{4}$" },
      "uniqueItems": true
    }
  }
}
