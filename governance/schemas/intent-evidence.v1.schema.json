{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.intent_evidence.v1",
  "title": "Aegis Neutral Intent Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidenceDigest", "method", "offsetUnit", "intentDigest", "fragments", "literalFacts", "bitLayouts"],
  "properties": {
    "schema": { "const": "aegis.intent_evidence.v1" },
    "evidenceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "method": { "const": "LOSSLESS_NEUTRAL_SENTENCES_V2" },
    "offsetUnit": { "const": "UTF16_CODE_UNIT" },
    "intentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 255,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "startOffset", "endOffset", "structuralKind", "anchor"],
        "properties": {
          "id": { "type": "string", "pattern": "^FRAG-[0-9]{4}$" },
          "startOffset": { "type": "integer", "minimum": 0 },
          "endOffset": { "type": "integer", "minimum": 1 },
          "structuralKind": { "enum": ["TEXT", "LIST_ITEM", "HEADING", "CODE_FENCE"] },
          "anchor": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "literalFacts": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "offset", "endOffset", "reference", "attributes", "fragmentIndex"],
        "properties": {
          "id": { "type": "string", "pattern": "^FACT-[0-9]{4}$" },
          "kind": { "enum": ["BIT_RANGE", "BIT_WIDTH", "CODE_SPAN", "REPOSITORY_PATH", "NUMBER_LITERAL", "EMPTY_PARENS"] },
          "offset": { "type": "integer", "minimum": 0 },
          "endOffset": { "type": "integer", "minimum": 1 },
          "reference": { "type": "string", "minLength": 1, "maxLength": 240 },
          "fragmentIndex": { "type": "integer", "minimum": 0 },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                { "type": "string" },
                { "type": "integer" },
                { "type": "boolean" }
              ]
            }
          }
        }
      }
    },
    "bitLayouts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "declarationFactId", "declaredWidth", "fieldFactIds", "coveredWidth", "status", "gaps", "overlaps", "outOfRange"],
        "properties": {
          "id": { "type": "string", "pattern": "^BIT-LAYOUT-[0-9]{4}$" },
          "declarationFactId": { "type": ["string", "null"], "pattern": "^FACT-[0-9]{4}$" },
          "declaredWidth": { "type": "integer", "minimum": 1 },
          "fieldFactIds": { "type": "array", "items": { "type": "string", "pattern": "^FACT-[0-9]{4}$" }, "uniqueItems": true },
          "coveredWidth": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["COMPLETE", "INCOMPLETE"] },
          "gaps": { "$ref": "#/$defs/ranges" },
          "overlaps": { "$ref": "#/$defs/ranges" },
          "outOfRange": { "$ref": "#/$defs/ranges" }
        }
      }
    }
  },
  "$defs": {
    "ranges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startBit", "endBit"],
        "properties": {
          "startBit": { "type": "integer" },
          "endBit": { "type": "integer" }
        }
      }
    }
  }
}
