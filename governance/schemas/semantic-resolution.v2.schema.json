{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.semantic_resolution.v2",
  "title": "Aegis Explicit Human Resolution v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "executionId",
    "contractDraftDigest",
    "method",
    "attestation",
    "answers"
  ],
  "properties": {
    "schema": {
      "const": "aegis.semantic_resolution.v2"
    },
    "executionId": {
      "type": "string",
      "pattern": "^draft-[a-f0-9]{16}$"
    },
    "contractDraftDigest": {
      "$ref": "aegis.contract_components.v1#/$defs/sha256_digest"
    },
    "method": {
      "$ref": "aegis.contract_components.v1#/$defs/shared_component_14"
    },
    "attestation": {
      "$ref": "aegis.contract_components.v1#/$defs/shared_component_22"
    },
    "answers": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "questionId",
              "answerId"
            ],
            "properties": {
              "questionId": {
                "type": "string",
                "minLength": 1
              },
              "answerId": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "questionId",
              "correction"
            ],
            "properties": {
              "questionId": {
                "type": "string",
                "minLength": 1
              },
              "correction": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  }
}
