{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.semantic_opinion_decision.v1",
  "title": "Aegis Semantic Opinion Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question",
    "presentation",
    "recommendedAnswerIndex",
    "requirementIndexes",
    "invariantIndexes",
    "riskIndexes",
    "answers",
    "distinguishingCase"
  ],
  "properties": {
    "question": { "type": "string", "minLength": 1 },
    "presentation": { "$ref": "aegis.decision_presentation.v1" },
    "answers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "rationale", "contractEffect"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "contractEffect": { "type": "string", "minLength": 1 }
        }
      }
    },
    "recommendedAnswerIndex": { "type": "integer", "minimum": 0 },
    "requirementIndexes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 },
      "uniqueItems": true
    },
    "invariantIndexes": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "uniqueItems": true
    },
    "riskIndexes": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "uniqueItems": true
    },
    "distinguishingCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["given", "when", "outcomes"],
      "properties": {
        "given": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "outcomes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["answerIndex", "then"],
            "properties": {
              "answerIndex": { "type": "integer", "minimum": 0 },
              "then": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
