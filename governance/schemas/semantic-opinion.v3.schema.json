{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.semantic_opinion.v3",
  "title": "Aegis Semantic IR Opinion v3",
  "description": "Parecer exclusivamente semântico. Fragmentos e fatos são evidência mecânica; classificações, claims e destinos são responsabilidade da IA. O Harness compila identificadores, vínculos, estados e digests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "sourceEvidenceDigest", "title", "interpretation", "changeKind", "scope",
    "intentClaims", "nonNormativeItems", "pathReferences",
    "architectureContexts", "policyAssessments", "complexityReview", "requirements",
    "invariants", "riskReview", "risks", "adversarialReview", "determinismReview",
    "boundaryRules", "unknowns", "decisions"
  ],
  "properties": {
    "schema": { "const": "aegis.semantic_opinion.v3" },
    "sourceEvidenceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "title": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_title" },
    "interpretation": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_interpretation" },
    "changeKind": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_changeKind" },
    "scope": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_scope" },
    "intentClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quote", "fragmentIndexes", "kind", "disposition", "contractEffect", "targets", "rationale"],
        "properties": {
          "quote": { "type": "string", "minLength": 1, "maxLength": 240 },
          "fragmentIndexes": { "$ref": "#/$defs/fragmentIndexes" },
          "kind": { "enum": ["OBLIGATION", "PROHIBITION", "GOAL", "OPTION", "EXAMPLE", "AMBIGUITY"] },
          "disposition": { "enum": ["NORMATIVE", "DECISION", "POLICY_CORRECTION", "NON_NORMATIVE"] },
          "contractEffect": { "type": ["string", "null"], "minLength": 1 },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_targetRef" },
            "uniqueItems": true
          },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nonNormativeItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "statement", "fragmentIndexes", "basis"],
        "properties": {
          "kind": { "enum": ["GOAL", "OPTION", "EXAMPLE"] },
          "statement": { "type": "string", "minLength": 1 },
          "fragmentIndexes": { "$ref": "#/$defs/fragmentIndexes" },
          "basis": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_basis" }
        }
      }
    },
    "pathReferences": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_pathReferences" },
    "architectureContexts": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_architectureContexts" },
    "policyAssessments": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_policyAssessments" },
    "complexityReview": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_complexityReview" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "statement", "basis", "fragmentIndexes", "measurement", "acceptanceCases"],
        "properties": {
          "kind": { "enum": ["FUNCTIONAL", "QUALITY"] },
          "statement": { "type": "string", "minLength": 1 },
          "basis": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_basis" },
          "fragmentIndexes": { "$ref": "#/$defs/fragmentIndexes" },
          "measurement": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_measurement" }
            ]
          },
          "acceptanceCases": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "given", "when", "then", "outcomeKind", "decisionBinding", "boundaryBinding"],
              "properties": {
                "kind": { "enum": ["HAPPY_PATH", "FAILURE", "BOUNDARY"] },
                "given": { "type": "string", "minLength": 1 },
                "when": { "type": "string", "minLength": 1 },
                "then": { "type": "string", "minLength": 1 },
                "outcomeKind": { "enum": ["RETURN_VALUE", "REJECTION", "NO_OP", "STATE_CHANGE", "OBSERVABLE_EFFECT"] },
                "decisionBinding": {
                  "oneOf": [
                    { "type": "null" },
                    { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_decisionBinding" }
                  ]
                },
                "boundaryBinding": {
                  "oneOf": [
                    { "type": "null" },
                    { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_boundaryBinding" }
                  ]
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "QUALITY" } } },
            "then": { "properties": { "measurement": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_measurement" } } },
            "else": { "properties": { "measurement": { "const": null } } }
          }
        ]
      }
    },
    "invariants": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_invariants" },
    "riskReview": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_riskReview" },
    "risks": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_risks" },
    "adversarialReview": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_adversarialReview" },
    "determinismReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rationale", "fragmentIndexes", "coverage", "dimensions"],
      "properties": {
        "rationale": { "type": "string", "minLength": 1 },
        "fragmentIndexes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "uniqueItems": true
        },
        "coverage": {
          "type": "array",
          "description": "Uma entrada para cada claim NORMATIVE ou DECISION. A IA declara explicitamente se a claim ativa dimensões de determinismo; o Harness valida cobertura, vínculos e ausência de dimensões órfãs.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claimIndex", "disposition", "dimensionIndexes", "rationale"],
            "properties": {
              "claimIndex": { "type": "integer", "minimum": 0 },
              "disposition": { "enum": ["DIMENSIONS_DECLARED", "NO_DIMENSION_APPLICABLE"] },
              "dimensionIndexes": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0 },
                "uniqueItems": true
              },
              "rationale": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              {
                "if": { "properties": { "disposition": { "const": "DIMENSIONS_DECLARED" } } },
                "then": { "properties": { "dimensionIndexes": { "type": "array", "minItems": 1 } } },
                "else": { "properties": { "dimensionIndexes": { "type": "array", "maxItems": 0 } } }
              }
            ]
          }
        },
        "dimensions": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_determinismReview_properties_dimensions" }
      }
    },
    "boundaryRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "representationKind", "lowerBound", "upperBound", "underflowBehavior", "overflowBehavior", "decisionIndex", "requirementIndexes", "acceptanceCases", "fragmentIndexes", "basis"],
        "properties": {
          "subject": { "type": "string", "minLength": 1 },
          "representationKind": { "enum": ["REPRESENTATION_WIDTH", "ENCODED_VALUE"] },
          "lowerBound": { "type": "string", "minLength": 1 },
          "upperBound": { "type": "string", "minLength": 1 },
          "underflowBehavior": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_rangeBehavior" },
          "overflowBehavior": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_rangeBehavior" },
          "decisionIndex": { "type": ["integer", "null"], "minimum": 0 },
          "requirementIndexes": {
            "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true
          },
          "acceptanceCases": {
            "type": "array", "minItems": 1,
            "items": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_acceptanceCaseRef" },
            "uniqueItems": true
          },
          "fragmentIndexes": { "$ref": "#/$defs/fragmentIndexes" },
          "basis": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_basis" }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "material", "decisionIndex", "fragmentIndexes", "basis"],
        "properties": {
          "statement": { "type": "string", "minLength": 1 },
          "material": { "type": "boolean" },
          "decisionIndex": { "type": ["integer", "null"], "minimum": 0 },
          "fragmentIndexes": { "$ref": "#/$defs/fragmentIndexes" },
          "basis": { "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_basis" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "aegis.semantic_opinion_decision.v1" }
    },
    "stateModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entities",
        "operations",
        "observables"
      ],
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "fields"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "isCollection": {
                "type": "boolean"
              },
              "admissionPolicy": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "capacityPolicy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "maxEntries",
                  "overflowPolicy"
                ],
                "properties": {
                  "maxEntries": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "overflowPolicy": {
                    "enum": [
                      "REJECT_NEW",
                      "LRU_EVICTION",
                      "FIFO_EVICTION",
                      "FAIL_OPERATION",
                      "STATIC_SINGLETON",
                      "NO_CONTRACT_LIMIT"
                    ]
                  },
                  "provenance": {
                    "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_basis"
                  },
                  "unboundedRationale": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "overflowPolicy": {
                          "const": "NO_CONTRACT_LIMIT"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "unboundedRationale"
                      ],
                      "properties": {
                        "unboundedRationale": {
                          "type": "string",
                          "minLength": 1
                        },
                        "maxEntries": {
                          "const": null
                        }
                      }
                    }
                  }
                ]
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "type",
                    "initialization",
                    "mutations",
                    "reset",
                    "preservation",
                    "readBy"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "enum": [
                        "INTEGER",
                        "BOOLEAN",
                        "TIMESTAMP",
                        "STRING",
                        "MAP",
                        "SET",
                        "COLLECTION"
                      ]
                    },
                    "isCounter": {
                      "type": "boolean"
                    },
                    "bounds": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "lowerBound",
                        "upperBound",
                        "boundaryBehavior"
                      ],
                      "properties": {
                        "lowerBound": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "upperBound": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "boundaryBehavior": {
                          "enum": [
                            "SATURATE",
                            "REJECT",
                            "ROLLOVER_MODULO",
                            "PRESERVE",
                            "UNBOUNDED_ERROR"
                          ]
                        },
                        "provenance": {
                          "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_basis"
                        }
                      }
                    },
                    "initialization": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind",
                        "value",
                        "rationale"
                      ],
                      "properties": {
                        "kind": {
                          "enum": [
                            "EXPLICIT_VALUE",
                            "CONFIGURED",
                            "DERIVED",
                            "UNRESOLVED"
                          ]
                        },
                        "value": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "rationale": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "mutations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "operation",
                          "condition",
                          "effect",
                          "targetValue"
                        ],
                        "properties": {
                          "operation": {
                            "type": "string",
                            "minLength": 1
                          },
                          "condition": {
                            "type": "string",
                            "minLength": 1
                          },
                          "effect": {
                            "enum": [
                              "INCREMENT",
                              "DECREMENT",
                              "SET_VALUE",
                              "MUTATE_COLLECTION",
                              "CUSTOM"
                            ]
                          },
                          "targetValue": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    },
                    "reset": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "allowed",
                        "trigger",
                        "resetValue"
                      ],
                      "properties": {
                        "allowed": {
                          "type": "boolean"
                        },
                        "trigger": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "resetValue": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "preservation": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "readBy": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "derivation": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "formula",
                        "inputs",
                        "total"
                      ],
                      "properties": {
                        "formula": {
                          "type": "string",
                          "minLength": 1
                        },
                        "inputs": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "total": {
                          "type": "boolean"
                        },
                        "rationale": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "operations": {
          "$ref": "aegis.contract_components.v1#/$defs/state_operations"
        },
        "observables": {
          "$ref": "aegis.contract_components.v1#/$defs/state_observables"
        },
        "canonicalSerializations": {
          "$ref": "aegis.contract_components.v1#/$defs/state_canonicalSerializations"
        },
        "aggregations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sourceCollection",
              "aggregationKind",
              "filterPredicate"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "sourceCollection": {
                "type": "string",
                "minLength": 1
              },
              "aggregationKind": {
                "enum": [
                  "COUNT_DISTINCT",
                  "COUNT",
                  "SUM",
                  "TRAILING_STREAK",
                  "MAX_STREAK",
                  "EXISTS"
                ]
              },
              "filterPredicate": {
                "type": "string",
                "minLength": 1
              },
              "saturationLimit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "provenance": {
                "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_basis"
              }
            }
          }
        },
        "producerConsumerBoundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "signalName",
              "producer",
              "consumer",
              "ownership"
            ],
            "properties": {
              "signalName": {
                "type": "string",
                "minLength": 1
              },
              "producer": {
                "type": "string",
                "minLength": 1
              },
              "consumer": {
                "type": "string",
                "minLength": 1
              },
              "ownership": {
                "enum": [
                  "SYSTEM_CONFIGURATION",
                  "REQUEST_INGRESS",
                  "ENTITY_LOCAL",
                  "COMPILATION_OUTPUT"
                ]
              },
              "recomputableByConsumer": {
                "type": "boolean"
              },
              "provenance": {
                "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_basis"
              }
            }
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "members"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "members": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "provenance": {
                "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_basis"
              }
            }
          }
        },
        "computabilityGraph": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "category", "dependencies"],
            "properties": {
              "symbol": { "type": "string", "minLength": 1 },
              "nodeId": { "type": "string", "minLength": 1 },
              "category": {
                "enum": [
                  "EXTERNAL_INPUT",
                  "STATE_FIELD",
                  "COMPUTED_VARIABLE",
                  "DERIVED_VALUE",
                  "MATHEMATICAL_RULE",
                  "SYSTEM_CONFIGURATION",
                  "HUMAN_DECISION"
                ]
              },
              "semanticType": {
                "enum": [
                  "VALUE",
                  "ENTITY",
                  "IDENTITY",
                  "COLLECTION",
                  "AGGREGATE",
                  "RELATION",
                  "STATE",
                  "EVENT",
                  "TRANSACTION",
                  "EXTERNAL_EFFECT"
                ]
              },
              "unit": {
                "type": "object",
                "additionalProperties": false,
                "required": ["family", "label"],
                "properties": {
                  "family": {
                    "enum": [
                      "DISCRETE_COUNT",
                      "PHYSICAL_VOLUME",
                      "PHYSICAL_MASS",
                      "PHYSICAL_WEIGHT",
                      "CURRENCY",
                      "TIME",
                      "RATIO",
                      "RAW_IDENTIFIER"
                    ]
                  },
                  "label": { "type": "string", "minLength": 1 },
                  "conversion": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["fromUnit", "toUnit"],
                    "properties": {
                      "fromUnit": { "type": "string", "minLength": 1 },
                      "toUnit": { "type": "string", "minLength": 1 },
                      "factor": {
                        "anyOf": [
                          { "type": "string", "minLength": 1 },
                          { "type": "number" }
                        ]
                      }
                    }
                  }
                }
              },
              "cardinality": {
                "enum": [
                  "SCALAR",
                  "AGGREGATE",
                  "COLLECTION"
                ]
              },
              "identityScope": {
                "type": "object",
                "additionalProperties": false,
                "required": ["entity"],
                "properties": {
                  "entity": { "type": "string", "minLength": 1 },
                  "identifierField": { "type": "string", "minLength": 1 },
                  "isPreservedSet": { "type": "boolean" }
                }
              },
              "transaction": {
                "type": "object",
                "additionalProperties": false,
                "required": ["scope", "candidateFields", "commitGuard"],
                "properties": {
                  "scope": { "type": "string", "minLength": 1 },
                  "candidateFields": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "commitGuard": { "type": "string", "minLength": 1 },
                  "onCommit": { "type": "string", "minLength": 1 },
                  "onRollback": { "type": "string", "minLength": 1 }
                }
              },
              "dependencies": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "derivationRule": { "type": "string" },
              "formula": { "type": "string" },
              "groundedIn": { "type": "string" },
              "target": { "type": "string" },
              "status": { "type": "string" },
              "edgeCaseRules": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tieBreaking": { "type": "string", "minLength": 1 },
                  "zeroDivisor": { "type": "string", "minLength": 1 },
                  "unfilledBuffer": { "type": "string", "minLength": 1 }
                }
              },
              "feedbackConfirmation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["executionMode"],
                "properties": {
                  "signal": { "type": "string", "minLength": 1 },
                  "confirmedBy": { "type": "string", "minLength": 1 },
                  "executionMode": {
                    "enum": [
                      "LOCAL_SYNCHRONOUS_FILL",
                      "EXTERNAL_ASYNCHRONOUS_REPORT",
                      "NO_FEEDBACK_REQUIRED"
                    ]
                  },
                  "onRejection": { "type": "string", "minLength": 1 }
                }
              },
              "computabilityStatus": {
                "enum": [
                  "COMPUTABLE",
                  "NOT_COMPUTABLE",
                  "OPEN_DEPENDENCY"
                ]
              },
              "provenance": {
                "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_basis"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "fragmentIndexes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 },
      "uniqueItems": true
    }
  }
}
