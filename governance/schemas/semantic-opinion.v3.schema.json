{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.semantic_opinion.v3",
  "title": "Aegis Semantic IR Opinion v3",
  "description": "Parecer exclusivamente semântico. Fragmentos e fatos são evidência mecânica; classificações, claims e destinos são responsabilidade da IA. O Harness compila identificadores, vínculos, estados e digests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceEvidenceDigest",
    "title",
    "interpretation",
    "changeKind",
    "scope",
    "intentClaims",
    "nonNormativeItems",
    "pathReferences",
    "architectureContexts",
    "policyAssessments",
    "complexityReview",
    "requirements",
    "invariants",
    "riskReview",
    "risks",
    "adversarialReview",
    "determinismReview",
    "boundaryRules",
    "unknowns",
    "decisions",
    "stateModel"
  ],
  "properties": {
    "schema": {
      "const": "aegis.semantic_opinion.v3"
    },
    "sourceEvidenceDigest": {
      "$ref": "aegis.contract_components.v1#/$defs/sha256_digest"
    },
    "title": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_title"
    },
    "interpretation": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_interpretation"
    },
    "changeKind": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_changeKind"
    },
    "scope": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_scope"
    },
    "intentClaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quote",
          "fragmentIndexes",
          "kind",
          "disposition",
          "contractEffect",
          "targets",
          "rationale"
        ],
        "properties": {
          "quote": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_05"
          },
          "fragmentIndexes": {
            "$ref": "#/$defs/fragmentIndexes"
          },
          "kind": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_29"
          },
          "disposition": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_39"
          },
          "contractEffect": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_02"
          },
          "targets": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_38"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "nonNormativeItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "statement",
          "fragmentIndexes",
          "basis"
        ],
        "properties": {
          "kind": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_48"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "fragmentIndexes": {
            "$ref": "#/$defs/fragmentIndexes"
          },
          "basis": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_basis"
          }
        }
      }
    },
    "pathReferences": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_pathReferences"
    },
    "architectureContexts": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_architectureContexts"
    },
    "policyAssessments": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_policyAssessments"
    },
    "complexityReview": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_complexityReview"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "statement",
          "basis",
          "fragmentIndexes",
          "measurement",
          "acceptanceCases"
        ],
        "properties": {
          "kind": {
            "enum": [
              "FUNCTIONAL",
              "QUALITY"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_basis"
          },
          "fragmentIndexes": {
            "$ref": "#/$defs/fragmentIndexes"
          },
          "measurement": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_measurement"
              }
            ]
          },
          "acceptanceCases": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "given",
                "when",
                "then",
                "outcomeKind",
                "decisionBinding",
                "boundaryBinding"
              ],
              "properties": {
                "kind": {
                  "$ref": "aegis.contract_components.v1#/$defs/shared_component_44"
                },
                "given": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "then": {
                  "type": "string",
                  "minLength": 1
                },
                "outcomeKind": {
                  "$ref": "aegis.contract_components.v1#/$defs/shared_component_13"
                },
                "branchRef": {
                  "$ref": "aegis.contract_components.v1#/$defs/shared_component_02"
                },
                "batchWitness": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "aegis.contract_components.v1#/$defs/acceptance_batch_witness"
                    }
                  ]
                },
                "crossOperationWitness": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "aegis.contract_components.v1#/$defs/acceptance_cross_operation_witness"
                    }
                  ]
                },
                "keyComparisonWitness": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "aegis.contract_components.v1#/$defs/acceptance_key_comparison_witness"
                    }
                  ]
                },
                "decisionBinding": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_decisionBinding"
                    }
                  ]
                },
                "boundaryBinding": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_boundaryBinding"
                    }
                  ]
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "QUALITY"
                }
              }
            },
            "then": {
              "properties": {
                "measurement": {
                  "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_measurement"
                }
              }
            },
            "else": {
              "properties": {
                "measurement": {
                  "const": null
                }
              }
            }
          }
        ]
      }
    },
    "invariants": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_invariants"
    },
    "riskReview": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_riskReview"
    },
    "risks": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_risks"
    },
    "adversarialReview": {
      "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_adversarialReview"
    },
    "determinismReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rationale",
        "fragmentIndexes",
        "coverage",
        "dimensions"
      ],
      "properties": {
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "fragmentIndexes": {
          "$ref": "aegis.contract_components.v1#/$defs/shared_component_09"
        },
        "coverage": {
          "type": "array",
          "description": "Uma entrada para cada claim NORMATIVE ou DECISION. A IA declara explicitamente se a claim ativa dimensões de determinismo; o Harness valida cobertura, vínculos e ausência de dimensões órfãs.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claimIndex",
              "disposition",
              "dimensionIndexes",
              "rationale"
            ],
            "properties": {
              "claimIndex": {
                "type": "integer",
                "minimum": 0
              },
              "disposition": {
                "enum": [
                  "DIMENSIONS_DECLARED",
                  "NO_DIMENSION_APPLICABLE"
                ]
              },
              "dimensionIndexes": {
                "$ref": "aegis.contract_components.v1#/$defs/shared_component_09"
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "disposition": {
                      "const": "DIMENSIONS_DECLARED"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "dimensionIndexes": {
                      "type": "array",
                      "minItems": 1
                    }
                  }
                },
                "else": {
                  "properties": {
                    "dimensionIndexes": {
                      "type": "array",
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          }
        },
        "dimensions": {
          "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_determinismReview_properties_dimensions"
        },
        "arithmetic": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "aegis.contract_components.v1#/$defs/arithmetic_policy_opinion"
            }
          ]
        }
      }
    },
    "boundaryRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "representationKind",
          "lowerBound",
          "upperBound",
          "underflowBehavior",
          "overflowBehavior",
          "decisionIndex",
          "requirementIndexes",
          "acceptanceCases",
          "fragmentIndexes",
          "basis"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "representationKind": {
            "enum": [
              "REPRESENTATION_WIDTH",
              "ENCODED_VALUE"
            ]
          },
          "lowerBound": {
            "type": "string",
            "minLength": 1
          },
          "upperBound": {
            "type": "string",
            "minLength": 1
          },
          "underflowBehavior": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_rangeBehavior"
          },
          "overflowBehavior": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_draft_rangeBehavior"
          },
          "decisionIndex": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_18"
          },
          "requirementIndexes": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_10"
          },
          "acceptanceCases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_acceptanceCaseRef"
            },
            "uniqueItems": true
          },
          "fragmentIndexes": {
            "$ref": "#/$defs/fragmentIndexes"
          },
          "basis": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_basis"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "material",
          "decisionIndex",
          "fragmentIndexes",
          "basis"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "description": "Para unknown material sem decisão madura, formule como pergunta objetiva ao usuário; não invente alternativas nem uma resposta."
          },
          "material": {
            "type": "boolean"
          },
          "materialEffect": {
            "type": "string",
            "minLength": 1,
            "description": "Para unknown material, descreva qual resultado público do contrato pode mudar conforme a resposta. Use uma diferença concreta e fundamentada; não invente cenário nem requisito."
          },
          "decisionIndex": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_18"
          },
          "fragmentIndexes": {
            "$ref": "#/$defs/fragmentIndexes"
          },
          "basis": {
            "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_basis"
          },
          "materialEffect": {
            "type": "string",
            "minLength": 1,
            "description": "Para unknown material, descreva qual resultado público do contrato pode mudar conforme a resposta. Use uma diferença concreta e fundamentada; não invente cenário nem requisito."
          }
        },
        "if": {
          "properties": {
            "material": {
              "const": true
            }
          },
          "required": [
            "material"
          ]
        },
        "then": {
          "properties": {
            "materialEffect": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "materialEffect"
          ]
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_decision"
      }
    },
    "stateModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entities",
        "operations",
        "observables"
      ],
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "fields"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "isCollection": {
                "type": "boolean"
              },
              "admissionPolicy": {
                "$ref": "aegis.contract_components.v1#/$defs/shared_component_01"
              },
              "capacityPolicy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "maxEntries",
                  "overflowPolicy"
                ],
                "properties": {
                  "maxEntries": {
                    "$ref": "aegis.contract_components.v1#/$defs/shared_component_01"
                  },
                  "overflowPolicy": {
                    "$ref": "aegis.contract_components.v1#/$defs/shared_component_20"
                  },
                  "provenance": {
                    "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_basis"
                  },
                  "unboundedRationale": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "overflowPolicy": {
                          "const": "NO_CONTRACT_LIMIT"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "unboundedRationale"
                      ],
                      "properties": {
                        "unboundedRationale": {
                          "type": "string",
                          "minLength": 1
                        },
                        "maxEntries": {
                          "const": null
                        }
                      }
                    }
                  }
                ]
              },
              "containerPolicy": {
                "$ref": "aegis.contract_components.v1#/$defs/state_containerPolicy"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "type",
                    "initialization",
                    "reset"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "$ref": "aegis.contract_components.v1#/$defs/shared_component_25"
                    },
                    "temporalUnit": {
                      "$ref": "aegis.contract_components.v1#/$defs/state_field_temporalUnit"
                    },
                    "temporalRole": {
                      "$ref": "aegis.contract_components.v1#/$defs/state_field_temporalRole"
                    },
                    "usedInLookup": {
                      "$ref": "aegis.contract_components.v1#/$defs/shared_component_03"
                    },
                    "usedInDeduplication": {
                      "$ref": "aegis.contract_components.v1#/$defs/shared_component_03"
                    },
                    "usedInPartition": {
                      "$ref": "aegis.contract_components.v1#/$defs/shared_component_03"
                    },
                    "allowedValues": {
                      "$ref": "aegis.contract_components.v1#/$defs/shared_component_11"
                    },
                    "isCounter": {
                      "type": "boolean"
                    },
                    "bounds": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "lowerBound",
                        "upperBound",
                        "boundaryBehavior"
                      ],
                      "properties": {
                        "lowerBound": {
                          "$ref": "aegis.contract_components.v1#/$defs/shared_component_01"
                        },
                        "upperBound": {
                          "$ref": "aegis.contract_components.v1#/$defs/shared_component_01"
                        },
                        "boundaryBehavior": {
                          "$ref": "aegis.contract_components.v1#/$defs/shared_component_32"
                        },
                        "provenance": {
                          "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_basis"
                        }
                      }
                    },
                    "initialization": {
                      "$ref": "aegis.contract_components.v1#/$defs/state_field_initialization"
                    },
                    "mutations": {
                      "$ref": "aegis.contract_components.v1#/$defs/state_field_mutations"
                    },
                    "reset": {
                      "$ref": "aegis.contract_components.v1#/$defs/state_field_reset"
                    },
                    "preservation": {
                      "$ref": "aegis.contract_components.v1#/$defs/shared_component_06"
                    },
                    "readBy": {
                      "$ref": "aegis.contract_components.v1#/$defs/shared_component_06"
                    }
                  }
                }
              }
            }
          }
        },
        "operations": {
          "$ref": "aegis.contract_components.v1#/$defs/state_operations"
        },
        "observables": {
          "$ref": "aegis.contract_components.v1#/$defs/state_observables"
        },
        "canonicalSerializations": {
          "$ref": "aegis.contract_components.v1#/$defs/state_canonicalSerializations"
        }
      }
    }
  },
  "$defs": {
    "fragmentIndexes": {
      "$ref": "aegis.contract_components.v1#/$defs/shared_component_10"
    }
  }
}