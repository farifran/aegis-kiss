{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.ide_preflight.v1",
  "title": "Aegis IDE Preflight Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "normalizedDemandDigest", "mechanicalFactsDigest", "architecturePolicyDigest", "architectureSourceStatus", "promptDigest", "prompt"],
  "properties": {
    "schema": { "const": "aegis.ide_preflight.v1" },
    "status": { "const": "PENDING_SEMANTIC_PREFLIGHT" },
    "normalizedDemandDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "mechanicalFactsDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "architecturePolicyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "architectureSourceStatus": { "enum": ["CURRENT", "STALE"] },
    "promptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "prompt": { "type": "string", "minLength": 1 }
  }
}
