{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.architecture_policy.v3",
  "title": "Aegis Architecture Policy v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policyVersion",
    "origin",
    "contexts",
    "rules",
    "amendments"
  ],
  "properties": {
    "schema": {
      "const": "aegis.architecture_policy.v3"
    },
    "policyVersion": {
      "type": "integer",
      "minimum": 1
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "sourceDigest"
      ],
      "properties": {
        "sourcePath": {
          "const": "ARCHITECTURE.md"
        },
        "sourceDigest": {
          "$ref": "aegis.contract_components.v1#/$defs/sha256_digest"
        }
      }
    },
    "contexts": {
      "$ref": "aegis.contract_components.v1#/$defs/architecture_policy_contexts"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "amendments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/amendment"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "level",
        "statement",
        "appliesWhen",
        "appliesMode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ARCH-[A-Z0-9][A-Z0-9-]+$"
        },
        "level": {
          "$ref": "aegis.contract_components.v1#/$defs/shared_component_46"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "appliesWhen": {
          "$ref": "aegis.contract_components.v1#/$defs/shared_component_30"
        },
        "appliesMode": {
          "enum": [
            "any",
            "all"
          ]
        }
      }
    },
    "amendment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ruleId",
        "status",
        "reason",
        "approvedBy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ARCH-AMEND-[A-Z0-9][A-Z0-9-]+$"
        },
        "ruleId": {
          "type": "string",
          "pattern": "^ARCH-[A-Z0-9][A-Z0-9-]+$"
        },
        "status": {
          "const": "approved"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "approvedBy": {
          "const": "user"
        }
      }
    }
  }
}
