    "preconditions": { "$ref": "aegis.contract_ir.v2#/properties/preconditions" },
    "invariants": { "$ref": "aegis.contract_ir.v2#/properties/invariants" },
    "postconditions": { "$ref": "aegis.contract_ir.v2#/properties/postconditions" },
    "failureSemantics": { "$ref": "aegis.contract_ir.v2#/properties/failureSemantics" },
    "proofObligations": { "$ref": "aegis.contract_ir.v2#/properties/proofObligations" },
    "requirementCoverage": { "$ref": "aegis.contract_ir.v2#/properties/requirementCoverage" },
