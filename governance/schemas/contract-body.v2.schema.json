  "$id": "aegis.contract_body.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "behavior", "invariants", "proofObligations", "requirementCoverage"],
  "properties": {
    "scope": { "$ref": "aegis.contract_ir.v2#/properties/scope" },
