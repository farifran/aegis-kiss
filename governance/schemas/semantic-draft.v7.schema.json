{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.semantic_draft.v7",
  "title": "Aegis Semantic Contract Draft v7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceContextDigest",
    "title",
    "interpretation",
    "changeKind",
    "scope",
    "intentClaims",
    "nonNormativeItems",
    "pathReferences",
    "architectureContexts",
    "policyAssessments",
    "complexityReview",
    "requirements",
    "invariants",
    "riskReview",
    "risks",
    "adversarialReview",
    "determinismReview",
    "boundaryRules",
    "unknowns",
    "decisions"
  ],
  "properties": {
    "schema": { "const": "aegis.semantic_draft.v7" },
    "sourceContextDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "title": { "type": "string", "minLength": 1 },
    "interpretation": { "type": "string", "minLength": 1 },
    "changeKind": { "enum": ["PRODUCT", "HARNESS"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "description": "Declare somente comportamentos e fronteiras públicas observáveis. Caminhos são classificados separadamente em pathReferences.",
      "required": ["inScope", "outOfScope"],
      "properties": {
        "inScope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "outOfScope": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "intentClaims": {
      "type": "array",
      "minItems": 1,
      "description": "Mapa auditável e atômico das afirmações materiais da demanda. Cada citação é literal e recebe uma única destinação. Afirmações normativas repetem a citação em contractEffect, que deve aparecer literalmente no requisito ou prova de destino.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "quote", "kind", "disposition", "contractEffect", "targetIds", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^CLAIM-[A-Z0-9][A-Z0-9-]+$" },
          "quote": { "type": "string", "minLength": 1, "maxLength": 240 },
          "kind": { "enum": ["OBLIGATION", "PROHIBITION", "GOAL", "OPTION", "EXAMPLE", "AMBIGUITY"] },
          "disposition": { "enum": ["NORMATIVE", "DECISION", "POLICY_CORRECTION", "NON_NORMATIVE"] },
          "contractEffect": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "minLength": 1 }
            ]
          },
          "targetIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^(REQ|Q|NOTE|PATH|ARCH|BOUND)-[A-Z0-9][A-Z0-9-]+$" }
          },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nonNormativeItems": {
      "type": "array",
      "description": "Preserva metas, opções e exemplos sem promovê-los a obrigação, meta numérica ou decisão artificial.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "statement", "status", "intentSignalIds", "basis"],
        "properties": {
          "id": { "type": "string", "pattern": "^NOTE-[A-Z0-9][A-Z0-9-]+$" },
          "kind": { "enum": ["GOAL", "OPTION", "EXAMPLE"] },
          "statement": { "type": "string", "minLength": 1 },
          "status": { "const": "NON_NORMATIVE" },
          "intentSignalIds": { "$ref": "#/$defs/intentSignalIds" },
          "basis": { "$ref": "#/$defs/basis" }
        }
      }
    },
    "pathReferences": {
      "type": "array",
      "description": "Classifica caminhos citados sem confundir superfície pública, restrição interna explícita, sugestão não normativa e evidência observada.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "role", "rationale", "requirementIds", "basis"],
        "properties": {
          "id": { "type": "string", "pattern": "^PATH-[A-Z0-9][A-Z0-9-]+$" },
          "path": { "$ref": "#/$defs/repositoryPath" },
          "role": { "enum": ["PUBLIC_SURFACE", "IMPLEMENTATION_CONSTRAINT", "IMPLEMENTATION_SUGGESTION", "EVIDENCE_ONLY"] },
          "rationale": { "type": "string", "minLength": 1 },
          "requirementIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "basis": { "$ref": "#/$defs/basis" }
        }
      }
    },
    "architectureContexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "rationale", "basis"],
        "properties": {
          "tag": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "rationale": { "type": "string", "minLength": 1 },
          "basis": { "$ref": "#/$defs/basis" }
        }
      }
    },
    "policyAssessments": {
      "type": "array",
      "description": "Avalie exatamente as regras ativadas pelos contextos declarados ou por referências explícitas da demanda.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "demandStatus", "recommendedStatus", "rationale", "decisionId", "amendmentId"],
        "properties": {
          "ruleId": { "type": "string", "pattern": "^ARCH-[A-Z0-9][A-Z0-9-]+$" },
          "demandStatus": { "enum": ["COMPLIANT", "CONFLICT"] },
          "recommendedStatus": { "enum": ["COMPLIANT", "AMENDED"] },
          "rationale": { "type": "string", "minLength": 1 },
          "decisionId": { "type": ["string", "null"], "pattern": "^Q-[A-Z0-9][A-Z0-9-]+$" },
          "amendmentId": { "type": ["string", "null"], "pattern": "^ARCH-AMEND-[A-Z0-9][A-Z0-9-]+$" }
        }
      }
    },
    "complexityReview": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pode simplificar automaticamente complexidade apenas sugerida. Não crie decisão quando KISS já determinar a resposta.",
      "required": ["status", "rationale", "alternatives"],
      "properties": {
        "status": { "enum": ["NO_EXCESS", "SIMPLIFIED", "JUSTIFIED"] },
        "rationale": { "type": "string", "minLength": 1 },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requested", "simpler", "rationale", "basis"],
            "properties": {
              "requested": { "type": "string", "minLength": 1 },
              "simpler": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 1 },
              "basis": { "$ref": "#/$defs/basis" }
            }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "statement", "basis", "intentSignalIds", "measurement", "acceptanceCases"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9-]+$" },
          "kind": { "enum": ["FUNCTIONAL", "QUALITY"] },
          "statement": { "type": "string", "minLength": 1 },
          "basis": { "$ref": "#/$defs/basis" },
          "intentSignalIds": { "$ref": "#/$defs/intentSignalIds" },
          "measurement": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/$defs/measurement" }
            ]
          },
          "acceptanceCases": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "given", "when", "then", "outcomeKind", "decisionBinding", "boundaryBinding"],
              "properties": {
                "id": { "type": "string", "pattern": "^AC-[A-Z0-9][A-Z0-9-]+$" },
                "kind": { "enum": ["HAPPY_PATH", "FAILURE", "BOUNDARY"] },
                "given": { "type": "string", "minLength": 1 },
                "when": { "type": "string", "minLength": 1 },
                "then": { "type": "string", "minLength": 1 },
                "outcomeKind": { "enum": ["RETURN_VALUE", "REJECTION", "NO_OP", "STATE_CHANGE", "OBSERVABLE_EFFECT"] },
                "decisionBinding": {
                  "oneOf": [
                    { "type": "null" },
                    { "$ref": "#/$defs/decisionBinding" }
                  ]
                },
                "boundaryBinding": {
                  "oneOf": [
                    { "type": "null" },
                    { "$ref": "#/$defs/boundaryBinding" }
                  ]
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "QUALITY" } } },
            "then": { "properties": { "measurement": { "$ref": "#/$defs/measurement" } } },
            "else": { "properties": { "measurement": { "const": null } } }
          }
        ]
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "falsification", "requirementIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^INV-[A-Z0-9][A-Z0-9-]+$" },
          "statement": { "type": "string", "minLength": 1 },
          "falsification": { "type": "string", "minLength": 1 },
          "requirementIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "level", "statement", "mitigation", "requirementIds", "basis"],
        "properties": {
          "id": { "type": "string", "pattern": "^RISK-[A-Z0-9][A-Z0-9-]+$" },
          "kind": { "enum": ["SECURITY", "RELIABILITY", "PRIVACY", "PERFORMANCE", "INTEGRITY", "COMPLEXITY"] },
          "level": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "statement": { "type": "string", "minLength": 1 },
          "mitigation": { "type": "string", "minLength": 1 },
          "requirementIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "basis": { "$ref": "#/$defs/basis" }
        }
      }
    },
    "riskReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": { "enum": ["FOUND", "NONE", "UNKNOWN"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "adversarialReview": {
      "type": "object",
      "additionalProperties": false,
      "description": "Revisão semântica residual: procure contradições, deriva semântica, omissões, lacunas de determinismo e perguntas artificiais depois das correções mecânicas e de política. Registre somente achados materiais já absorvidos pelo contrato.",
      "required": ["status", "rationale", "findings"],
      "properties": {
        "status": { "enum": ["NO_ADDITIONAL_FINDINGS", "CHALLENGES_INTEGRATED"] },
        "rationale": { "type": "string", "minLength": 1 },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "disposition", "challenge", "response", "targetIds", "basis"],
            "properties": {
              "id": { "type": "string", "pattern": "^ADV-[A-Z0-9][A-Z0-9-]+$" },
              "kind": { "enum": ["CONTRADICTION", "SEMANTIC_DRIFT", "OMISSION", "DETERMINISM_GAP", "ARTIFICIAL_DECISION", "TECHNICAL_RISK"] },
              "disposition": { "enum": ["REQUIREMENT", "DECISION", "POLICY_CORRECTION", "NON_NORMATIVE"] },
              "challenge": { "type": "string", "minLength": 1 },
              "response": { "type": "string", "minLength": 1, "description": "Trecho da correção já incorporada em pelo menos um targetId; não é promessa paralela." },
              "targetIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^(REQ|INV|RISK|Q|BOUND|NOTE|PATH|ARCH)-[A-Z0-9][A-Z0-9-]+$" }
              },
              "basis": { "$ref": "#/$defs/basis" }
            }
          }
        }
      }
    },
    "determinismReview": {
      "type": "object",
      "additionalProperties": false,
      "description": "Quando a demanda promete determinismo, classifica cada dimensão universal separadamente. O compilador anexa autoridade e testemunho mecânico; lacunas sem prova permanecem GAP_FOUND.",
      "required": ["status", "rationale", "intentSignalIds", "dimensions"],
      "properties": {
        "status": { "enum": ["NOT_APPLICABLE", "SEMANTICALLY_CLOSED", "GAPS_FOUND"] },
        "rationale": { "type": "string", "minLength": 1 },
        "intentSignalIds": { "$ref": "#/$defs/intentSignalIds" },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "subjectId", "status", "rationale", "targetIds", "basis", "acceptanceCaseId", "proofObligation", "inapplicabilityProof", "closureAuthority", "counterexampleWitness"],
            "properties": {
              "kind": { "enum": ["ORDERING", "CANONICALIZATION", "DUPLICATES", "EMPTY_INPUT", "ODD_CARDINALITY", "ROUNDING", "REMAINDER_DISTRIBUTION", "ZERO_DIVISOR", "TIE_BREAKING", "COUNTING_IDENTITY", "BOUNDED_ARITHMETIC"] },
              "subjectId": {
                "oneOf": [
                  { "const": "PUBLIC_CONTRACT" },
                  { "type": "string", "pattern": "^(REQ|BOUND)-[A-Z0-9][A-Z0-9-]+$" }
                ]
              },
              "status": { "enum": ["SPECIFIED", "NOT_APPLICABLE", "DECISION_REQUIRED", "GAP_FOUND"] },
              "rationale": { "type": "string", "minLength": 1, "description": "Para SPECIFIED, contém uma regra concreta sem alternativas e idêntica ao resultado do único acceptanceCaseId vinculado." },
              "basis": { "$ref": "#/$defs/basis" },
              "acceptanceCaseId": { "type": ["string", "null"], "pattern": "^AC-[A-Z0-9][A-Z0-9-]+$" },
              "proofObligation": {
                "oneOf": [
                  { "type": "null" },
                  { "$ref": "#/$defs/determinismProofObligation" }
                ]
              },
              "closureAuthority": { "enum": ["MECHANICAL_FACT", "AUTHORITATIVE_RULE", "HUMAN_DECISION", "MODEL_ARGUMENT"] },
              "counterexampleWitness": { "$ref": "#/$defs/counterexampleWitness" },
              "inapplicabilityProof": {
                "oneOf": [
                  { "type": "null" },
                  { "$ref": "#/$defs/inapplicabilityProof" }
                ]
              },
              "targetIds": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^(REQ|INV|Q|BOUND)-[A-Z0-9][A-Z0-9-]+$" }
              }
            }
          }
        }
      }
    },
    "boundaryRules": {
      "type": "array",
      "description": "Declara comportamento observável para valores públicos de representação finita. Saídas de largura fixa podem provar apenas EXACT_WIDTH; valores que recebem quantidades fora da faixa precisam de política lateral explícita.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject", "lowerBound", "upperBound", "underflowBehavior", "overflowBehavior", "decisionId", "requirementIds", "acceptanceCaseIds", "intentSignalIds", "basis"],
        "properties": {
          "id": { "type": "string", "pattern": "^BOUND-[A-Z0-9][A-Z0-9-]+$" },
          "subject": { "type": "string", "minLength": 1 },
          "representationKind": { "enum": ["REPRESENTATION_WIDTH", "ENCODED_VALUE"] },
          "lowerBound": { "type": "string", "minLength": 1 },
          "upperBound": { "type": "string", "minLength": 1 },
          "underflowBehavior": { "$ref": "#/$defs/rangeBehavior" },
          "overflowBehavior": { "$ref": "#/$defs/rangeBehavior" },
          "decisionId": { "type": ["string", "null"], "pattern": "^Q-[A-Z0-9][A-Z0-9-]+$" },
          "requirementIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "acceptanceCaseIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "intentSignalIds": { "$ref": "#/$defs/intentSignalIds" },
          "basis": { "$ref": "#/$defs/basis" }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "material", "decisionId", "intentSignalIds", "basis"],
        "properties": {
          "id": { "type": "string", "pattern": "^UNKNOWN-[A-Z0-9][A-Z0-9-]+$" },
          "statement": { "type": "string", "minLength": 1 },
          "material": { "type": "boolean" },
          "decisionId": { "type": ["string", "null"] },
          "intentSignalIds": { "$ref": "#/$defs/intentSignalIds" },
          "basis": { "$ref": "#/$defs/basis" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "description": "Cada recomendação precisa estar materializada em ao menos um caso falsificável ligado ao answerId recomendado.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "question", "recommendedAnswerId", "requirementIds", "invariantIds", "riskIds", "answers"],
        "properties": {
          "questionId": { "type": "string", "pattern": "^Q-[A-Z0-9][A-Z0-9-]+$" },
          "question": { "type": "string", "minLength": 1 },
          "recommendedAnswerId": { "type": "string", "minLength": 1 },
          "requirementIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
          "invariantIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "riskIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "distinguishingCase": {
            "type": "object",
            "additionalProperties": false,
            "required": ["given", "when", "outcomes"],
            "properties": {
              "given": { "type": "string", "minLength": 1 },
              "when": { "type": "string", "minLength": 1 },
              "outcomes": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["answerId", "then"],
                  "properties": {
                    "answerId": { "type": "string", "pattern": "^ANS-[A-Z0-9][A-Z0-9-]+$" },
                    "then": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          },
          "answers": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "rationale", "contractEffect", "recommended"],
              "properties": {
                "id": { "type": "string", "pattern": "^ANS-[A-Z0-9][A-Z0-9-]+$" },
                "label": { "type": "string", "minLength": 1 },
                "rationale": { "type": "string", "minLength": 1 },
                "contractEffect": { "type": "string", "minLength": 1 },
                "recommended": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/basisRef" }
    },
    "basisRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reference"],
      "properties": {
        "source": { "enum": ["USER_INTENT", "USER_DECISION", "CONSTITUTION", "ARCHITECTURE_POLICY", "SAFE_MECHANICAL_DEFAULT", "WORKSPACE_EVIDENCE", "MODEL_ANALYSIS"] },
        "reference": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "intentSignalIds": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^INPUT-[0-9]{4}$" }
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\.\\.?$)(?!\\.\\./)(?!.*\\/\\.\\.(?:/|$))[^\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069]+$"
    },
    "decisionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "answerId"],
      "properties": {
        "questionId": { "type": "string", "pattern": "^Q-[A-Z0-9][A-Z0-9-]+$" },
        "answerId": { "type": "string", "pattern": "^ANS-[A-Z0-9][A-Z0-9-]+$" }
      }
    },
    "boundaryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "side", "expectedBehavior", "expectedValue"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^BOUND-[A-Z0-9][A-Z0-9-]+$" },
        "side": { "enum": ["UNDERFLOW", "OVERFLOW", "EXACT_WIDTH"] },
        "expectedBehavior": { "$ref": "#/$defs/rangeBehavior" },
        "expectedValue": { "type": ["string", "null"] }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "metric", "target", "conditions"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "metric": { "type": "string", "minLength": 1 },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "source", "reference", "evidenceStatus"],
          "properties": {
            "value": { "type": "string", "minLength": 1 },
            "source": { "enum": ["USER_INTENT", "USER_DECISION", "WORKSPACE_EVIDENCE"] },
            "reference": { "type": "string", "minLength": 1, "maxLength": 240 },
            "evidenceStatus": { "enum": ["EVIDENCE_BACKED", "UNVERIFIED"] }
          }
        },
        "conditions": { "type": "string", "minLength": 1 }
      }
    },
    "rangeBehavior": {
      "enum": ["REJECT", "SATURATE", "EXPLICIT_SENTINEL", "WRAP", "NOT_APPLICABLE"]
    },
    "inapplicabilityProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proofKind", "absentStructure", "evidence"],
      "properties": {
        "proofKind": { "const": "STRUCTURAL_ABSENCE" },
        "absentStructure": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "determinismProofObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["witnessId", "relation", "observables"],
      "properties": {
        "witnessId": { "type": "string", "pattern": "^WITNESS-[A-Z_]+$" },
        "relation": { "enum": ["OUTPUTS_EQUAL", "DEFINED_RESULT", "EXPLICIT_REJECTION"] },
        "observables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 120 }
        }
      }
    },
    "counterexampleWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dimension", "inputClass", "baseline", "variation"],
      "properties": {
        "id": { "type": "string", "pattern": "^WITNESS-[A-Z_]+$" },
