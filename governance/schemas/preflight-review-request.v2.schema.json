{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.preflight_review_request.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "normalizedDemandDigest", "decisionDigest", "producerId", "reviewerId", "reviewerConfigDigest", "producerExecutionId", "reviewExecutionId", "reviewRequestDigest", "promptDigest", "prompt"],
  "properties": {
    "schema": { "const": "aegis.preflight_review_request.v2" },
    "status": { "const": "PENDING_INDEPENDENT_REVIEW" },
    "normalizedDemandDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "decisionDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "producerId": { "type": "string", "minLength": 1 },
    "reviewerId": { "type": "string", "minLength": 1 },
    "reviewerConfigDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "producerExecutionId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewExecutionId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewRequestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "promptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "prompt": { "type": "string", "minLength": 1 }
  }
}
