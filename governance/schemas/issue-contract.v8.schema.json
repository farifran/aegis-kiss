{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.issue_contract.v8",
  "title": "Aegis Auditable Issue-Contract v8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "implementationAuthorized",
    "sourcePreflightDigest",
    "sourceSnapshotDigest",
    "policyDigest",
    "constitutionDigest",
    "intent",
    "observedPaths",
    "intentSignals",
    "policySignals",
    "specification",
    "humanResolutions",
    "approval"
  ],
  "$defs": {
    "humanResolution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["questionId", "question", "kind", "answerId", "label", "rationale", "sourceContractDigest", "method", "attestation"],
          "properties": {
            "questionId": { "type": "string", "minLength": 1 },
            "question": { "type": "string", "minLength": 1 },
            "kind": { "const": "ANSWER" },
            "answerId": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1 },
            "sourceContractDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "method": { "enum": ["INTERACTIVE_WIZARD", "DIRECT_COMMAND"] },
            "attestation": { "enum": ["DECISIONS_REVIEWED_AND_CONFIRMED", "CONTRACT_REVIEWED_AND_APPROVED"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["questionId", "question", "kind", "correction", "sourceContractDigest", "method", "attestation"],
          "properties": {
            "questionId": { "type": "string", "minLength": 1 },
            "question": { "type": "string", "minLength": 1 },
            "kind": { "const": "CORRECTION" },
            "correction": { "type": "string", "minLength": 1 },
            "sourceContractDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "method": { "enum": ["INTERACTIVE_WIZARD", "DIRECT_COMMAND"] },
            "attestation": { "enum": ["DECISIONS_REVIEWED_AND_CONFIRMED", "CONTRACT_REVIEWED_AND_APPROVED"] }
          }
        }
      ]
    }
  },
  "properties": {
    "schema": { "const": "aegis.issue_contract.v8" },
    "implementationAuthorized": { "const": false },
    "sourcePreflightDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceSnapshotDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "constitutionDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "intent": { "type": "string", "minLength": 1 },
    "observedPaths": {
      "type": "array",
      "items": { "type": "string", "pattern": "^src/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))[^\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069]+$" },
      "uniqueItems": true
    },
    "intentSignals": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "handling", "offset", "reference", "excerpt"],
        "properties": {
          "id": { "type": "string", "pattern": "^INPUT-[0-9]{4}$" },
          "kind": { "enum": ["INCOMPLETE_EXPRESSION", "QUALITY_CONSTRAINT", "BOUNDED_VALUE"] },
          "handling": { "enum": ["MATERIAL_DECISION", "MEASURABLE_REQUIREMENT", "BOUNDARY_RULE"] },
          "offset": { "type": "integer", "minimum": 0 },
          "reference": { "type": "string", "minLength": 1, "maxLength": 120 },
          "excerpt": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "policySignals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "kind", "reference", "requiresAdversarialReview"],
        "properties": {
          "ruleId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["REVIEW", "POSSIBLE_CONFLICT"] },
          "reference": { "type": "string", "minLength": 1 },
          "requiresAdversarialReview": { "type": "boolean" }
        }
      }
    },
    "specification": { "$ref": "aegis.semantic_draft.v4" },
    "humanResolutions": {
      "type": "array",
      "items": { "$ref": "#/$defs/humanResolution" }
    },
    "approval": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "attestation", "executionId", "contractDraftDigest"],
          "properties": {
            "method": { "enum": ["INTERACTIVE_WIZARD", "DIRECT_COMMAND"] },
            "attestation": { "const": "CONTRACT_REVIEWED_AND_APPROVED" },
            "executionId": { "type": "string", "pattern": "^draft-[a-f0-9]{16}$" },
            "contractDraftDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      ]
    }
  }
}
