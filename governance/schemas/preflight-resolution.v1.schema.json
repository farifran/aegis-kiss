{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.preflight_resolution.v1",
  "title": "Aegis Preflight Resolution v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decisionDigest", "preflightPromptDigest", "answers", "clarifiedDemand"],
  "properties": {
    "schema": { "const": "aegis.preflight_resolution.v1" },
    "decisionDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "preflightPromptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "answer"],
        "properties": {
          "questionId": { "type": "string", "pattern": "^Q-[A-Z0-9][A-Z0-9-]+$" },
          "answer": { "type": "string", "minLength": 1 }
        }
      }
    },
    "clarifiedDemand": { "$ref": "clarified-demand.v1.schema.json" }
  }
}
