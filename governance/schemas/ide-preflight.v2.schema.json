{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.ide_preflight.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "changeKind", "executionId", "baseCommit", "baseline", "normalizedDemand", "mechanicalFacts", "architecture", "previousContract", "previousContractDigest", "promptTemplateDigest", "semanticProtocolDigest", "contextDigest", "promptDigest", "prompt", "timing"],
  "properties": {
    "schema": { "const": "aegis.ide_preflight.v2" },
    "status": { "const": "PENDING_SEMANTIC_COMPILATION" },
    "changeKind": { "enum": ["PRODUCT", "HARNESS"] },
    "executionId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "worktreeDigest", "clean"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "worktreeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "clean": { "const": true }
      }
    },
    "normalizedDemand": { "$ref": "aegis.normalized_demand.v2" },
    "mechanicalFacts": { "$ref": "#/$defs/mechanicalFacts" },
    "architecture": { "$ref": "#/$defs/architecture" },
    "previousContract": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "aegis.contract_ir.v2" }
      ]
    },
    "previousContractDigest": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      ]
    },
    "promptTemplateDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "semanticProtocolDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contextDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "promptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "prompt": { "type": "string", "minLength": 1 },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "startedAtEpochMs", "durationMs"],
      "properties": {
        "phase": { "const": "preflight" },
        "startedAtEpochMs": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "number", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "status", "evidence"],
      "properties": {
        "kind": { "enum": ["target", "path", "symbol", "url"] },
        "value": { "type": "string" },
        "status": { "enum": ["PROVEN", "UNPROVEN", "DISPROVEN", "NOT_APPLICABLE"] },
        "evidence": { "type": "string", "minLength": 1 },
        "unitId": { "type": "string", "pattern": "^UNIT-[0-9]{4}$" },
        "range": { "$ref": "aegis.normalized_demand.v2#/$defs/range" }
      }
    },
    "mechanicalFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "digest", "target", "references", "discovery"],
      "properties": {
        "schema": { "const": "aegis.preflight_facts.v2" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "target": { "$ref": "#/$defs/fact" },
        "references": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "discovery": { "$ref": "#/$defs/discovery" }
      }
    },
    "discoveryCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exists", "reasons"],
      "properties": {
        "path": { "$ref": "aegis.preflight_decision.v2#/$defs/path" },
        "exists": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["explicit_target", "explicit_path", "previous_contract_scope", "path_term_match", "symbol_match"] }
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "demandDigest", "baseCommit", "candidates", "coverage", "limits", "digest"],
      "properties": {
        "schema": { "const": "aegis.discovery.v1" },
        "status": { "enum": ["CANDIDATES", "UNKNOWN", "INCOMPLETE", "NOT_APPLICABLE"] },
        "demandDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "baseCommit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "candidates": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/discoveryCandidate" } },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trackedPaths", "eligiblePaths", "consideredPaths", "symbolAnchors", "returnedCandidates"],
          "properties": {
            "trackedPaths": { "type": "integer", "minimum": 0 },
            "eligiblePaths": { "type": "integer", "minimum": 0 },
            "consideredPaths": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "symbolAnchors": { "type": "integer", "minimum": 0, "maximum": 8 },
            "returnedCandidates": { "type": "integer", "minimum": 0, "maximum": 12 }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxCandidates", "maxTrackedPaths", "maxSymbolAnchors", "maxLexicalTerms", "maxGitBytes", "gitTimeoutMs"],
          "properties": {
            "maxCandidates": { "const": 12 },
            "maxTrackedPaths": { "const": 10000 },
            "maxSymbolAnchors": { "const": 8 },
            "maxLexicalTerms": { "const": 64 },
            "maxGitBytes": { "const": 4194304 },
            "gitTimeoutMs": { "const": 3000 }
          }
        },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "architectureRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level", "statement", "appliesWhen", "appliesMode"],
      "properties": {
        "id": { "type": "string", "pattern": "^ARCH-[A-Z0-9][A-Z0-9-]+$" },
        "level": { "enum": ["hard", "default", "preference"] },
        "statement": { "type": "string", "minLength": 1 },
        "appliesWhen": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "appliesMode": { "enum": ["any", "all"] },
        "forbiddenReferences": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "policyDigest", "sourceStatus", "candidateRules"],
      "properties": {
        "schema": { "const": "aegis.preflight_architecture.v2" },
        "policyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceStatus": { "const": "CURRENT" },
        "candidateRules": { "type": "array", "items": { "$ref": "#/$defs/architectureRule" } }
      }
    }
  }
}
