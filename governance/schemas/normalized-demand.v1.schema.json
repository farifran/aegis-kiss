{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.normalized_demand.v1",
  "title": "Aegis Normalized Demand v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "normalizerVersion", "rawDigest", "normalizedDigest", "rawByteLength", "normalizedByteLength", "text", "transformations", "references"],
  "properties": {
    "schema": { "const": "aegis.normalized_demand.v1" },
    "normalizerVersion": { "type": "string", "minLength": 1 },
    "rawDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "normalizedDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rawByteLength": { "type": "integer", "minimum": 1 },
    "normalizedByteLength": { "type": "integer", "minimum": 1 },
    "text": { "type": "string" },
    "transformations": {
      "type": "array",
      "items": { "$ref": "#/$defs/transformation" }
    },
    "references": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startByte", "endByte"],
      "properties": {
        "startByte": { "type": "integer", "minimum": 0 },
        "endByte": { "type": "integer", "minimum": 0 }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "count"],
      "properties": {
        "kind": { "const": "CRLF_TO_LF" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "range"],
      "properties": {
        "kind": { "enum": ["path", "symbol", "url", "attachment"] },
        "value": { "type": "string", "minLength": 1 },
        "range": { "$ref": "#/$defs/range" }
      }
    }
  }
}
