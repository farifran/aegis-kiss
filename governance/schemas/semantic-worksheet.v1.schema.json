{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.semantic_worksheet.v1",
  "title": "Aegis Deterministic Semantic Worksheet v1",
  "description": "Ficha calculada pelo Harness antes da IA. Ela enumera revisões obrigatórias e campos que a IA não pode controlar.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contextDigest",
    "determinismActivations",
    "mechanicalProofObligations",
    "finiteRepresentations",
    "bitFields",
    "bitLayouts",
    "compilerOwnedFields"
  ],
  "properties": {
    "schema": {
      "const": "aegis.semantic_worksheet.v1"
    },
    "contextDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "determinismActivations": {
      "type": "array",
      "description": "Revisões de determinismo ativadas por fatos mecânicos. A dimensão pode repetir para sujeitos distintos.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dimension",
          "subject",
          "triggerOffset",
          "triggerReference",
          "triggerSignalIndexes",
          "counterexampleWitness"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^DET-ACT-[0-9]{4}$" },
          "dimension": { "$ref": "#/$defs/determinismDimension" },
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "key"],
            "properties": {
              "kind": { "enum": ["OPERATION", "BIT_FIELD"] },
              "key": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
            }
          },
          "triggerOffset": { "type": "integer", "minimum": 0 },
          "triggerReference": { "type": "string", "minLength": 1 },
          "triggerSignalIndexes": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "uniqueItems": true
          },
          "counterexampleWitness": { "$ref": "#/$defs/counterexampleWitness" }
        }
      }
    },
    "mechanicalProofObligations": {
      "type": "array",
      "description": "Provas mínimas exigidas diretamente por uma propriedade explícita da intenção ou da Constituição.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "triggerOffset", "triggerReference", "acceptanceCase"],
        "properties": {
          "id": { "type": "string", "pattern": "^MECH-PROOF-[0-9]{4}$" },
          "kind": { "const": "OBSERVATIONAL_PURITY" },
          "triggerOffset": { "type": "integer", "minimum": 0 },
          "triggerReference": { "type": "string", "minLength": 1 },
          "acceptanceCase": {
            "type": "object",
            "additionalProperties": false,
            "required": ["given", "when", "then", "outcomeKind"],
            "properties": {
              "given": { "type": "string", "minLength": 1 },
              "when": { "type": "string", "minLength": 1 },
              "then": { "type": "string", "minLength": 1 },
              "outcomeKind": { "const": "RETURN_VALUE" }
            }
          }
        }
      }
    },
    "finiteRepresentations": {
      "type": "array",
      "description": "Inventário de larguras finitas declaradas. Registra capacidade sem inferir signedness, saturação, wrap, truncamento ou rejeição.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "signalIndex",
          "form",
          "role",
          "startBit",
          "endBit",
          "width",
          "patternCount",
          "unsignedMaximum"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^REP-[0-9]{4}$" },
          "signalIndex": { "type": "integer", "minimum": 0 },
          "form": { "enum": ["DECLARED_WIDTH", "BIT_RANGE"] },
          "role": {
            "enum": ["BITMASK_LAYOUT", "BIT_FIELD", "PROJECTION_WIDTH", "HASH_WIDTH", "UNCLASSIFIED"]
          },
          "startBit": { "type": ["integer", "null"], "minimum": 0 },
          "endBit": { "type": ["integer", "null"], "minimum": 0 },
          "width": { "type": "integer", "minimum": 1 },
          "patternCount": { "type": "string", "minLength": 1 },
          "unsignedMaximum": { "type": "string", "minLength": 1 }
        }
      }
    },
    "bitFields": {
      "type": "array",
      "description": "Faixas de bits extraídas literalmente da demanda. signalIndex aponta para intentSignals.signals da solicitação.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signalIndex",
          "startBit",
          "endBit",
          "width",
          "patternCount",
          "unsignedMaximum",
          "semanticRole",
          "counterBoundary"
        ],
        "properties": {
          "signalIndex": {
            "type": "integer",
            "minimum": 0
          },
          "startBit": {
            "type": "integer",
            "minimum": 0
          },
          "endBit": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "patternCount": {
            "type": "string",
            "minLength": 1,
            "description": "Quantidade de padrões representáveis pela largura. Para larguras pequenas, contém o inteiro exato; para larguras extremas, a expressão 2^width."
          },
          "unsignedMaximum": {
            "type": "string",
            "minLength": 1,
            "description": "Maior valor sem sinal representável. Não escolhe signedness nem política de overflow."
          },
          "semanticRole": {
            "enum": ["OBSERVABILITY_COUNTER", "UNCLASSIFIED"],
            "description": "Classificação mecânica restrita ao rótulo explícito do campo; não define identidade de contagem."
          },
          "counterBoundary": {
            "description": "Default mecânico somente para contador observacional explícito sem política de borda fornecida pela demanda.",
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["authority", "resolutionKind", "resolutionParameter", "proofCases"],
                "properties": {
                  "authority": { "const": "ARCH-OBSERVABILITY-COUNTERS" },
                  "resolutionKind": { "const": "OVERFLOW_SATURATE" },
                  "resolutionParameter": { "type": "string", "pattern": "^SATURATE_MAX=.+$" },
                  "proofCases": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["input", "expected"],
                      "properties": {
                        "input": { "type": "string", "minLength": 1 },
                        "expected": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "bitLayouts": {
      "type": "array",
      "description": "Auditoria mecânica de layouts explicitamente declarados como bitmask ou máscara de N bits. COMPLETE exige cobertura exata de 0 a N-1, sem gaps, overlaps ou campos fora do intervalo.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "declaredWidthSignalIndex",
          "declaredWidth",
          "fieldSignalIndexes",
          "coveredWidth",
          "status",
          "gaps",
          "overlaps",
          "outOfRange"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^BIT-LAYOUT-[0-9]{4}$" },
          "declaredWidthSignalIndex": { "type": "integer", "minimum": 0 },
          "declaredWidth": { "type": "integer", "minimum": 1 },
          "fieldSignalIndexes": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "uniqueItems": true
          },
          "coveredWidth": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["COMPLETE", "INCOMPLETE"] },
          "gaps": { "$ref": "#/$defs/bitRanges" },
          "overlaps": { "$ref": "#/$defs/bitRanges" },
          "outOfRange": { "$ref": "#/$defs/bitRanges" }
        }
      }
    },
    "compilerOwnedFields": {
      "description": "Partes do contrato reservadas ao compilador determinístico e proibidas no parecer da IA.",
      "const": [
        "SCHEMA",
        "CONTEXT_BINDING",
        "IDENTIFIERS",
        "SOURCE_BINDINGS",
        "DETERMINISM_ACTIVATIONS",
        "MECHANICAL_PROOF_OBLIGATIONS",
        "FINITE_REPRESENTATIONS",
        "AGGREGATE_STATUSES",
        "CONTRACT_ENVELOPE",
        "DIGESTS",
        "APPROVAL_STATE"
      ]
    }
  },
  "$defs": {
    "determinismDimension": {
      "enum": [
        "ORDERING",
        "CANONICALIZATION",
        "DUPLICATES",
        "EMPTY_INPUT",
        "ODD_CARDINALITY",
        "ROUNDING",
        "REMAINDER_DISTRIBUTION",
        "ZERO_DIVISOR",
        "TIE_BREAKING",
        "COUNTING_IDENTITY",
        "BOUNDED_ARITHMETIC"
      ]
    },
    "counterexampleWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dimension", "inputClass", "baseline", "variation"],
      "properties": {
        "id": { "type": "string", "pattern": "^WITNESS-[A-Z0-9_-]+$" },
        "dimension": { "$ref": "#/$defs/determinismDimension" },
        "inputClass": {
          "enum": [
            "PERMUTED_EQUIVALENT_INPUTS",
            "EQUIVALENT_REPRESENTATIONS",
            "DUPLICATED_ELEMENT",
            "EMPTY_COLLECTION",
            "THREE_ELEMENTS",
            "NON_EXACT_DIVISION",
            "MULTIPLE_RECIPIENTS_WITH_REMAINDER",
            "ZERO_DENOMINATOR",
            "EQUAL_PRIORITY_CANDIDATES",
            "DUPLICATED_IDENTITY_OCCURRENCES",
            "OUTSIDE_REPRESENTABLE_RANGE"
          ]
        },
        "baseline": { "type": "string", "minLength": 1 },
        "variation": { "type": "string", "minLength": 1 }
      }
    },
    "bitRanges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startBit", "endBit"],
        "properties": {
          "startBit": { "type": "integer", "minimum": 0 },
          "endBit": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
