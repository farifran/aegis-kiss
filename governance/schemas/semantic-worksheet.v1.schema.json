{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.semantic_worksheet.v1",
  "title": "Aegis Deterministic Semantic Worksheet v1",
  "description": "Ficha calculada pelo Harness antes da IA. Ela enumera revisões obrigatórias e campos que a IA não pode controlar.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contextDigest",
    "requiredDeterminismDimensions",
    "counterexampleWitnesses",
    "bitFields",
    "bitLayouts",
    "compilerOwnedFields"
  ],
  "properties": {
    "schema": {
      "const": "aegis.semantic_worksheet.v1"
    },
    "contextDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requiredDeterminismDimensions": {
      "type": "array",
      "description": "Ordem canônica das dimensões que o parecer deve responder, uma vez cada e na mesma posição.",
      "items": {
        "enum": [
          "ORDERING",
          "CANONICALIZATION",
          "DUPLICATES",
          "EMPTY_INPUT",
          "ODD_CARDINALITY",
          "ROUNDING",
          "REMAINDER_DISTRIBUTION",
          "ZERO_DIVISOR",
          "TIE_BREAKING",
          "COUNTING_IDENTITY",
          "BOUNDED_ARITHMETIC"
        ]
      },
      "uniqueItems": true
    },
    "counterexampleWitnesses": {
      "type": "array",
      "description": "Pares mínimos opcionais fornecidos pelo compilador. O Harness anexa o witness canônico apenas às dimensões materiais reportadas pela IA.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimension", "inputClass", "baseline", "variation"],
        "properties": {
          "id": { "type": "string", "pattern": "^WITNESS-[A-Z_]+$" },
          "dimension": {
            "enum": [
              "ORDERING",
              "CANONICALIZATION",
              "DUPLICATES",
              "EMPTY_INPUT",
              "ODD_CARDINALITY",
              "ROUNDING",
              "REMAINDER_DISTRIBUTION",
              "ZERO_DIVISOR",
              "TIE_BREAKING",
              "COUNTING_IDENTITY",
              "BOUNDED_ARITHMETIC"
            ]
          },
          "inputClass": {
            "enum": [
              "PERMUTED_EQUIVALENT_INPUTS",
              "EQUIVALENT_REPRESENTATIONS",
              "DUPLICATED_ELEMENT",
              "EMPTY_COLLECTION",
              "THREE_ELEMENTS",
              "NON_EXACT_DIVISION",
              "MULTIPLE_RECIPIENTS_WITH_REMAINDER",
              "ZERO_DENOMINATOR",
              "EQUAL_PRIORITY_CANDIDATES",
              "DUPLICATED_IDENTITY_OCCURRENCES",
              "OUTSIDE_REPRESENTABLE_RANGE"
            ]
          },
          "baseline": { "type": "string", "minLength": 1 },
          "variation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "bitFields": {
      "type": "array",
      "description": "Faixas de bits extraídas literalmente da demanda. signalIndex aponta para intentSignals.signals da solicitação.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signalIndex",
          "startBit",
          "endBit",
          "width",
          "patternCount",
          "unsignedMaximum",
          "semanticRole",
          "counterBoundary"
        ],
        "properties": {
          "signalIndex": {
            "type": "integer",
            "minimum": 0
          },
          "startBit": {
            "type": "integer",
            "minimum": 0
          },
          "endBit": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "patternCount": {
            "type": "string",
            "minLength": 1,
            "description": "Quantidade de padrões representáveis pela largura. Para larguras pequenas, contém o inteiro exato; para larguras extremas, a expressão 2^width."
          },
          "unsignedMaximum": {
            "type": "string",
            "minLength": 1,
            "description": "Maior valor sem sinal representável. Não escolhe signedness nem política de overflow."
          },
          "semanticRole": {
            "enum": ["OBSERVABILITY_COUNTER", "UNCLASSIFIED"],
            "description": "Classificação mecânica restrita ao rótulo explícito do campo; não define identidade de contagem."
          },
          "counterBoundary": {
            "description": "Default mecânico somente para contador observacional explícito sem política de borda fornecida pela demanda.",
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["authority", "resolutionKind", "resolutionParameter", "proofCases"],
                "properties": {
                  "authority": { "const": "ARCH-OBSERVABILITY-COUNTERS" },
                  "resolutionKind": { "const": "OVERFLOW_SATURATE" },
                  "resolutionParameter": { "type": "string", "pattern": "^SATURATE_MAX=.+$" },
                  "proofCases": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["input", "expected"],
                      "properties": {
                        "input": { "type": "string", "minLength": 1 },
                        "expected": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "bitLayouts": {
      "type": "array",
      "description": "Auditoria mecânica de layouts explicitamente declarados como bitmask ou máscara de N bits. COMPLETE exige cobertura exata de 0 a N-1, sem gaps, overlaps ou campos fora do intervalo.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "declaredWidthSignalIndex",
          "declaredWidth",
          "fieldSignalIndexes",
          "coveredWidth",
          "status",
          "gaps",
          "overlaps",
          "outOfRange"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^BIT-LAYOUT-[0-9]{4}$" },
          "declaredWidthSignalIndex": { "type": "integer", "minimum": 0 },
          "declaredWidth": { "type": "integer", "minimum": 1 },
          "fieldSignalIndexes": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 },
            "uniqueItems": true
          },
          "coveredWidth": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["COMPLETE", "INCOMPLETE"] },
          "gaps": { "$ref": "#/$defs/bitRanges" },
          "overlaps": { "$ref": "#/$defs/bitRanges" },
          "outOfRange": { "$ref": "#/$defs/bitRanges" }
        }
      }
    },
    "compilerOwnedFields": {
      "description": "Partes do contrato reservadas ao compilador determinístico e proibidas no parecer da IA.",
      "const": [
        "SCHEMA",
        "CONTEXT_BINDING",
        "IDENTIFIERS",
        "SOURCE_BINDINGS",
        "COUNTEREXAMPLE_WITNESSES",
        "AGGREGATE_STATUSES",
        "CONTRACT_ENVELOPE",
        "DIGESTS",
        "APPROVAL_STATE"
      ]
    }
  },
  "$defs": {
    "bitRanges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startBit", "endBit"],
        "properties": {
          "startBit": { "type": "integer", "minimum": 0 },
          "endBit": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
