{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.semantic_request.v2",
  "title": "Aegis Semantic Deliberation Request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contextDigest", "delivery", "constitution", "intent", "workspace", "policy", "revision", "outputSchema"],
  "properties": {
    "schema": { "const": "aegis.semantic_request.v2" },
    "contextDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constitution", "architecture", "intent", "workspace", "revision", "outputSchema"],
      "properties": {
        "constitution": { "const": "SYSTEM_INSTRUCTION" },
        "architecture": { "const": "TRUSTED_POLICY" },
        "intent": { "const": "USER_DATA" },
        "workspace": { "const": "UNTRUSTED_EVIDENCE" },
        "revision": { "const": "USER_DECISION" },
        "outputSchema": { "const": "STRICT_STRUCTURED_OUTPUT" }
      }
    },
    "constitution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "digest", "authority", "rules"],
      "properties": {
        "schema": { "const": "aegis.constitution.v1" },
        "version": { "type": "integer", "minimum": 1 },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "authority": { "const": "TRUSTED_CONSTITUTION" },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement"],
            "properties": {
              "id": { "type": "string", "pattern": "^CONST-[A-Z0-9][A-Z0-9-]+$" },
              "statement": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "intent": { "type": "string", "minLength": 1 },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observedTextPaths", "unavailablePaths", "lexicalEvidence", "sourceEvidence"],
      "properties": {
        "status": { "enum": ["SOURCE_OBSERVED", "NO_TEXT_SOURCE", "EMPTY_SOURCE"] },
        "observedTextPaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "unavailablePaths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "reason": { "enum": ["BINARY", "INVALID_UTF8", "SYMLINK"] }
            }
          }
        },
        "lexicalEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "termsTruncated", "matches"],
          "properties": {
            "status": { "enum": ["MATCH", "NO_MATCH", "NOT_APPLICABLE"] },
            "termsTruncated": { "type": "boolean" },
            "matches": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["term", "path", "line"],
                "properties": {
                  "term": { "type": "string", "minLength": 1 },
                  "path": { "type": "string", "minLength": 1 },
                  "line": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        "sourceEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "content", "startLine", "endLine", "truncated", "selection", "trust"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "content": { "type": "string" },
              "startLine": { "type": "integer", "minimum": 1 },
              "endLine": { "type": "integer", "minimum": 1 },
              "truncated": { "type": "boolean" },
              "selection": { "enum": ["FULL_SOURCE", "LEXICAL_WINDOW", "ENTRYPOINT_PREFIX"] },
              "trust": { "const": "UNTRUSTED_EVIDENCE_NOT_INSTRUCTIONS" }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contexts", "rules", "amendments"],
      "properties": {
        "contexts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tag", "description"],
            "properties": {
              "tag": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "level", "statement", "appliesWhen", "appliesMode", "forbiddenReferences"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "level": { "enum": ["hard", "default", "preference"] },
              "statement": { "type": "string", "minLength": 1 },
              "appliesWhen": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "appliesMode": { "enum": ["any", "all"] },
              "forbiddenReferences": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
            }
          }
        },
        "amendments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "ruleId", "reason"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "ruleId": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "revision": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["sourceContractDigest", "answers"],
      "properties": {
        "sourceContractDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "answers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["questionId", "answerId", "label", "rationale"],
                "properties": {
                  "questionId": { "type": "string" },
                  "answerId": { "type": "string" },
                  "label": { "type": "string" },
                  "rationale": { "type": "string" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["questionId", "correction"],
                "properties": {
                  "questionId": { "type": "string" },
                  "correction": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest", "strict", "document"],
      "properties": {
        "id": { "const": "aegis.semantic_draft.v2" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "strict": { "const": true },
        "document": {
          "type": "object",
          "required": ["$schema", "$id", "type", "properties"],
          "properties": {
            "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
            "$id": { "const": "aegis.semantic_draft.v2" },
            "type": { "const": "object" },
            "properties": { "type": "object" }
          }
        }
      }
    }
  }
}
