{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.clarified_demand.v1",
  "title": "Aegis Clarified Demand v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "normalizedDemandDigest", "intent", "requirements", "scope"],
  "properties": {
    "schema": { "const": "aegis.clarified_demand.v1" },
    "normalizedDemandDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "intent": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "excluded": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "failureSemantics": {
      "type": "array",
      "items": { "$ref": "#/$defs/failureSemantic" }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "provenance"],
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9-]+$" },
        "statement": { "type": "string", "minLength": 1 },
        "provenance": { "enum": ["USER", "SAFE_CORRECTION", "USER_CLARIFICATION", "ARCHITECTURE_DEFAULT", "KISS_DERIVATION"] },
        "sourceRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startByte", "endByte"],
          "properties": {
            "startByte": { "type": "integer", "minimum": 0 },
            "endByte": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "failureSemantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trigger", "observableOutcome"],
      "properties": {
        "id": { "type": "string", "pattern": "^FAIL-[A-Z0-9][A-Z0-9-]+$" },
        "trigger": { "type": "string", "minLength": 1 },
        "observableOutcome": { "type": "string", "minLength": 1 }
      }
    }
  }
}
