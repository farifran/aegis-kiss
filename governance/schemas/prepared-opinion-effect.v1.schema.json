{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.prepared_opinion_effect.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "requirements": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "value"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "value": {
                "$ref": "aegis.semantic_opinion.v3#/properties/requirements/items"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "patch"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "patch": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "acceptanceCases": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "index"
                      ],
                      "properties": {
                        "index": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "given": {
                          "type": "string"
                        },
                        "when": {
                          "type": "string"
                        },
                        "then": {
                          "type": "string",
                          "minLength": 1
                        },
                        "outcomeKind": {
                          "enum": [
                            "RETURN_VALUE",
                            "REJECTION"
                          ]
                        },
                        "decisionBinding": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "additionalProperties": false,
                          "required": [
                            "decisionIndex",
                            "answerIndex"
                          ],
                          "properties": {
                            "decisionIndex": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "answerIndex": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "invariants": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "value"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "value": {
                "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_invariants_items"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "patch"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "patch": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "falsification": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        ]
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "value"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "value": {
                "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_risks_items"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "patch"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "patch": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "statement": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mitigation": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        ]
      }
    },
    "boundaryRules": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "value"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "value": {
                "$ref": "aegis.semantic_opinion.v3#/properties/boundaryRules/items"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "patch"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "patch": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "rule": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        ]
      }
    },
    "dimensions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "value"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "value": {
                "$ref": "aegis.contract_components.v1#/$defs/semantic_opinion_determinismReview_properties_dimensions_items"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "patch"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "patch": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "SPECIFIED",
                      "DECISION_REQUIRED",
                      "GAP_FOUND"
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "acceptanceCase": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                      "requirementIndex",
                      "caseIndex"
                    ],
                    "properties": {
                      "requirementIndex": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "caseIndex": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "proofObligation": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "additionalProperties": false,
                    "required": [
                      "relation",
                      "baselineOutcome",
                      "variationOutcome",
                      "resolutionParameter"
                    ],
                    "properties": {
                      "relation": {
                        "enum": [
                          "OUTPUTS_EQUAL",
                          "DEFINED_RESULT",
                          "EXPLICIT_REJECTION",
                          "BOUNDED_DIFF"
                        ]
                      },
                      "baselineOutcome": {
                        "type": "string",
                        "minLength": 1
                      },
                      "variationOutcome": {
                        "type": "string",
                        "minLength": 1
                      },
                      "resolutionKind": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "resolutionParameter": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "observables": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
