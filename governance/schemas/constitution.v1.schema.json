{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.constitution.v1",
  "title": "Aegis Cognitive Constitution v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","constitutionVersion","origin"],
  "properties": {
    "schema": {"const":"aegis.constitution.v1"},
    "constitutionVersion": {"type":"integer","minimum":1},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath","sourceDigest"],
      "properties": {"sourcePath":{"const":"AGENTS.md"},"sourceDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
    }
  }
}
