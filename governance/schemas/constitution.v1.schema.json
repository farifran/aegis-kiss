{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.constitution.v1",
  "title": "Aegis Cognitive Constitution v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "constitutionVersion", "origin", "rules"],
  "properties": {
    "schema": { "const": "aegis.constitution.v1" },
    "constitutionVersion": { "type": "integer", "minimum": 1 },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "sourceDigest"],
      "properties": {
        "sourcePath": { "const": "AGENTS.md" },
        "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^CONST-[A-Z0-9][A-Z0-9-]+$" },
          "statement": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
