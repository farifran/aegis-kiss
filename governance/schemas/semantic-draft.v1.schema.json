{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.semantic_draft.v1",
  "title": "Aegis Semantic Contract Draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceContextDigest",
    "title",
    "interpretation",
    "changeKind",
    "scope",
    "architectureContexts",
    "policyAssessments",
    "complexityReview",
    "requirements",
    "invariants",
    "riskReview",
    "risks",
    "unknowns",
    "decisions"
  ],
  "properties": {
    "schema": { "const": "aegis.semantic_draft.v1" },
    "sourceContextDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "title": { "type": "string", "minLength": 1 },
    "interpretation": { "type": "string", "minLength": 1 },
    "changeKind": { "enum": ["PRODUCT", "HARNESS"] },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inScope", "outOfScope"],
      "properties": {
        "inScope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "outOfScope": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "architectureContexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "rationale"],
        "properties": {
          "tag": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "policyAssessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "demandStatus", "recommendedStatus", "rationale", "decisionId", "amendmentId"],
        "properties": {
          "ruleId": { "type": "string", "pattern": "^ARCH-[A-Z0-9][A-Z0-9-]+$" },
          "demandStatus": { "enum": ["COMPLIANT", "NOT_APPLICABLE", "CONFLICT"] },
          "recommendedStatus": { "enum": ["COMPLIANT", "NOT_APPLICABLE", "AMENDED"] },
          "rationale": { "type": "string", "minLength": 1 },
          "decisionId": { "type": ["string", "null"], "pattern": "^Q-[A-Z0-9][A-Z0-9-]+$" },
          "amendmentId": {
            "type": ["string", "null"],
            "pattern": "^ARCH-AMEND-[A-Z0-9][A-Z0-9-]+$"
          }
        }
      }
    },
    "complexityReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "alternatives"],
      "properties": {
        "status": { "enum": ["NO_EXCESS", "SIMPLIFIED", "JUSTIFIED"] },
        "rationale": { "type": "string", "minLength": 1 },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requested", "simpler", "rationale"],
            "properties": {
              "requested": { "type": "string", "minLength": 1 },
              "simpler": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "provenance", "acceptanceCases"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9-]+$" },
          "statement": { "type": "string", "minLength": 1 },
          "provenance": { "enum": ["USER", "USER_CLARIFICATION", "ARCHITECTURE_POLICY", "KISS_DERIVATION"] },
          "acceptanceCases": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "given", "when", "then"],
              "properties": {
                "id": { "type": "string", "pattern": "^AC-[A-Z0-9][A-Z0-9-]+$" },
                "kind": { "enum": ["HAPPY_PATH", "FAILURE", "BOUNDARY"] },
                "given": { "type": "string", "minLength": 1 },
                "when": { "type": "string", "minLength": 1 },
                "then": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "falsification", "requirementIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^INV-[A-Z0-9][A-Z0-9-]+$" },
          "statement": { "type": "string", "minLength": 1 },
          "falsification": { "type": "string", "minLength": 1 },
          "requirementIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "level", "statement", "mitigation", "requirementIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^RISK-[A-Z0-9][A-Z0-9-]+$" },
          "kind": { "enum": ["SECURITY", "RELIABILITY", "PRIVACY", "PERFORMANCE", "INTEGRITY", "COMPLEXITY"] },
          "level": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "statement": { "type": "string", "minLength": 1 },
          "mitigation": { "type": "string", "minLength": 1 },
          "requirementIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "riskReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale", "consideredKinds"],
      "properties": {
        "status": { "enum": ["FOUND", "NONE", "UNKNOWN"] },
        "rationale": { "type": "string", "minLength": 1 },
        "consideredKinds": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["SECURITY", "RELIABILITY", "PRIVACY", "PERFORMANCE", "INTEGRITY", "COMPLEXITY"] }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "material", "decisionId"],
        "properties": {
          "id": { "type": "string", "pattern": "^UNKNOWN-[A-Z0-9][A-Z0-9-]+$" },
          "statement": { "type": "string", "minLength": 1 },
          "material": { "type": "boolean" },
          "decisionId": { "type": ["string", "null"] }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["questionId", "question", "recommendedAnswerId", "requirementIds", "invariantIds", "riskIds", "answers"],
        "properties": {
          "questionId": { "type": "string", "pattern": "^Q-[A-Z0-9][A-Z0-9-]+$" },
          "question": { "type": "string", "minLength": 1 },
          "recommendedAnswerId": { "type": "string", "minLength": 1 },
          "requirementIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "invariantIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "riskIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "answers": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "rationale", "recommended"],
              "properties": {
                "id": { "type": "string", "pattern": "^ANS-[A-Z0-9][A-Z0-9-]+$" },
                "label": { "type": "string", "minLength": 1 },
                "rationale": { "type": "string", "minLength": 1 },
                "recommended": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
