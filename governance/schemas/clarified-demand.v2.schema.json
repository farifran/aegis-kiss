{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.clarified_demand.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "changeKind", "normalizedDemandDigest", "intent", "requirements", "scope", "inputCoverage", "architecture"],
  "properties": {
    "schema": { "const": "aegis.clarified_demand.v2" },
    "changeKind": { "enum": ["PRODUCT", "HARNESS"] },
    "normalizedDemandDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "intent": { "type": "string", "minLength": 1 },
    "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requirement" } },
    "scope": { "$ref": "#/$defs/scope" },
    "inputCoverage": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inputCoverage" } },
    "architecture": { "$ref": "#/$defs/architectureBinding" },
    "acceptanceCriteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "failureSemantics": { "type": "array", "items": { "$ref": "#/$defs/failureSemantic" } }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "provenance"],
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9-]+$" },
        "statement": { "type": "string", "minLength": 1 },
        "provenance": { "enum": ["USER", "SAFE_CORRECTION", "USER_CLARIFICATION", "ARCHITECTURE_DEFAULT", "KISS_DERIVATION"] }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "excluded": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "inputCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unitId", "disposition", "requirementIds", "rationale"],
      "properties": {
        "unitId": { "type": "string", "pattern": "^UNIT-[0-9]{4}$" },
        "disposition": { "enum": ["REQUIREMENT", "CONTEXT", "REJECTED_INVALID"] },
        "requirementIds": { "type": "array", "items": { "type": "string", "pattern": "^REQ-[A-Z0-9][A-Z0-9-]+$" }, "uniqueItems": true },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "ruleAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "verdict", "evidence", "sourceUnitIds"],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^ARCH-[A-Z0-9][A-Z0-9-]+$" },
        "verdict": { "enum": ["APPLIED", "NOT_APPLICABLE", "CONFLICT"] },
        "evidence": { "type": "string", "minLength": 1 },
        "sourceUnitIds": { "type": "array", "items": { "type": "string", "pattern": "^UNIT-[0-9]{4}$" }, "uniqueItems": true }
      }
    },
    "architectureBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyDigest", "ruleAssessments"],
      "properties": {
        "policyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "ruleAssessments": { "type": "array", "items": { "$ref": "#/$defs/ruleAssessment" } }
      }
    },
    "failureSemantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trigger", "observableOutcome"],
      "properties": {
        "id": { "type": "string", "pattern": "^FAIL-[A-Z0-9][A-Z0-9-]+$" },
        "trigger": { "type": "string", "minLength": 1 },
        "observableOutcome": { "type": "string", "minLength": 1 }
      }
    }
  }
}
