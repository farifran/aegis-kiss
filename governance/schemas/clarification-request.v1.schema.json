{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.clarification_request.v1",
  "title": "Aegis Open Human Clarification Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "executionId",
    "contractDraftDigest",
    "title",
    "questionCount",
    "questions",
    "artifactPath",
    "responseInstructions"
  ],
  "properties": {
    "schema": {
      "const": "aegis.clarification_request.v1"
    },
    "mode": {
      "enum": [
        "OPEN_CLARIFICATION",
        "EARLY_CLARIFICATION"
      ]
    },
    "earlyStop": {
      "type": "boolean"
    },
    "status": {
      "const": "USER_CLARIFICATION_REQUIRED"
    },
    "executionId": {
      "type": "string",
      "pattern": "^draft-[a-f0-9]{16}$"
    },
    "contractDraftDigest": {
      "$ref": "aegis.contract_components.v1#/$defs/sha256_digest"
    },
    "sourceRequestDigest": {
      "$ref": "aegis.contract_components.v1#/$defs/sha256_digest"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "questionCount": {
      "type": "integer",
      "minimum": 1
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "materialEffect",
          "sourceFragmentIds",
          "sourceFragments"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "materialEffect": {
            "type": "string",
            "minLength": 1
          },
          "sourceFragmentIds": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_04"
          },
          "sourcePaths": {
            "$ref": "aegis.contract_components.v1#/$defs/shared_component_04"
          },
          "options": {
            "$ref": "aegis.contract_components.v1#/$defs/clarification_question_option"
          },
          "sourceFragments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "artifactPath": {
      "enum": [
        ".harness/runtime/contract.md",
        ".harness/runtime/semantic-request.json"
      ]
    },
    "responseInstructions": {
      "type": "string",
      "minLength": 1
    }
  }
}
