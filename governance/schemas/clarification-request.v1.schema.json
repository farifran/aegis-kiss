{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.clarification_request.v1",
  "title": "Aegis Open Human Clarification Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "executionId",
    "contractDraftDigest",
    "title",
    "questionCount",
    "questions",
    "artifactPath",
    "responseInstructions"
  ],
  "properties": {
    "schema": { "const": "aegis.clarification_request.v1" },
    "status": { "const": "USER_CLARIFICATION_REQUIRED" },
    "executionId": { "type": "string", "pattern": "^draft-[a-f0-9]{16}$" },
    "contractDraftDigest": { "$ref": "aegis.contract_components.v1#/$defs/sha256_digest" },
    "title": { "type": "string", "minLength": 1 },
    "questionCount": { "type": "integer", "minimum": 1 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "sourceFragmentIds", "sourceFragments"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "sourceFragmentIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "sourceFragments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "text": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "artifactPath": { "const": ".harness/runtime/contract.md" },
    "responseInstructions": { "type": "string", "minLength": 1 }
  }
}
