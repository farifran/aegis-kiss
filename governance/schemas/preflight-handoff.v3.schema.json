{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.preflight_handoff.v3",
  "title": "Aegis Phase 1-3 Preflight Handoff v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase",
    "status",
    "intent",
    "capture",
    "discovery",
    "preflightDigest"
  ],
  "properties": {
    "schema": {
      "const": "aegis.preflight_handoff.v3"
    },
    "phase": {
      "const": "DISCOVERED"
    },
    "status": {
      "const": "SEMANTIC_DELIBERATION_REQUIRED"
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "preflightDigest": {
      "$ref": "aegis.contract_components.v1#/$defs/sha256_digest"
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "transport",
        "unicodeNormalization",
        "lineEndings",
        "byteLength"
      ],
      "properties": {
        "provenance": {
          "const": "USER"
        },
        "transport": {
          "const": "ARGV_STRING"
        },
        "unicodeNormalization": {
          "const": "NFC"
        },
        "lineEndings": {
          "const": "LF"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRoot",
        "status",
        "files",
        "ignoredEntries",
        "visitedEntries",
        "scannedBytes",
        "sourceSnapshotDigest",
        "workspaceSkeleton"
      ],
      "properties": {
        "sourceRoot": {
          "const": "src"
        },
        "status": {
          "enum": [
            "EMPTY_SOURCE",
            "NO_TEXT_SOURCE",
            "SOURCE_OBSERVED"
          ]
        },
        "files": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "bytes",
              "digest",
              "kind"
            ],
            "properties": {
              "path": {
                "$ref": "aegis.contract_components.v1#/$defs/src_path"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8388608
              },
              "digest": {
                "$ref": "aegis.contract_components.v1#/$defs/sha256_digest"
              },
              "kind": {
                "enum": [
                  "UTF8_TEXT",
                  "BINARY",
                  "INVALID_UTF8"
                ]
              }
            }
          },
          "uniqueItems": true
        },
        "ignoredEntries": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "$ref": "aegis.contract_components.v1#/$defs/src_path"
              },
              "reason": {
                "const": "SYMLINK"
              }
            }
          },
          "uniqueItems": true
        },
        "visitedEntries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "scannedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "sourceSnapshotDigest": {
          "$ref": "aegis.contract_components.v1#/$defs/sha256_digest"
        },
        "workspaceSkeleton": {
          "$ref": "aegis.contract_components.v1#/$defs/workspace_skeleton"
        }
      }
    }
  }
}
