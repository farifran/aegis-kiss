{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis.architecture_projection.v1",
  "title": "Aegis Architecture Projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policyDigest", "sourceStatus", "tags", "rules"],
  "properties": {
    "schema": { "const": "aegis.architecture_projection.v1" },
    "policyDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceStatus": { "enum": ["CURRENT", "STALE"] },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "architecture-policy.v1.schema.json#/$defs/rule" }
    }
  }
}
