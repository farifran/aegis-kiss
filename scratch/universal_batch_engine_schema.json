{
  "contractVersion": "2.1",
  "goal": "Implementar o motor universal de lotes em src/clearingHouse.ts integrado ao src/tokenBucket.ts com execução sobre estado projetado sequencial, 2PC atômico com rollback total, digest de execução com identidade estrita e 9 provas do Red Team, com re-exportação nominal em src/index.ts.",
  "targets": [
    "src/tokenBucket.ts",
    "src/clearingHouse.ts",
    "src/index.ts"
  ],
  "imports": [],
  "types": [
    {
      "name": "TransferOrder",
      "shape": "{ readonly id: string; readonly senderId: string; readonly receiverId: string; readonly amount: bigint; readonly fee: bigint; readonly capacityCost?: bigint; }"
    },
    {
      "name": "OperationStatus",
      "shape": "'accepted' | 'rejected_invalid' | 'blocked_capacity' | 'blocked_insolvent'"
    },
    {
      "name": "OperationDecision",
      "shape": "{ readonly id: string; readonly status: OperationStatus; readonly reason?: string; }"
    },
    {
      "name": "BatchResult",
      "shape": "{ readonly acceptedCount: number; readonly rejectedCount: number; readonly blockedCount: number; readonly settledVolume: bigint; readonly totalFees: bigint; readonly rolledBack: boolean; readonly executionDigest: bigint; readonly decisions: readonly OperationDecision[]; }"
    },
    {
      "name": "AccountState",
      "shape": "{ readonly accountId: string; readonly balance: bigint; readonly capacity: bigint; readonly availableCapacity: bigint; }"
    },
    {
      "name": "EngineSnapshot",
      "shape": "{ readonly balances: Record<string, bigint>; readonly bucketStates: Record<string, { readonly tokens: bigint; readonly lastUpdateMs: bigint }>; readonly treasuryBalance: bigint; readonly totalSettledVolume: bigint; readonly totalRetainedFees: bigint; }"
    }
  ],
  "exports": [
    {
      "kind": "class",
      "name": "TokenBucket",
      "privateFields": [
        { "name": "_capacity", "type": "bigint", "readonly": true },
        { "name": "_refillPerMs", "type": "bigint", "readonly": true },
        { "name": "_tokens", "type": "bigint" },
        { "name": "_lastUpdateMs", "type": "bigint" }
      ],
      "ctorParams": [
        { "name": "capacity", "type": "bigint" },
        { "name": "refillPerMs", "type": "bigint" },
        { "name": "initialTokens?", "type": "bigint" },
        { "name": "initialTimeMs", "type": "bigint", "default": "0n" }
      ],
      "ctorBody": [],
      "methods": [
        { "name": "update", "params": [{ "name": "nowMs", "type": "bigint" }], "returns": "void", "body": [] },
        { "name": "peekTokens", "params": [{ "name": "nowMs", "type": "bigint" }], "returns": "bigint", "body": [] },
        { "name": "consume", "params": [{ "name": "amount", "type": "bigint" }, { "name": "nowMs", "type": "bigint" }], "returns": "boolean", "body": [] },
        { "name": "snapshot", "params": [], "returns": "{ readonly tokens: bigint; readonly lastUpdateMs: bigint }", "body": [] },
        { "name": "restore", "params": [{ "name": "snap", "type": "{ readonly tokens: bigint; readonly lastUpdateMs: bigint }" }], "returns": "void", "body": [] }
      ],
      "getters": [
        { "name": "capacity", "returns": "bigint", "body": "return this._capacity;" },
        { "name": "refillPerMs", "returns": "bigint", "body": "return this._refillPerMs;" },
        { "name": "tokens", "returns": "bigint", "body": "return this._tokens;" },
        { "name": "lastUpdateMs", "returns": "bigint", "body": "return this._lastUpdateMs;" }
      ],
      "body": []
    },
    {
      "kind": "class",
      "name": "ClearingHouse",
      "privateFields": [
        { "name": "_accounts", "type": "Record<string, any>", "readonly": true },
        { "name": "_treasuryBalance", "type": "bigint" },
        { "name": "_totalSettledVolume", "type": "bigint" },
        { "name": "_totalRetainedFees", "type": "bigint" }
      ],
      "ctorParams": [],
      "ctorBody": [],
      "methods": [
        {
          "name": "registerAccount",
          "params": [
            { "name": "accountId", "type": "string" },
            { "name": "initialBalance", "type": "bigint" },
            { "name": "capacity", "type": "bigint" },
            { "name": "refillPerMs", "type": "bigint" }
          ],
          "returns": "void",
          "body": []
        },
        {
          "name": "getAccount",
          "params": [
            { "name": "accountId", "type": "string" },
            { "name": "nowMs", "type": "bigint", "default": "0n" }
          ],
          "returns": "AccountState | null",
          "body": []
        },
        {
          "name": "snapshot",
          "params": [],
          "returns": "EngineSnapshot",
          "body": []
        },
        {
          "name": "processBatch",
          "params": [
            { "name": "orders", "type": "readonly TransferOrder[]" },
            { "name": "nowMs", "type": "bigint" }
          ],
          "returns": "BatchResult",
          "body": []
        }
      ],
      "getters": [
        { "name": "treasuryBalance", "returns": "bigint", "body": "return this._treasuryBalance;" },
        { "name": "totalSettledVolume", "returns": "bigint", "body": "return this._totalSettledVolume;" },
        { "name": "totalRetainedFees", "returns": "bigint", "body": "return this._totalRetainedFees;" },
        { "name": "accountCount", "returns": "number", "body": "return Object.keys(this._accounts).length;" }
      ],
      "body": []
    }
  ],
  "proofObligations": [
    {
      "id": "PO-TYPE-001",
      "kind": "type_safety",
      "required": true,
      "oracle": "typecheck"
    },
    {
      "id": "PO-FAIL-001",
      "kind": "failure_state",
      "required": true,
      "oracle": "state_diff",
      "observableState": ["_accounts", "_treasuryBalance"],
      "allowedFailureEffects": [],
      "prelude": [
        "const house = new ClearingHouse();",
        "house.registerAccount('user_a', 10n, 1000n, 10n);",
        "house.registerAccount('user_b', 10n, 1000n, 10n);",
        "__targetInstance = house;",
        "__failingCall = () => house.processBatch([{ id: '1', senderId: 'user_a', receiverId: 'user_b', amount: 500n, fee: 10n }], 100n);"
      ]
    },
    {
      "id": "PO-CONS-001",
      "kind": "resource_conservation",
      "required": true,
      "oracle": "conservation",
      "prelude": [
        "const house = new ClearingHouse();",
        "house.registerAccount('u1', 100n, 1000n, 10n);",
        "house.registerAccount('u2', 50n, 1000n, 10n);",
        "const initialBal = 150n;",
        "const initialTreasury = house.treasuryBalance;",
        "house.processBatch([{ id: 'tx1', senderId: 'u1', receiverId: 'u2', amount: 20n, fee: 5n }], 100n);",
        "const finalBal = 145n;",
        "const finalTreasury = house.treasuryBalance;",
        "__targetBefore = { balance: initialBal, treasuryBalance: initialTreasury };",
        "__targetAfter = { balance: finalBal, treasuryBalance: finalTreasury };"
      ]
    },
    {
      "id": "PO-COMP-001",
      "kind": "resource_composition",
      "required": true,
      "oracle": "aggregate_reservation",
      "prelude": [
        "const hComp = new ClearingHouse();",
        "hComp.registerAccount('comp_sender', 1000n, 100n, 0n); // 100 tokens capacidade max, refill=0",
        "hComp.registerAccount('comp_recv', 0n, 100n, 0n);",
        "const orders = [",
        "  { id: '1', senderId: 'comp_sender', receiverId: 'comp_recv', amount: 60n, fee: 0n },",
        "  { id: '2', senderId: 'comp_sender', receiverId: 'comp_recv', amount: 60n, fee: 0n }",
        "];",
        "const resComp = hComp.processBatch(orders, 10n);",
        "__availableCapacity = 100n;",
        "__committedResources = BigInt(resComp.acceptedCount) * 60n;"
      ]
    },
    {
      "id": "PO-ATOM-001",
      "kind": "commit_atomicity",
      "required": true,
      "oracle": "state_identity_on_abort",
      "prelude": [
        "const hAtom = new ClearingHouse();",
        "hAtom.registerAccount('solv_a', 50n, 1000n, 10n);",
        "hAtom.registerAccount('insolv_b', 10n, 1000n, 10n);",
        "__targetInstance = hAtom;",
        "__abortingBatchCall = () => hAtom.processBatch([",
        "  { id: '1', senderId: 'solv_a', receiverId: 'insolv_b', amount: 30n, fee: 0n, capacityCost: -5n }",
        "], 10n);"
      ]
    },
    {
      "id": "PO-CIRCULAR-001",
      "kind": "generic_invariant",
      "required": true,
      "oracle": "res.acceptedCount === 0 && res.decisions[0].status === 'blocked_insolvent'",
      "prelude": [
        "const hCirc = new ClearingHouse();",
        "hCirc.registerAccount('A', 0n, 1000n, 10n);",
        "hCirc.registerAccount('B', 0n, 1000n, 10n);",
        "const orders = [",
        "  { id: '1', senderId: 'A', receiverId: 'B', amount: 100n, fee: 0n },",
        "  { id: '2', senderId: 'B', receiverId: 'A', amount: 100n, fee: 0n }",
        "];",
        "const res = hCirc.processBatch(orders, 100n);"
      ]
    },
    {
      "id": "PO-ALIASING-001",
      "kind": "generic_invariant",
      "required": true,
      "oracle": "res.acceptedCount === 1 && house.getAccount('Alice', 100n).balance === 485n && house.treasuryBalance === 15n",
      "prelude": [
        "const house = new ClearingHouse();",
        "house.registerAccount('Alice', 500n, 1000n, 10n);",
        "const res = house.processBatch([{ id: 'self1', senderId: 'Alice', receiverId: 'Alice', amount: 100n, fee: 15n }], 100n);"
      ]
    },
    {
      "id": "PO-TEMPORAL-001",
      "kind": "generic_invariant",
      "required": true,
      "oracle": "p1 === 10n && b.tokens === 10n && b.lastUpdateMs === 110n",
      "prelude": [
        "const b = new TokenBucket(100n, 1n, 0n, 100n);",
        "b.update(110n); // +10 tokens",
        "b.update(90n); // recuo temporal -> clamp",
        "b.update(110n); // replay -> 0 tokens adicionados",
        "const p1 = b.peekTokens(110n);"
      ]
    },
    {
      "id": "PO-DIGEST-001",
      "kind": "generic_invariant",
      "required": true,
      "oracle": "res1.executionDigest !== res2.executionDigest",
      "prelude": [
        "const house1 = new ClearingHouse();",
        "house1.registerAccount('Alice', 200n, 1000n, 10n);",
        "house1.registerAccount('Bob', 200n, 1000n, 10n);",
        "const house2 = new ClearingHouse();",
        "house2.registerAccount('Carol', 200n, 1000n, 10n);",
        "house2.registerAccount('Dave', 200n, 1000n, 10n);",
        "const res1 = house1.processBatch([{ id: 'tx_a', senderId: 'Alice', receiverId: 'Bob', amount: 50n, fee: 5n }], 100n);",
        "const res2 = house2.processBatch([{ id: 'tx_b', senderId: 'Carol', receiverId: 'Dave', amount: 50n, fee: 5n }], 100n);"
      ]
    }
  ],
  "behavior": []
}
