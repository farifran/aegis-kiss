{
  "contractVersion": "2.1",
  "goal": "Implementar src/cryptoEnvelope.ts com CryptoEnvelopeManager e obterEstadoQuarentenaBitmask para gerenciamento determinístico de envelopes criptográficos, rotação e quarentena estrita de chaves por limites de uso e expiração temporal sem floats, com re-exportação nominal em src/index.ts.",
  "targets": [
    "src/cryptoEnvelope.ts",
    "src/index.ts"
  ],
  "imports": [],
  "types": [
    {
      "name": "KeyMetadata",
      "shape": "{ readonly keyId: string; readonly keyMaterial: bigint; readonly maxOperations: number; readonly expiresAtMs: bigint; usageCount: number; quarantined: boolean; }"
    },
    {
      "name": "EncryptedEnvelope",
      "shape": "{ readonly keyId: string; readonly payloadCipher: bigint; readonly checksum: bigint; readonly timestampMs: bigint; }"
    },
    {
      "name": "DecryptedMessage",
      "shape": "{ readonly keyId: string; readonly payloadPlain: bigint; readonly verified: boolean; }"
    }
  ],
  "exports": [
    {
      "kind": "class",
      "name": "CryptoEnvelopeManager",
      "privateFields": [
        { "name": "_keys", "type": "Map<string, KeyMetadata>", "readonly": true },
        { "name": "_masterKeyId", "type": "string" },
        { "name": "_isMasterRotating", "type": "boolean" },
        { "name": "_isSystemActive", "type": "boolean" },
        { "name": "_quarantinedCount", "type": "number" },
        { "name": "_processedCount", "type": "number" },
        { "name": "_rejectedCount", "type": "number" }
      ],
      "ctorParams": [],
      "ctorBody": [
        "this._keys = new Map<string, KeyMetadata>();",
        "this._masterKeyId = '';",
        "this._isMasterRotating = false;",
        "this._isSystemActive = true;",
        "this._quarantinedCount = 0;",
        "this._processedCount = 0;",
        "this._rejectedCount = 0;"
      ],
      "methods": [
        {
          "name": "registerKey",
          "params": [
            { "name": "keyId", "type": "string" },
            { "name": "keyMaterial", "type": "bigint" },
            { "name": "maxOps", "type": "number" },
            { "name": "ttlMs", "type": "bigint" }
          ],
          "returns": "void",
          "body": [
            "if (!keyId) throw new TypeError('keyId required');",
            "if (maxOps <= 0) throw new RangeError('maxOps must be positive');",
            "if (ttlMs <= 0n) throw new RangeError('ttlMs must be positive');",
            "const now = BigInt(Date.now());",
            "const expiresAtMs = now + ttlMs;",
            "this._keys.set(keyId, { keyId, keyMaterial, maxOperations: maxOps, expiresAtMs, usageCount: 0, quarantined: false });",
            "if (!this._masterKeyId) { this._masterKeyId = keyId; }"
          ]
        },
        {
          "name": "setMasterKey",
          "params": [{ "name": "keyId", "type": "string" }],
          "returns": "void",
          "body": [
            "const k = this._keys.get(keyId);",
            "if (!k || k.quarantined) throw new Error('invalid master key');",
            "this._masterKeyId = keyId;"
          ]
        },
        {
          "name": "rotateMasterKey",
          "params": [{ "name": "newKeyId", "type": "string" }],
          "returns": "void",
          "body": [
            "const k = this._keys.get(newKeyId);",
            "if (!k || k.quarantined) throw new Error('invalid new master key');",
            "this._isMasterRotating = true;",
            "this._masterKeyId = newKeyId;",
            "this._isMasterRotating = false;"
          ]
        },
        {
          "name": "sealEnvelope",
          "params": [
            { "name": "keyId", "type": "string" },
            { "name": "plaintext", "type": "bigint" },
            { "name": "nowMs?", "type": "bigint" }
          ],
          "returns": "EncryptedEnvelope | null",
          "body": [
            "if (!this._isSystemActive) return null;",
            "const key = this._keys.get(keyId);",
            "if (!key) { this._rejectedCount++; return null; }",
            "const now = nowMs !== undefined ? nowMs : BigInt(Date.now());",
            "if (key.quarantined || now >= key.expiresAtMs || key.usageCount >= key.maxOperations) {",
            "  if (!key.quarantined) { key.quarantined = true; this._quarantinedCount++; }",
            "  this._rejectedCount++;",
            "  return null;",
            "}",
            "key.usageCount++;",
            "this._processedCount++;",
            "const xored = (plaintext ^ key.keyMaterial) & 0xFFFFFFFFFFFFFFFFn;",
            "const cipher = ((xored << 13n) | (xored >> 51n)) & 0xFFFFFFFFFFFFFFFFn;",
            "let cs = 0xcbf29ce484222325n;",
            "const fnvPrime = 0x100000001b3n;",
            "cs = ((cs ^ cipher) * fnvPrime) & 0xFFFFFFFFFFFFFFFFn;",
            "cs = ((cs ^ key.keyMaterial) * fnvPrime) & 0xFFFFFFFFFFFFFFFFn;",
            "if (key.usageCount >= key.maxOperations) { key.quarantined = true; this._quarantinedCount++; }",
            "return { keyId, payloadCipher: cipher, checksum: cs, timestampMs: now };"
          ]
        },
        {
          "name": "openEnvelope",
          "params": [
            { "name": "envelope", "type": "EncryptedEnvelope" },
            { "name": "nowMs?", "type": "bigint" }
          ],
          "returns": "DecryptedMessage | null",
          "body": [
            "if (!this._isSystemActive) return null;",
            "const key = this._keys.get(envelope.keyId);",
            "if (!key || key.quarantined) return null;",
            "const now = nowMs !== undefined ? nowMs : BigInt(Date.now());",
            "if (now >= key.expiresAtMs) { key.quarantined = true; this._quarantinedCount++; return null; }",
            "let cs = 0xcbf29ce484222325n;",
            "const fnvPrime = 0x100000001b3n;",
            "cs = ((cs ^ envelope.payloadCipher) * fnvPrime) & 0xFFFFFFFFFFFFFFFFn;",
            "cs = ((cs ^ key.keyMaterial) * fnvPrime) & 0xFFFFFFFFFFFFFFFFn;",
            "if (cs !== envelope.checksum) return null;",
            "const unrotated = ((envelope.payloadCipher >> 13n) | (envelope.payloadCipher << 51n)) & 0xFFFFFFFFFFFFFFFFn;",
            "const plain = (unrotated ^ key.keyMaterial) & 0xFFFFFFFFFFFFFFFFn;",
            "return { keyId: envelope.keyId, payloadPlain: plain, verified: true };"
          ]
        }
      ],
      "getters": [
        { "name": "isSystemActive", "returns": "boolean", "body": "return this._isSystemActive;" },
        { "name": "isMasterRotating", "returns": "boolean", "body": "return this._isMasterRotating;" },
        { "name": "quarantinedCount", "returns": "number", "body": "return this._quarantinedCount;" },
        { "name": "processedCount", "returns": "number", "body": "return this._processedCount;" },
        { "name": "rejectedCount", "returns": "number", "body": "return this._rejectedCount;" },
        { "name": "masterKeyId", "returns": "string", "body": "return this._masterKeyId;" }
      ],
      "body": []
    },
    {
      "kind": "function",
      "name": "obterEstadoQuarentenaBitmask",
      "params": [{ "name": "manager", "type": "CryptoEnvelopeManager" }],
      "returns": "number",
      "body": [
        "let mask = 0;",
        "if (manager.isSystemActive) mask = mask | 1;",
        "if (manager.quarantinedCount > 0) mask = mask | 2;",
        "if (manager.isMasterRotating) mask = mask | 4;",
        "const qLevel = manager.quarantinedCount > 31 ? 31 : manager.quarantinedCount;",
        "mask = mask | ((qLevel & 31) << 3);",
        "return mask;"
      ],
      "ctorBody": [],
      "methods": [],
      "getters": []
    }
  ],
  "proofObligations": [
    {
      "id": "PO-TYPE-001",
      "kind": "type_safety",
      "required": true,
      "oracle": "typecheck"
    },
    {
      "id": "PO-FAIL-001",
      "kind": "failure_state",
      "required": true,
      "oracle": "state_diff",
      "observableState": ["_keys", "_masterKeyId", "_isSystemActive"],
      "allowedFailureEffects": ["_rejectedCount", "_quarantinedCount"],
      "prelude": [
        "const mgr = new CryptoEnvelopeManager();",
        "mgr.registerKey('k1', 0x123456789abcdef0n, 10, 100000n, 1000n);",
        "__targetInstance = mgr;",
        "__failingCall = () => mgr.sealEnvelope('non_existent_key', 0x999n, 1000n);"
      ]
    },
    {
      "id": "PO-ENCRYPT-ROUNDTRIP",
      "kind": "generic_invariant",
      "required": true,
      "oracle": "dec !== null && dec.verified && dec.payloadPlain === plain",
      "prelude": [
        "const mgr = new CryptoEnvelopeManager();",
        "mgr.registerKey('k_round', 0xaabbccddeeff0011n, 5, 60000n, 1000n);",
        "const plain = 0xdeadbeefcafebaben;",
        "const env = mgr.sealEnvelope('k_round', plain, 1500n);",
        "const dec = env ? mgr.openEnvelope(env, 1600n) : null;"
      ]
    },
    {
      "id": "PO-QUARANTINE-LIMIT",
      "kind": "generic_invariant",
      "required": true,
      "oracle": "e1 !== null && e2 !== null && e3 === null && mgr.quarantinedCount === 1",
      "prelude": [
        "const mgr = new CryptoEnvelopeManager();",
        "mgr.registerKey('k_lim', 0x5555aaaa5555aaaan, 2, 60000n, 1000n);",
        "const e1 = mgr.sealEnvelope('k_lim', 100n, 1100n);",
        "const e2 = mgr.sealEnvelope('k_lim', 200n, 1200n);",
        "const e3 = mgr.sealEnvelope('k_lim', 300n, 1300n);"
      ]
    },
    {
      "id": "PO-QUARANTINE-EXPIRATION",
      "kind": "generic_invariant",
      "required": true,
      "oracle": "eValid !== null && eExpired === null && mgr.quarantinedCount === 1",
      "prelude": [
        "const mgr = new CryptoEnvelopeManager();",
        "mgr.registerKey('k_exp', 0x1111222233334444n, 10, 5000n); // expira em now + 5000n",
        "const t0 = BigInt(Date.now());",
        "const eValid = mgr.sealEnvelope('k_exp', 10n, t0 + 1000n);",
        "const eExpired = mgr.sealEnvelope('k_exp', 20n, t0 + 10000n);"
      ]
    },
    {
      "id": "PO-BITMASK-COMPACT",
      "kind": "generic_invariant",
      "required": true,
      "oracle": "(m1 & 1) === 1 && (m1 & 2) === 0 && (m2 & 2) === 2 && (m2 >> 3) === 1",
      "prelude": [
        "const mgr = new CryptoEnvelopeManager();",
        "mgr.registerKey('k_bit', 0x9999888877776666n, 1, 60000n, 1000n);",
        "const m1 = obterEstadoQuarentenaBitmask(mgr);",
        "mgr.sealEnvelope('k_bit', 10n, 1100n); // esgota uso -> entra em quarentena",
        "const m2 = obterEstadoQuarentenaBitmask(mgr);"
      ]
    }
  ],
  "behavior": []
}
