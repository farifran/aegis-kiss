{
  "name": "aegis-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence governance for IDE-driven software engineering.",
  "scripts": {
    "test": "npm run aegis:test",
    "aegis:cleanup": "bash aegis clean",
    "aegis:typecheck": "tsc --noEmit",
    "aegis:lint": "eslint .",
    "aegis:enforce": "bash scripts/substrates/static_gate.sh --workspace src",
    "aegis:proof-governance": "bash scripts/proof_governance.sh",
    "aegis:proofs": "bash scripts/proof_runner.sh",
    "aegis:verify-structure": "npm run aegis:typecheck && npm run aegis:lint && npm run aegis:enforce",
    "aegis:authorize": "bash aegis authorize",
    "aegis:sanity": "npm run aegis:verify-structure",
    "aegis:test:proof-governance": "bash scripts/substrates/test/test_proof_governance.sh",
    "aegis:test:formal-promotion": "bash scripts/substrates/test/test_formal_promotion_authorization.sh",
    "aegis:test:preflight-v2": "bash scripts/substrates/test/test_preflight_v2.sh",
    "aegis:test:contract-ir-v2": "bash scripts/substrates/test/test_contract_ir_v2.sh",
    "aegis:test:ide-gateway": "bash scripts/substrates/test/test_ide_gateway.sh",
    "aegis:test:governance-schemas": "bash scripts/substrates/test/test_governance_schemas.sh",
    "aegis:test": "npm run aegis:test:governance-schemas && npm run aegis:test:preflight-v2 && npm run aegis:test:contract-ir-v2 && npm run aegis:test:proof-governance && npm run aegis:test:formal-promotion && npm run aegis:test:ide-gateway"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.30.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.4.1",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "eslint-plugin-boundaries": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
