          "body": "return this._merkleRoot;"
        }
      ]
    },
    {
      "kind": "function",
      "name": "compileAuctionBitmask",
      "params": [
        {
          "name": "engine",
          "type": "AuctionEngine"
        }
      ],
      "returns": "number",
      "body": [
        "let mask = 0;",
        "if (engine.isLocked) mask = mask | 1;",
        "if (engine.cycleVolume > 0n) mask = mask | 2;",
        "if (engine.fractionalVolume > 0n) mask = mask | 4;",
        "if (engine.totalSettledVolume > 10000000n) mask = mask | 8;",
        "const p = engine.settledParticipantsCount > 63 ? 63 : engine.settledParticipantsCount;",
        "mask = mask | ((p & 63) << 4);",
        "const r = engine.residualOrdersCount > 63 ? 63 : engine.residualOrdersCount;",
        "mask = mask | ((r & 63) << 10);",
        "const top16 = Number((engine.merkleRoot >> 48n) & 65535n);",
        "mask = mask | ((top16 & 65535) << 16);",
        "return mask;"
      ]
    }
  ],
  "barrelFile": "src/index.ts",
  "barrelFrom": "./auctionEngine.js",
  "behavior": [
    {
      "desc": "Process 3-cycle circular batch and verify exact volume obliteration and zero double-settlement in partial fill",
      "exports": [
        "AuctionEngine",
        "compileAuctionBitmask"
      ],
      "prelude": [
        "const eng = new AuctionEngine(10n);",
        "const batch = [{ id: '1', from: 'A', to: 'B', amount: 1000n }, { id: '2', from: 'B', to: 'C', amount: 1000n }, { id: '3', from: 'C', to: 'A', amount: 1000n }];",
        "const res = eng.processBatch(batch, 3000n);",
        "const mask = compileAuctionBitmask(eng);"
      ],
      "assert": "res.cycleVolume === 3000n && res.fractionalVolume === 0n && res.settledVolume === 3000n && (mask & 2) === 2 && res.settledParticipantsCount === 3"
    },
    {
      "desc": "Process residual linear orders with partial fill and verify Merkle root derivation",
      "exports": [
        "AuctionEngine",
        "compileAuctionBitmask"
      ],
      "prelude": [
        "const eng = new AuctionEngine(10n);",
        "const batch = [{ id: '1', from: 'A', to: 'B', amount: 1000n }];",
        "const res = eng.processBatch(batch, 500n);",
        "const mask = compileAuctionBitmask(eng);"
      ],
      "assert": "res.fractionalVolume === 500n && (mask & 4) === 4 && res.merkleRoot > 0n"
    },
    {
      "desc": "Verify lock activation reflects in bitmask bit 0",
      "exports": [
        "AuctionEngine",
        "compileAuctionBitmask"
      ],
      "prelude": [
        "const eng = new AuctionEngine(1n);",
        "eng.lock();",
        "const mask = compileAuctionBitmask(eng);"
      ],
      "assert": "eng.isLocked === true && (mask & 1) === 1"
    }
  ],
  "proofObligations": [
    {
      "id": "PROOF-CONSERVATION-MAX-DEMAND",
      "axiom": "AXIOMA_IV_FALSIFICACAO_SIMETRICA_E_PROVAS",
      "invariant": "settledVolume <= totalBatchDemand",
      "property": "Global conservation of cleared multilateral flow",
      "prelude": [
        "const eng = new AuctionEngine(1n);",
        "const batch = [{ id: '1', from: 'A', to: 'B', amount: 1000n }, { id: '2', from: 'B', to: 'C', amount: 1000n }, { id: '3', from: 'C', to: 'A', amount: 1000n }];",
        "const res = eng.processBatch(batch, 3000n);"
      ],
      "oracle": "res.settledVolume <= 3000n && res.fractionalVolume === 0n"
    }
  ]
}
