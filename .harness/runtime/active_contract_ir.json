rces = BigInt(resComp.settledCount) * 480n; // Se admitir os 2, comete 960n > 800n!"]},{"id":"PO-ATOM-001","kind":"commit_atomicity","required":true,"observableState":["_accounts","_treasuryBalance"],"allowedFailureEffects":["_lastRollback","_rejectedCount"],"oracle":"state_identity_on_abort","prelude":["const hAtom = new ClearingHouse();","hAtom.registerAccount('solv_a', 50n, 1000n, 10);","hAtom.registerAccount('insolv_b', 10n, 1000n, 10);","__targetInstance = hAtom;","__abortingBatchCall = () => hAtom.processBatch([","  { id: '1', senderId: 'solv_a', receiverId: 'insolv_b', amount: 30n, fee: 0n },","  { id: '2', senderId: 'insolv_b', receiverId: 'solv_a', amount: 200n, fee: 0n } // Insolvente!","]);"]},{"id":"PO-CIRCULAR-001","kind":"generic_invariant","required":true,"oracle":"res.settledCount === 3 && res.settledVolume === 300n && !res.rolledBack","prelude":["const hCirc = new ClearingHouse();","hCirc.registerAccount('A', 0n, 1000n, 10);","hCirc.registerAccount('B', 0n, 1000n, 10);","hCirc.registerAccount('C', 0n, 1000n, 10);","const orders = [","  { id: '1', senderId: 'A', receiverId: 'B', amount: 100n, fee: 0n },","  { id: '2', senderId: 'B', receiverId: 'C', amount: 100n, fee: 0n },","  { id: '3', senderId: 'C', receiverId: 'A', amount: 100n, fee: 0n }","];","const res = hCirc.processBatch(orders);"]},{"id":"PO-PEEK-001","kind":"generic_invariant","required":true,"oracle":"p1 === 800n && p2 === 800n && b.tokens === 800n && b.lastUpdateMs === t0","prelude":["const b = new TokenBucket(100n, 10);","const t0 = b.lastUpdateMs;","const p1 = b.peekTokens(t0 + 1000n);","const p2 = b.peekTokens(t0 + 2000n);"]}],"behavior":[]}