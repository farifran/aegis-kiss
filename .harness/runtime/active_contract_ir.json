{"contractVersion":"2.1","goal":"Implementar o motor central universal de processamento de lotes de operações (src/clearingHouse.ts) integrado ao TokenBucket (src/tokenBucket.ts) com prova de conservação de soma-zero, controle de vazão por capacidade temporal, composição de reservas, atomicidade estrita de commit (2PC) e telemetria observável em src/index.ts.","targets":["src/tokenBucket.ts","src/clearingHouse.ts","src/index.ts"],"imports":[],"types":[{"name":"ClockPolicy","shape":"'monotonic_reject' | 'monotonic_clamp' | 'allow_backward' | 'logical_clock'"},{"name":"TransferOrder","shape":"{ readonly id: string; readonly senderId: string; readonly receiverId: string; readonly amount: bigint; readonly fee: bigint; }"},{"name":"AccountState","shape":"{ balance: bigint; bucket: TokenBucket; quarantined: boolean; }"},{"name":"BatchResult","shape":"{ readonly settledCount: number; readonly rejectedCount: number; readonly quarantinedCount: number; readonly settledVolume: bigint; readonly retainedFees: bigint; readonly merkleRoot: bigint; readonly rolledBack: boolean; }"},{"name":"ClearingHouseSnapshot","shape":"{ readonly accounts: Map<string, { readonly balance: bigint; readonly quarantined: boolean; readonly bucket: { readonly tokens: bigint; readonly lastUpdateMs: bigint } }>; readonly treasuryBalance: bigint; readonly quarantineCount: number; }"}],"exports":[{"kind":"class","name":"TokenBucket","privateFields":[{"name":"_maxTokens","type":"bigint","readonly":true},{"name":"_rateBitsPerMs","type":"bigint","readonly":true},{"name":"_clockPolicy","type":"ClockPolicy","readonly":true},{"name":"_tokens","type":"bigint"},{"name":"_lastUpdateMs","type":"bigint"}],"ctorParams":[{"name":"maxBytes","type":"bigint"},{"name":"mbps","type":"number"},{"name":"clockPolicy?","type":"ClockPolicy"}],"ctorBody":["if (maxBytes < 0n) throw new RangeError('maxBytes must be non-negative');","if (!Number.isFinite(mbps) || mbps < 0) throw new RangeError('mbps must be a non-negative finite number');","const policy: ClockPolicy = clockPolicy !== undefined ? clockPolicy : 'monotonic_clamp';","if (!['monotonic_reject', 'monotonic_clamp', 'allow_backward', 'logical_clock'].includes(policy)) throw new RangeError('invalid clock policy');","this._maxTokens = maxBytes * 8n;","this._rateBitsPerMs = BigInt(Math.round(mbps * 8000));","this._clockPolicy = policy;","this._tokens = this._maxTokens;","this._lastUpdateMs = BigInt(Date.now());"],"methods":[{"name":"update","params":[{"name":"nowMs?","type":"bigint"}],"returns":"void","body":["const now = nowMs !== undefined ? nowMs : BigInt(Date.now());","if (now < this._lastUpdateMs) {","  if (this._clockPolicy === 'monotonic_reject') throw new RangeError('clock moved backwards');","  if (this._clockPolicy !== 'allow_backward') return;","  this._lastUpdateMs = now;","  return;","}","if (now === this._lastUpdateMs) return;","const timeDiff = now - this._lastUpdateMs;","this._lastUpdateMs = now;","if (this._rateBitsPerMs > 0n) {","  const replenished = this._tokens + timeDiff * this._rateBitsPerMs;","  this._tokens = replenished > this._maxTokens ? this._maxTokens : replenished;","}"]},{"name":"consume","params":[{"name":"bits","type":"bigint"},{"name":"nowMs?","type":"bigint"}],"returns":"boolean","body":["if (bits < 0n) throw new RangeError('bits must be non-negative');","this.update(nowMs);","if (this._tokens >= bits) {","  this._tokens = this._tokens - bits;","  return true;","}","return false;"]},{"name":"peekTokens","params":[{"name":"nowMs?","type":"bigint"}],"returns":"bigint","body":["const now = nowMs !== undefined ? nowMs : BigInt(Date.now());","if (now < this._lastUpdateMs) {","  if (this._clockPolicy === 'monotonic_reject') throw new RangeError('clock moved backwards');","  return this._tokens;","}","if (now === this._lastUpdateMs || this._rateBitsPerMs <= 0n) return this._tokens;","const timeDiff = now - this._lastUpdateMs;","const replenished = this._tokens + timeDiff * this._rateBitsPerMs;","return replenished > this._maxTokens ? this._maxTokens : replenished;"]},{"name":"snapshot","params":[],"returns":"{ readonly tokens: bigint; readonly lastUpdateMs: bigint }","body":["return { tokens: this._tokens, lastUpdateMs: this._lastUpdateMs };"]},{"name":"restore","params":[{"name":"snap","type":"{ readonly tokens: bigint; readonly lastUpdateMs: bigint }"}],"returns":"void","body":["if (snap.tokens < 0n || snap.tokens > this._maxTokens) throw new RangeError('invalid token bucket snapshot');","this._tokens = snap.tokens;","this._lastUpdateMs = snap.lastUpdateMs;"]}],"getters":[{"name":"tokens","returns":"bigint","body":"return this._tokens;"},{"name":"maxTokens","returns":"bigint","body":"return this._maxTokens;"},{"name":"rateBitsPerMs","returns":"bigint","body":"return this._rateBitsPerMs;"},{"name":"clockPolicy","returns":"ClockPolicy","body":"return this._clockPolicy;"},{"name":"lastUpdateMs","returns":"bigint","body":"return this._lastUpdateMs;"},{"name":"refillActive","returns":"boolean","body":"return this._rateBitsPerMs > 0n && this._tokens < this._maxTokens;"}],"body":[]},{"kind":"function","name":"obterEstadoBitmask","params":[{"name":"bucket","type":"TokenBucket"}],"returns":"number","body":["let mask = 0;","if (bucket.tokens === 0n) mask = mask | 1;","if (bucket.refillActive) mask = mask | 2;","return mask;"],"ctorBody":[],"methods":[],"getters":[]},{"kind":"class","name":"ClearingHouse","privateFields":[{"name":"_accounts","type":"Map<string, AccountState>","readonly":true},{"name":"_treasuryBalance","type":"bigint"},{"name":"_isLocked","type":"boolean"},{"name":"_lastRollback","type":"boolean"},{"name":"_totalSettledVolume","type":"bigint"},{"name":"_totalRetainedFees","type":"bigint"},{"name":"_quarantineCount","type":"number"},{"name":"_rejectedCount","type":"number"},{"name":"_lastMerkleRoot","type":"bigint"},{"name":"_globalChecksum","type":"bigint"}],"ctorParams":[],"ctorBody":["this._accounts = new Map<string, AccountState>();","this._treasuryBalance = 0n;","this._isLocked = false;","this._lastRollback = false;","this._totalSettledVolume = 0n;","this._totalRetainedFees = 0n;","this._quarantineCount = 0;","this._rejectedCount = 0;","this._lastMerkleRoot = 0n;","this._globalChecksum = 0n;"],"methods":[{"name":"registerAccount","params":[{"name":"accountId","type":"string"},{"name":"initialBalance","type":"bigint"},{"name":"maxBytes","type":"bigint"},{"name":"mbps","type":"number"}],"returns":"void","body":["if (!accountId) throw new TypeError('accountId required');","if (initialBalance < 0n) throw new RangeError('initialBalance must be non-negative');","const bucket = new TokenBucket(maxBytes, mbps);","this._accounts.set(accountId, { balance: initialBalance, bucket, quarantined: false });","this._globalChecksum = (this._globalChecksum ^ initialBalance) & 0xFFFFFFFFFFFFFFFFn;"]},{"name":"_snapshotState","params":[],"returns":"ClearingHouseSnapshot","body":["const accounts = new Map<string, { readonly balance: bigint; readonly quarantined: boolean; readonly bucket: { readonly tokens: bigint; readonly lastUpdateMs: bigint } }>();","for (const [accountId, account] of this._accounts.entries()) {","  accounts.set(accountId, { balance: account.balance, quarantined: account.quarantined, bucket: account.bucket.snapshot() });","}","return { accounts, treasuryBalance: this._treasuryBalance, quarantineCount: this._quarantineCount };"]},{"name":"_restoreState","params":[{"name":"snapshot","type":"ClearingHouseSnapshot"}],"returns":"void","body":["for (const [accountId, state] of snapshot.accounts.entries()) {","  const account = this._accounts.get(accountId);","  if (account) {","    account.balance = state.balance;","    account.quarantined = state.quarantined;","    account.bucket.restore(state.bucket);","  }","}","this._treasuryBalance = snapshot.treasuryBalance;","this._quarantineCount = snapshot.quarantineCount;"]},{"name":"processBatch","params":[{"name":"orders","type":"readonly TransferOrder[]"},{"name":"nowMs?","type":"bigint"}],"returns":"BatchResult","body":["const now = nowMs !== undefined ? nowMs : BigInt(Date.now());","this._lastRollback = false;","if (this._isLocked) {","  return { settledCount: 0, rejectedCount: orders.length, quarantinedCount: 0, settledVolume: 0n, retainedFees: 0n, merkleRoot: this._lastMerkleRoot, rolledBack: false };","}","let initialSum = this._treasuryBalance;","for (const acc of this._accounts.values()) initialSum = initialSum + acc.balance;","const admitted: TransferOrder[] = [];","let rejectedCount = 0;","const quarantinedInBatch = new Set<string>();","const reservedBits = new Map<string, bigint>();","for (const ord of orders) {","  if (ord.amount <= 0n || ord.fee < 0n) { rejectedCount++; continue; }","  const sender = this._accounts.get(ord.senderId);","  const receiver = this._accounts.get(ord.receiverId);","  if (!sender || !receiver || sender.quarantined || receiver.quarantined || quarantinedInBatch.has(ord.senderId)) { rejectedCount++; continue; }","  const requiredBits = (ord.amount + ord.fee) * 8n;","  const currentReserved = reservedBits.get(ord.senderId) ?? 0n;","  if (sender.bucket.peekTokens(now) < currentReserved + requiredBits) {","    quarantinedInBatch.add(ord.senderId);","    rejectedCount++;","    continue;","  }","  reservedBits.set(ord.senderId, currentReserved + requiredBits);","  admitted.push(ord);","}","const deltas = new Map<string, bigint>();","let batchVolume = 0n;","let batchFees = 0n;","for (const ord of admitted) {","  const sDelta = (deltas.get(ord.senderId) ?? 0n) - (ord.amount + ord.fee);","  const rDelta = (deltas.get(ord.receiverId) ?? 0n) + ord.amount;","  deltas.set(ord.senderId, sDelta);","  deltas.set(ord.receiverId, rDelta);","  batchVolume = batchVolume + ord.amount;","  batchFees = batchFees + ord.fee;","}","let solvent = true;","for (const [accId, delta] of deltas.entries()) {","  const acc = this._accounts.get(accId);","  if (acc && acc.balance + delta < 0n) { solvent = false; break; }","}","if (!solvent) {","  this._lastRollback = true;","  return { settledCount: 0, rejectedCount: orders.length, quarantinedCount: quarantinedInBatch.size, settledVolume: 0n, retainedFees: 0n, merkleRoot: 0n, rolledBack: true };","}","const snapshot = this._snapshotState();","try {","  for (const ord of admitted) {","    const sender = this._accounts.get(ord.senderId);","    if (sender) {","      const reqBits = (ord.amount + ord.fee) * 8n;","      if (!sender.bucket.consume(reqBits, now)) throw new Error('commit rejected');","    }","  }","  for (const [accId, delta] of deltas.entries()) {","    const acc = this._accounts.get(accId);","    if (acc) acc.balance = acc.balance + delta;","  }","  for (const qId of quarantinedInBatch) {","    const acc = this._accounts.get(qId);","    if (acc) acc.quarantined = true;","  }","  this._treasuryBalance = this._treasuryBalance + batchFees;","} catch {","  this._restoreState(snapshot);","  this._lastRollback = true;","  return { settledCount: 0, rejectedCount: orders.length, quarantinedCount: quarantinedInBatch.size, settledVolume: 0n, retainedFees: 0n, merkleRoot: 0n, rolledBack: true };","}","let finalSum = this._treasuryBalance;","for (const acc of this._accounts.values()) finalSum = finalSum + acc.balance;","if (initialSum !== finalSum) {","  this._restoreState(snapshot);","  this._lastRollback = true;","  return { settledCount: 0, rejectedCount: orders.length, quarantinedCount: quarantinedInBatch.size, settledVolume: 0n, retainedFees: 0n, merkleRoot: 0n, rolledBack: true };","}","let merkle = 0xcbf29ce484222325n;","const fnvPrime = 0x100000001b3n;","for (const ord of admitted) { merkle = (merkle ^ ord.amount) * fnvPrime & 0xFFFFFFFFFFFFFFFFn; merkle = (merkle ^ ord.fee) * fnvPrime & 0xFFFFFFFFFFFFFFFFn; }","this._totalSettledVolume = this._totalSettledVolume + batchVolume;","this._totalRetainedFees = this._totalRetainedFees + batchFees;","let totalQuarantined = 0;","for (const acc of this._accounts.values()) { if (acc.quarantined) totalQuarantined++; }","this._quarantineCount = totalQuarantined;","this._rejectedCount = rejectedCount;","this._lastMerkleRoot = merkle;","this._globalChecksum = (this._globalChecksum ^ merkle ^ finalSum) & 0xFFFFFFFFFFFFFFFFn;","return { settledCount: admitted.length, rejectedCount, quarantinedCount: quarantinedInBatch.size, settledVolume: batchVolume, retainedFees: batchFees, merkleRoot: merkle, rolledBack: false };"]}],"getters":[{"name":"isLocked","returns":"boolean","body":"return this._isLocked;"},{"name":"lastRollback","returns":"boolean","body":"return this._lastRollback;"},{"name":"totalSettledVolume","returns":"bigint","body":"return this._totalSettledVolume;"},{"name":"totalRetainedFees","returns":"bigint","body":"return this._totalRetainedFees;"},{"name":"quarantineCount","returns":"number","body":"return this._quarantineCount;"},{"name":"rejectedCount","returns":"number","body":"return this._rejectedCount;"},{"name":"lastMerkleRoot","returns":"bigint","body":"return this._lastMerkleRoot;"},{"name":"globalChecksum","returns":"bigint","body":"return this._globalChecksum;"},{"name":"treasuryBalance","returns":"bigint","body":"return this._treasuryBalance;"}],"body":[]},{"kind":"function","name":"obterClearingHouseBitmask","params":[{"name":"house","type":"ClearingHouse"}],"returns":"bigint","body":["let mask = 0n;","if (house.isLocked) mask = mask | 1n;","if (house.quarantineCount > 0) mask = mask | 2n;","if (house.lastRollback) mask = mask | 4n;","if (house.totalSettledVolume > 10000000n) mask = mask | 8n;","const q = BigInt(house.quarantineCount > 63 ? 63 : house.quarantineCount);","mask = mask | ((q & 63n) << 4n);","const r = BigInt(house.rejectedCount > 63 ? 63 : house.rejectedCount);","mask = mask | ((r & 63n) << 10n);","const top16 = (house.lastMerkleRoot >> 48n) & 65535n;","mask = mask | ((top16 & 65535n) << 16n);","const low32 = house.globalChecksum & 4294967295n;","mask = mask | ((low32 & 4294967295n) << 32n);","return mask;"],"ctorBody":[],"methods":[],"