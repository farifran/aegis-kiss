{"goal":"Crie src/tokenBucket.ts com a classe TokenBucket e a função obterEstadoBitmask com bit 0 se tokens==0n e bit 1 se refil ativo. Re-exporte no src/index.ts.","targets":["src/tokenBucket.ts","src/index.ts"],"imports":[],"types":[],"exports":[{"kind":"class","name":"TokenBucket","privateFields":[{"name":"_maxTokens","type":"bigint","readonly":true},{"name":"_rateBitsPerMs","type":"bigint","readonly":true},{"name":"_tokens","type":"bigint"},{"name":"_lastUpdateMs","type":"bigint"}],"ctorParams":[{"name":"maxBytes","type":"bigint"},{"name":"mbps","type":"number"}],"ctorBody":["if (maxBytes < 0n) throw new RangeError('maxBytes must be non-negative');","if (!Number.isFinite(mbps) || mbps < 0) throw new RangeError('mbps must be a non-negative finite number');","this._maxTokens = maxBytes * 8n;","this._rateBitsPerMs = BigInt(Math.round(mbps * 8000));","this._tokens = this._maxTokens;","this._lastUpdateMs = BigInt(Date.now());"],"methods":[{"name":"update","params":[{"name":"nowMs?","type":"bigint"}],"returns":"void","body":["const now = nowMs !== undefined ? nowMs : BigInt(Date.now());","if (now <= this._lastUpdateMs) return;","const timeDiff = now - this._lastUpdateMs;","this._lastUpdateMs = now;","if (this._rateBitsPerMs > 0n) {","  const replenished = this._tokens + timeDiff * this._rateBitsPerMs;","  this._tokens = replenished > this._maxTokens ? this._maxTokens : replenished;","}"]},{"name":"consume","params":[{"name":"bits","type":"bigint"},{"name":"nowMs?","type":"bigint"}],"returns":"boolean","body":["if (bits < 0n) throw new RangeError('bits must be non-negative');","this.update(nowMs);","if (this._tokens >= bits) {","  this._tokens = this._tokens - bits;","  return true;","}","return false;"]}],"getters":[{"name":"tokens","returns":"bigint","body":"return this._tokens;"},{"name":"maxTokens","returns":"bigint","body":"return this._maxTokens;"},{"name":"rateBitsPerMs","returns":"bigint","body":"return this._rateBitsPerMs;"},{"name":"lastUpdateMs","returns":"bigint","body":"return this._lastUpdateMs;"},{"name":"refillActive","returns":"boolean","body":"return this._tokens < this._maxTokens;"}],"body":[]},{"kind":"function","name":"obterEstadoBitmask","params":[{"name":"bucket","type":"TokenBucket"}],"returns":"number","body":["let mask = 0;","if (bucket.tokens === 0n) mask = mask | 1;","if (bucket.refillActive) mask = mask | 2;","return mask;"],"ctorBody":[],"methods":[],"getters":[]}],"barrelFile":"src/index.ts","barrelFrom":"./tokenBucket.js","questions":[],"behavior":[{"desc":"Initialize TokenBucket full with refill inactive and bitmask 0","exports":["TokenBucket","obterEstadoBitmask"],"prelude":["const bucket = new TokenBucket(100n, 1);"],"assert":"bucket.maxTokens === 800n && bucket.tokens === 800n && bucket.refillActive === false && obterEstadoBitmask(bucket) === 0"},{"desc":"Bitmask indicates tokens==0n and refillActive after total depletion","exports":["TokenBucket","obterEstadoBitmask"],"prelude":["const bucket = new TokenBucket(100n, 1);","const t0 = bucket.lastUpdateMs;","const ok = bucket.consume(800n, t0);","const mask = obterEstadoBitmask(bucket);"],"assert":"ok === true && bucket.tokens === 0n && bucket.refillActive === true && mask === 3"},{"desc":"Bitmask indicates only refillActive when partially consumed","exports":["TokenBucket","obterEstadoBitmask"],"prelude":["const bucket = new TokenBucket(100n, 1);","const t0 = bucket.lastUpdateMs;","const ok = bucket.consume(400n, t0);","const mask = obterEstadoBitmask(bucket);"],"assert":"ok === true && bucket.tokens === 400n && bucket.refillActive === true && mask === 2"}],"proofObligations":[{"id":"PROOF-TOKEN-CAP-INVARIANT","invariant":"INV-TOKENS-BOUNDED","prelude":["const bucket = new TokenBucket(500n, 2);","bucket.update(bucket.lastUpdateMs + 10000n);"],"oracle":"bucket.tokens <= bucket.maxTokens && bucket.tokens === bucket.maxTokens"},{"id":"PROOF-CLOCK-SKEW-IMMUNITY","invariant":"INV-MONOTONIC-CLOCK","prelude":["const bucket = new TokenBucket(500n, 2);","const last = bucket.lastUpdateMs;","bucket.update(last - 1000n);"],"oracle":"bucket.lastUpdateMs === last"}],"performanceContract":{"hotPath":["update","consume","obterEstadoBitmask"],"maxHeapAllocations":0},"preconditions":[{"target":"maxBytes","require":"maxBytes >= 0n","error":"RangeError","message":"maxBytes must be non-negative"},{"target":"mbps","require":"Number.isFinite(mbps) && mbps >= 0","error":"RangeError","message":"mbps must be a non-negative finite number"},{"target":"bits","require":"bits >= 0n","error":"RangeError","message":"bits must be non-negative"}],"invariants":[{"id":"INV-TOKENS-BOUNDED","predicate":"0n <= bucket.tokens && bucket.tokens <= bucket.maxTokens","checkedAfter":["update","consume"]},{"id":"INV-MONOTONIC-CLOCK","predicate":"bucket.lastUpdateMs >= lastUpdateMs_prev","checkedAfter":["update","consume"]}],"postconditions":[{"method":"consume","guarantee":"tokens_after === (ok ? tokens_before - bits : tokens_before)"}]}