{
  "version": "3.0",
  "goal": "Motor central de processamento atômico, determinístico e observável de lotes de operações com recursos limitados e ciclo temporal explícito.",
  "targets": ["src/tokenBucket.ts", "src/clearingHouse.ts", "src/index.ts"],
  "publicContract": { "exports": ["TokenBucket", "ClearingHouse", "obterEstadoBitmask", "obterClearingHouseBitmask"] },
  "requirements": [
    { "id": "REQ-TYPE", "proofObligationId": "PO-TYPE" },
    { "id": "REQ-ADMISSION", "proofObligationId": "PO-ADMISSION" },
    { "id": "REQ-FAILURE-STATE", "proofObligationId": "PO-FAILURE-STATE" },
    { "id": "REQ-RESOURCE", "proofObligationId": "PO-RESOURCE" },
    { "id": "REQ-COMPOSITION", "proofObligationId": "PO-COMPOSITION" },
    { "id": "REQ-COMMIT", "proofObligationId": "PO-COMMIT" },
    { "id": "REQ-RESULT-STATE", "proofObligationId": "PO-RESULT-STATE" },
    { "id": "REQ-LIFECYCLE", "proofObligationId": "PO-LIFECYCLE" },
    { "id": "REQ-TEMPORAL", "proofObligationId": "PO-TEMPORAL" },
    { "id": "REQ-DIGEST-IDENTITY", "proofObligationId": "PO-DIGEST-IDENTITY" },
    { "id": "REQ-CHECKSUM-IDENTITY", "proofObligationId": "PO-CHECKSUM-IDENTITY" }
  ],
  "operations": [
    {
      "id": "OP-PROCESS-BATCH",
      "target": "ClearingHouse.processBatch",
      "admission": { "preconditions": ["order amount > 0", "fee >= 0", "sender and receiver exist", "entities are not quarantined"] },
      "failure": { "allowedEffects": ["_lastRollback", "_rejectedCount", "_quarantineCount"] },
      "resources": [
        { "resource": "sender.bucket.tokens", "owner": "TokenBucket", "scope": "batch", "capacity": "maxTokens", "allowedExits": [] },
        { "resource": "balances", "owner": "ClearingHouse", "scope": "transaction", "capacity": "account balances", "allowedExits": ["treasuryBalance"] }
      ],
      "composition": { "sharedResources": [{ "resource": "sender.bucket.tokens", "rule": "aggregate_demand <= available" }, { "resource": "balances", "rule": "aggregate_debits <= aggregate_solvency" }] },
      "transaction": { "atomic": true, "phases": ["ADMISSION", "RESERVATION", "PREPARE", "VALIDATE", "COMMIT"], "requiredEffects": ["bucket.consume", "balances.apply", "treasury.credit"] },
      "lifecycle": [{ "state": "batchQuarantine", "scope": "BATCH" }],
      "observability": { "resultMustMatchState": ["rejectedCount", "quarantineCount", "totalSettledVolume", "totalRetainedFees"] }
    },
    {
      "id": "OP-TOKEN-CLOCK",
      "target": "TokenBucket.update",
      "lifecycle": [{ "state": "lastUpdateMs", "scope": "INSTANCE" }],
      "temporal": { "clockPolicy": "logical_clock" }
    }
  ],
  "proofObligations": [
    { "id": "PO-CONTRACT-COVERAGE", "target": "contract", "domain": "CONTRACT", "kind": "contract_coverage", "oracle": "contract_coverage" },
    { "id": "PO-TYPE", "target": "src", "domain": "TYPE_SYSTEM", "kind": "type_safety", "oracle": "typecheck" },
    {
      "id": "PO-ADMISSION", "target": "ClearingHouse.processBatch", "domain": "ADMISSION", "kind": "admission", "oracle": "admission_reject",
      "prelude": [
        "const h = new ClearingHouse();",
        "h.registerAccount('admission_a', 100n, 1000n, 10);",
        "h.registerAccount('admission_b', 0n, 1000n, 10);",
        "__invalidCall = () => h.processBatch([{ id: 'invalid', senderId: 'admission_a', receiverId: 'admission_b', amount: 0n, fee: 0n }]).settledCount > 0;"
      ]
    },
    {
      "id": "PO-FAILURE-STATE", "target": "ClearingHouse.processBatch", "domain": "STATE", "kind": "failure_state", "oracle": "state_diff",
      "observableState": ["_accounts", "_treasuryBalance", "_isLocked"],
      "allowedFailureEffects": ["_lastRollback", "_rejectedCount", "_quarantineCount"],
      "prelude": [
        "const h = new ClearingHouse();",
        "h.registerAccount('failure_a', 10n, 1000n, 10);",
        "h.registerAccount('failure_b', 0n, 1000n, 10);",
        "__targetInstance = h;",
        "__failingCall = () => h.processBatch([{ id: 'invalid-finance', senderId: 'failure_a', receiverId: 'failure_b', amount: 500n, fee: 10n }]);"
      ]
    },
    {
      "id": "PO-RESOURCE", "target": "ClearingHouse.processBatch", "domain": "RESOURCE", "kind": "resource_conservation", "oracle": "conservation_equation",
      "resourceBoundary": { "before": ["balance", "treasuryBalance"], "after": ["balance", "treasuryBalance"] },
      "prelude": [
        "const h = new ClearingHouse();",
        "h.registerAccount('resource_a', 100n, 1000n, 10);",
        "h.registerAccount('resource_b', 50n, 1000n, 10);",
        "__targetBefore = { balance: 150n, treasuryBalance: h.treasuryBalance };",
        "h.processBatch([{ id: 'resource-transfer', senderId: 'resource_a', receiverId: 'resource_b', amount: 20n, fee: 5n }]);",
        "__targetAfter = { balance: 145n, treasuryBalance: h.treasuryBalance };"
      ]
    },
    {
      "id": "PO-COMPOSITION", "target": "ClearingHouse.processBatch", "domain": "COMPOSITION", "kind": "resource_composition", "oracle": "aggregate_reservation",
      "prelude": [
        "const h = new ClearingHouse();",
        "h.registerAccount('composition_a', 1000n, 100n, 0);",
        "h.registerAccount('composition_b', 0n, 100n, 0);",
        "const res = h.processBatch([{ id: 'c1', senderId: 'composition_a', receiverId: 'composition_b', amount: 60n, fee: 0n }, { id: 'c2', senderId: 'composition_a', receiverId: 'composition_b', amount: 60n, fee: 0n }]);",
        "__availableCapacity = 800n;",
        "__committedResources = BigInt(res.settledCount) * 480n;"
      ]
    },
    {
      "id": "PO-COMMIT", "target": "ClearingHouse.processBatch", "domain": "COMMIT", "kind": "commit_atomicity", "oracle": "commit_atomicity",
      "requiredEffects": ["bucket.consume", "balances.apply", "treasury.credit"],
      "observableState": ["_accounts", "_treasuryBalance", "_quarantineCount", "_lastRollback", "_totalSettledVolume", "_totalRetainedFees", "_rejectedCount", "_lastMerkleRoot", "_globalChecksum"],
      "allowedFailureEffects": ["_lastRollback"],
      "prelude": [
        "const h = new ClearingHouse();",
        "h.registerAccount('commit_a', 100n, 1000n, 10);",
        "h.registerAccount('commit_b', 0n, 1000n, 10);",
        "const a = (h as any)._accounts.get('commit_a');",
        "a.bucket.consume = () => false;",
        "__targetInstance = h;",
        "__abortingBatchCall = () => h.processBatch([{ id: 'commit-fail', senderId: 'commit_a', receiverId: 'commit_b', amount: 10n, fee: 1n }]);"
      ]
    },
    {
      "id": "PO-RESULT-STATE", "target": "ClearingHouse.processBatch", "domain": "OBSERVABILITY", "kind": "result_state_consistency", "oracle": "result_state_consistency",
      "mapping": {
        "rejectedCount": { "state": "_rejectedCount", "relation": "equal" },
        "quarantinedCount": { "state": "_quarantineCount", "relation": "equal" },
        "settledVolume": { "state": "_totalSettledVolume", "relation": "delta" },
        "retainedFees": { "state": "_totalRetainedFees", "relation": "delta" }
      },
      "prelude": [
        "const h = new ClearingHouse();",
        "h.registerAccount('result_a', 100n, 1000n, 10);",
        "h.registerAccount('result_b', 0n, 1000n, 10);",
        "__resultTarget = h;",
        "__resultCall = () => h.processBatch([{ id: 'result-transfer', senderId: 'result_a', receiverId: 'result_b', amount: 20n, fee: 5n }]);"
      ]
    },
    {
      "id": "PO-LIFECYCLE", "target": "ClearingHouse.processBatch", "domain": "LIFECYCLE", "kind": "lifecycle", "oracle": "lifecycle_expiry",
      "prelude": [
        "const h = new ClearingHouse();",
        "h.registerAccount('lifecycle_a', 1000n, 1n, 0);",
        "h.registerAccount('lifecycle_b', 0n, 1000n, 0);",
        "h.processBatch([{ id: 'quarantine', senderId: 'lifecycle_a', receiverId: 'lifecycle_b', amount: 100n, fee: 0n }]);",
        "__lifecycleCheck = () => h.activeQuarantineCount === 0;"
      ]
    },
    {
      "id": "PO-TEMPORAL", "target": "TokenBucket.update", "domain": "LIFECYCLE", "kind": "temporal_lifecycle", "oracle": "temporal_policy", "clockPolicy": "logical_clock",
      "prelude": [
        "const b = new TokenBucket(100n, 10, 'logical_clock');",
        "__temporalCheck = () => b.lastUpdateMs === 0n;"
      ]
    },
    {
      "id": "PO-DIGEST-IDENTITY", "target": "ClearingHouse.processBatch", "domain": "OBSERVABILITY", "kind": "generic_invariant", "oracle": "__leafA !== __leafB",
      "prelude": [
        "const h = new ClearingHouse();",
        "const __leafA = (h as any)._hashOrderLeaf({ id: 'a', senderId: 'sender-a', receiverId: 'receiver-a', amount: 10n, fee: 1n }, 0);",
        "const __leafB = (h as any)._hashOrderLeaf({ id: 'b', senderId: 'sender-b', receiverId: 'receiver-b', amount: 10n, fee: 1n }, 0);"
      ]
    },
    {
      "id": "PO-CHECKSUM-IDENTITY", "target": "ClearingHouse.registerAccount", "domain": "OBSERVABILITY", "kind": "generic_invariant", "oracle": "__checksum !== 0n",
      "prelude": [
        "const h = new ClearingHouse();",
        "h.registerAccount('checksum-a', 100n, 1000n, 0);",
        "h.registerAccount('checksum-b', 100n, 1000n, 0);",
        "const __checksum = h.globalChecksum;"
      ]
    }
  ]
}
