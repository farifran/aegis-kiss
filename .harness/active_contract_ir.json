          ],
          "returns": "bigint",
          "body": [
            "let cycleVolume = 0n;",
            "const ctx = { residuals, leafHashes, pMap };",
            "for (let i = 0; i < orders.length; i++) {",
            "  cycleVolume += this._searchTriangularRing(i, orders, ctx);",
            "}",
            "return cycleVolume;"
          ]
        },
        {
          "name": "_executePartialFill",
          "params": [
            {
              "name": "orders",
              "type": "readonly TransferIntent[]"
            },
            {
              "name": "matchedVolume",
              "type": "bigint"
            },
            {
              "name": "residuals",
              "type": "BigInt64Array"
            },
