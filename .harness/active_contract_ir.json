{
  "goal": "Implemente src/clearingHouse.ts com a classe ClearingHouse e a função obterClearingHouseBitmask. Adicione peekTokens em src/tokenBucket.ts e re-exporte no src/index.ts.",
  "targets": ["src/tokenBucket.ts", "src/clearingHouse.ts", "src/index.ts"],
  "imports": [],
  "types": [
    { "name": "TransferOrder", "shape": "{ id: string; senderId: string; receiverId: string; amount: bigint; fee: bigint; }" },
    { "name": "AccountState", "shape": "{ balance: bigint; bucket: TokenBucket; quarantined: boolean; }" },
    { "name": "BatchResult", "shape": "{ settledCount: number; rejectedCount: number; quarantinedCount: number; settledVolume: bigint; retainedFees: bigint; merkleRoot: bigint; rolledBack: boolean; }" }
  ],
  "exports": [
    {
      "kind": "class",
      "name": "TokenBucket",
      "privateFields": [
        { "name": "_maxTokens", "type": "bigint", "readonly": true },
        { "name": "_rateBitsPerMs", "type": "bigint", "readonly": true },
        { "name": "_tokens", "type": "bigint" },
        { "name": "_lastUpdateMs", "type": "bigint" }
      ],
      "ctorParams": [
        { "name": "maxBytes", "type": "bigint" },
        { "name": "mbps", "type": "number" }
      ],
      "ctorBody": [
        "if (maxBytes < 0n) throw new RangeError('maxBytes must be non-negative');",
        "if (!Number.isFinite(mbps) || mbps < 0) throw new RangeError('mbps must be a non-negative finite number');",
        "this._maxTokens = maxBytes * 8n;",
        "this._rateBitsPerMs = BigInt(Math.round(mbps * 8000));",
        "this._tokens = this._maxTokens;",
        "this._lastUpdateMs = BigInt(Date.now());"
      ],
      "methods": [
        {
          "name": "update",
          "params": [{ "name": "nowMs?", "type": "bigint" }],
          "returns": "void",
          "body": [
            "const now = nowMs !== undefined ? nowMs : BigInt(Date.now());",
            "if (now <= this._lastUpdateMs) return;",
            "const timeDiff = now - this._lastUpdateMs;",
            "this._lastUpdateMs = now;",
            "if (this._rateBitsPerMs > 0n) {",
            "  const replenished = this._tokens + timeDiff * this._rateBitsPerMs;",
            "  this._tokens = replenished > this._maxTokens ? this._maxTokens : replenished;",
            "}"
          ]
        },
        {
          "name": "consume",
          "params": [
            { "name": "bits", "type": "bigint" },
            { "name": "nowMs?", "type": "bigint" }
          ],
          "returns": "boolean",
          "body": [
            "if (bits < 0n) throw new RangeError('bits must be non-negative');",
            "this.update(nowMs);",
            "if (this._tokens >= bits) {",
            "  this._tokens = this._tokens - bits;",
            "  return true;",
            "}",
            "return false;"
          ]
        },
        {
          "name": "peekTokens",
          "params": [{ "name": "nowMs?", "type": "bigint" }],
          "returns": "bigint",
          "body": [
            "const now = nowMs !== undefined ? nowMs : BigInt(Date.now());",
            "if (now <= this._lastUpdateMs || this._rateBitsPerMs <= 0n) return this._tokens;",
            "const timeDiff = now - this._lastUpdateMs;",
            "const replenished = this._tokens + timeDiff * this._rateBitsPerMs;",
            "return replenished > this._maxTokens ? this._maxTokens : replenished;"
          ]
        }
      ],
      "getters": [
        { "name": "tokens", "returns": "bigint", "body": "return this._tokens;" },
        { "name": "maxTokens", "returns": "bigint", "body": "return this._maxTokens;" },
        { "name": "rateBitsPerMs", "returns": "bigint", "body": "return this._rateBitsPerMs;" },
        { "name": "lastUpdateMs", "returns": "bigint", "body": "return this._lastUpdateMs;" },
        { "name": "refillActive", "returns": "boolean", "body": "return this._tokens < this._maxTokens;" }
      ]
    },
    {
      "kind": "function",
      "name": "obterEstadoBitmask",
      "params": [{ "name": "bucket", "type": "TokenBucket" }],
      "returns": "number",
      "body": [
        "let mask = 0;",
        "if (bucket.tokens === 0n) mask = mask | 1;",
        "if (bucket.refillActive) mask = mask | 2;",
        "return mask;"
      ]
    },
    {
      "kind": "class",
      "name": "ClearingHouse",
      "privateFields": [
        { "name": "_accounts", "type": "Map<string, AccountState>", "readonly": true },
        { "name": "_isLocked", "type": "boolean", "readonly": false },
        { "name": "_lastRollback", "type": "boolean", "readonly": false },
        { "name": "_totalSettledVolume", "type": "bigint", "readonly": false },
        { "name": "_totalRetainedFees", "type": "bigint", "readonly": false },
        { "name": "_quarantineCount", "type": "number", "readonly": false },
        { "name": "_rejectedCount", "type": "number", "readonly": false },
        { "name": "_lastMerkleRoot", "type": "bigint", "readonly": false },
        { "name": "_globalChecksum", "type": "bigint", "readonly": false }
      ],
      "ctorParams": [],
      "ctorBody": [
        "this._accounts = new Map();",
        "this._isLocked = false;",
        "this._lastRollback = false;",
        "this._totalSettledVolume = 0n;",
        "this._totalRetainedFees = 0n;",
        "this._quarantineCount = 0;",
        "this._rejectedCount = 0;",
        "this._lastMerkleRoot = 0n;",
        "this._globalChecksum = 0n;"
      ],
      "methods": [
        {
          "name": "registerAccount",
          "params": [
            { "name": "accountId", "type": "string" },
            { "name": "initialBalance", "type": "bigint" },
            { "name": "maxBytes", "type": "bigint" },
            { "name": "mbps", "type": "number" }
          ],
          "returns": "void",
          "body": [
            "if (!accountId) throw new TypeError('accountId required');",
            "if (initialBalance < 0n) throw new RangeError('initialBalance must be non-negative');",
            "const bucket = new TokenBucket(maxBytes, mbps);",
            "this._accounts.set(accountId, { balance: initialBalance, bucket, quarantined: false });",
            "this._globalChecksum = (this._globalChecksum ^ BigInt(initialBalance)) & 0xFFFFFFFFFFFFFFFFn;"
          ]
        },
        {
          "name": "processBatch",
          "params": [
            { "name": "orders", "type": "readonly TransferOrder[]" },
            { "name": "nowMs?", "type": "bigint" }
          ],
          "returns": "BatchResult",
          "body": [
            "const now = nowMs !== undefined ? nowMs : BigInt(Date.now());",
            "let settledCount = 0;",
            "let rejectedCount = 0;",
            "let quarantinedCount = 0;",
            "let settledVolume = 0n;",
            "let retainedFees = 0n;",
            "this._lastRollback = false;",
            "if (this._isLocked) {",
            "  return { settledCount: 0, rejectedCount: orders.length, quarantinedCount: 0, settledVolume: 0n, retainedFees: 0n, merkleRoot: this._lastMerkleRoot, rolledBack: false };",
            "}",
            "const snapshot = new Map<string, bigint>();",
            "for (const [id, acc] of this._accounts.entries()) {",
            "  snapshot.set(id, acc.balance);",
            "}",
            "let initialSum = 0n;",
            "for (const b of snapshot.values()) { initialSum = initialSum + b; }",
            "const validOrders: TransferOrder[] = [];",
            "for (const ord of orders) {",
            "  if (ord.amount <= 0n || ord.fee < 0n) { rejectedCount++; continue; }",
            "  const sender = this._accounts.get(ord.senderId);",
            "  const receiver = this._accounts.get(ord.receiverId);",
            "  if (!sender || !receiver || sender.quarantined) { rejectedCount++; continue; }",
            "  const requiredBits = (ord.amount + ord.fee) * 8n;",
            "  if (!sender.bucket.consume(requiredBits, now)) {",
            "    sender.quarantined = true;",
            "    quarantinedCount++;",
            "    rejectedCount++;",
            "    continue;",
            "  }",
            "  const totalDebit = ord.amount + ord.fee;",
            "  if (sender.balance < totalDebit) {",
            "    rejectedCount++;",
            "    continue;",
            "  }",
            "  sender.balance = sender.balance - totalDebit;",
            "  receiver.balance = receiver.balance + ord.amount;",
            "  retainedFees = retainedFees + ord.fee;",
            "  settledVolume = settledVolume + ord.amount;",
            "  settledCount++;",
            "  validOrders.push(ord);",
            "}",
            "let finalSum = retainedFees;",
            "for (const acc of this._accounts.values()) { finalSum = finalSum + acc.balance; }",
            "if (initialSum !== finalSum) {",
            "  for (const [id, bal] of snapshot.entries()) {",
            "    const acc = this._accounts.get(id);",
            "    if (acc) acc.balance = bal;",
            "  }",
            "  this._lastRollback = true;",
            "  return { settledCount: 0, rejectedCount: orders.length, quarantinedCount, settledVolume: 0n, retainedFees: 0n, merkleRoot: 0n, rolledBack: true };",
            "}",
            "let merkle = 0xcbf29ce484222325n;",
            "const fnvPrime = 0x100000001b3n;",
            "for (const ord of validOrders) {",
            "  merkle = (merkle ^ ord.amount) * fnvPrime & 0xFFFFFFFFFFFFFFFFn;",
            "  merkle = (merkle ^ ord.fee) * fnvPrime & 0xFFFFFFFFFFFFFFFFn;",
            "}",
            "this._totalSettledVolume = this._totalSettledVolume + settledVolume;",
            "this._totalRetainedFees = this._totalRetainedFees + retainedFees;",
            "this._quarantineCount = quarantinedCount;",
            "this._rejectedCount = rejectedCount;",
            "this._lastMerkleRoot = merkle;",
            "this._globalChecksum = (this._globalChecksum ^ merkle ^ finalSum) & 0xFFFFFFFFFFFFFFFFn;",
            "return { settledCount, rejectedCount, quarantinedCount, settledVolume, retainedFees, merkleRoot: merkle, rolledBack: false };"
          ]
        }
      ],
      "getters": [
        { "name": "isLocked", "returns": "boolean", "body": "return this._isLocked;" },
        { "name": "lastRollback", "returns": "boolean", "body": "return this._lastRollback;" },
        { "name": "totalSettledVolume", "returns": "bigint", "body": "return this._totalSettledVolume;" },
        { "name": "totalRetainedFees", "returns": "bigint", "body": "return this._totalRetainedFees;" },
        { "name": "quarantineCount", "returns": "number", "body": "return this._quarantineCount;" },
        { "name": "rejectedCount", "returns": "number", "body": "return this._rejectedCount;" },
        { "name": "lastMerkleRoot", "returns": "bigint", "body": "return this._lastMerkleRoot;" },
        { "name": "globalChecksum", "returns": "bigint", "body": "return this._globalChecksum;" }
      ]
    },
    {
      "kind": "function",
      "name": "obterClearingHouseBitmask",
      "params": [{ "name": "house", "type": "ClearingHouse" }],
      "returns": "bigint",
      "body": [
        "let mask = 0n;",
        "if (house.isLocked) mask = mask | 1n;",
        "if (house.quarantineCount > 0) mask = mask | 2n;",
        "if (house.lastRollback) mask = mask | 4n;",
        "if (house.totalSettledVolume > 10000000n) mask = mask | 8n;",
        "const q = BigInt(house.quarantineCount > 63 ? 63 : house.quarantineCount);",
        "mask = mask | ((q & 63n) << 4n);",
        "const r = BigInt(house.rejectedCount > 63 ? 63 : house.rejectedCount);",
        "mask = mask | ((r & 63n) << 10n);",
        "const top16 = (house.lastMerkleRoot >> 48n) & 65535n;",
        "mask = mask | ((top16 & 65535n) << 16n);",
        "const low32 = house.globalChecksum & 4294967295n;",
        "mask = mask | ((low32 & 4294967295n) << 32n);",
        "return mask;"
      ]
    }
  ],
  "barrelFile": "src/index.ts",
  "barrelFrom": "./clearingHouse.js",
  "questions": [],
  "behavior": [
    {
      "desc": "peekTokens projects token balance without mutating cursor",
      "exports": ["TokenBucket"],
      "prelude": [
        "const b = new TokenBucket(100n, 1);",
        "const t0 = b.lastUpdateMs;",
        "b.consume(400n, t0);",
        "const peeked = b.peekTokens(t0 + 10n);"
      ],
      "assert": "b.tokens === 400n && b.lastUpdateMs === t0 && peeked > 400n"
    },
    {
      "desc": "ClearingHouse settles valid multilateral batch conserving total balance",
      "exports": ["ClearingHouse", "obterClearingHouseBitmask"],
      "prelude": [
        "const ch = new ClearingHouse();",
        "ch.registerAccount('alice', 1000n, 1000n, 100);",
        "ch.registerAccount('bob', 500n, 1000n, 100);",
        "const res = ch.processBatch([{ id: 'tx1', senderId: 'alice', receiverId: 'bob', amount: 300n, fee: 10n }]);"
      ],
      "assert": "res.settledCount === 1 && res.settledVolume === 300n && res.retainedFees === 10n && res.rolledBack === false"
    },
    {
      "desc": "ClearingHouse bitmask reflects telemetry and state correctly",
      "exports": ["ClearingHouse", "obterClearingHouseBitmask"],
      "prelude": [
        "const ch = new ClearingHouse();",
        "ch.registerAccount('alice', 100n, 10n, 1);",
        "ch.registerAccount('bob', 100n, 10n, 1);",
        "ch.processBatch([{ id: 'tx1', senderId: 'alice', receiverId: 'bob', amount: 5000n, fee: 0n }]);",
        "const mask = obterClearingHouseBitmask(ch);"
      ],
      "assert": "(mask & 2n) === 2n && ch.quarantineCount === 1"
    }
  ],
  "proofObligations": [
    {
      "id": "PROOF-CLEARINGHOUSE-CONSERVATION-ZERO-SUM",
      "invariant": "INV-CLEARINGHOUSE-CONSERVATION",
      "prelude": [
        "const ch = new ClearingHouse();",
        "ch.registerAccount('a', 1000n, 1000n, 10);",
        "ch.registerAccount('b', 1000n, 1000n, 10);",
        "const res = ch.processBatch([{ id: '1', senderId: 'a', receiverId: 'b', amount: 200n, fee: 5n }]);"
      ],
      "oracle": "res.rolledBack === false && res.settledVolume === 200n && res.retainedFees === 5n"
    },
    {
      "id": "PROOF-PEEK-TOKENS-IMMUTABILITY",
      "invariant": "INV-PEEK-TOKENS-PURE",
      "prelude": [
        "const b = new TokenBucket(500n, 2);",
        "const beforeTokens = b.tokens;",
        "const beforeUpdate = b.lastUpdateMs;",
        "b.peekTokens(beforeUpdate + 5000n);"
      ],
      "oracle": "b.tokens === beforeTokens && b.lastUpdateMs === beforeUpdate"
    }
  ],
  "performanceContract": {
    "hotPath": ["processBatch", "peekTokens", "obterClearingHouseBitmask"],
    "maxHeapAllocations": 0
  },
  "preconditions": [
    { "target": "initialBalance", "require": "initialBalance >= 0n", "error": "RangeError", "message": "initialBalance must be non-negative" },
    { "target": "amount", "require": "amount > 0n", "error": "RangeError", "message": "amount must be positive" },
    { "target": "fee", "require": "fee >= 0n", "error": "RangeError", "message": "fee must be non-negative" }
  ],
  "invariants": [
    { "id": "INV-CLEARINGHOUSE-CONSERVATION", "predicate": "initialBalances === finalBalances + retainedFees", "checkedAfter": ["processBatch"] },
    { "id": "INV-PEEK-TOKENS-PURE", "predicate": "peekTokens does not mutate bucket state", "checkedAfter": ["peekTokens"] }
  ],
  "postconditions": [
    { "method": "processBatch", "guarantee": "zero-sum balance conservation across all participants" }
  ]
}
