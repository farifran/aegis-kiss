            "  throw new Error('Conservation violation: initial != cycle + partial + residual');",
            "}",
            "return {",
            "  settledVolume,",
            "  cycleVolume: totalCycle,",
            "  fractionalVolume,",
            "  settledParticipantsCount: pMap.size,",
            "  residualOrdersCount: remainingResidualCount,",
