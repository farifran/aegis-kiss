      "methods": [
        {
          "name": "_fnv1a64",
          "params": [
            {
              "name": "str",
              "type": "string"
            }
          ],
          "returns": "bigint",
          "body": [
            "let hash = 14695981039346656037n;",
            "for (let s = 0; s < str.length; s++) {",
            "  hash = ((hash ^ BigInt(str.charCodeAt(s) & 255)) * 1099511628211n) & 0xFFFFFFFFFFFFFFFFn;",
            "}",
            "return hash;"
          ]
        },
        {
          "name": "_computeMerkleRoot",
          "params": [
            {
              "name": "leaves",
              "type": "readonly bigint[]"
            }
          ],
          "returns": "bigint",
          "body": [
            "if (leaves.length === 0) return 0n;",
            "let len = leaves.length;",
            "const tree = new BigUint64Array(len);",
            "for (let i = 0; i < len; i++) {",
            "  const leaf = leaves[i];",
            "  if (leaf !== undefined) tree[i] = leaf;",
            "}",
            "while (len > 1) {",
            "  let nextLen = 0;",
            "  for (let i = 0; i < len; i += 2) {",
            "    const left = tree[i] ?? 0n;",
            "    const right = i + 1 < len ? (tree[i + 1] ?? left) : left;",
            "    const combined = (((left ^ (right >> 32n)) * 1099511628211n) ^ right) & 0xFFFFFFFFFFFFFFFFn;",
            "    tree[nextLen] = combined;",
            "    nextLen++;",
            "  }",
            "  len = nextLen;",
            "}",
            "return tree[0] ?? 0n;"
          ]
        },
        {
          "name": "_matchBilateralLeg",
          "params": [
            {
              "name": "ordA",
              "type": "TransferIntent"
            },
            {
              "name": "ordB",
              "type": "TransferIntent"
            },
            {
              "name": "resA",
              "type": "bigint"
            },
            {
              "name": "resB",
              "type": "bigint"
            }
          ],
          "returns": "bigint",
          "body": [
            "if (ordA.from !== ordB.to || ordA.to !== ordB.from) return 0n;",
            "return resA < resB ? resA : resB;"
          ]
        },
        {
          "name": "_resolveBilateralCycles",
          "params": [
            {
              "name": "orders",
              "type": "readonly TransferIntent[]"
            },
            {
