            "const n = orders.length;",
            "let volume = 0n;",
            "for (let j = 0; j < n; j++) {",
            "  if (i === j) continue;",
            "  const ordB = orders[j];",
            "  const resB = ctx.residuals[j] ?? 0n;",
            "  if (ordB === undefined || resB <= 0n || ordA.to !== ordB.from) continue;",
            "  volume += this._searchTriangleK(i, j, orders, ctx);",
            "}",
            "return volume;"
          ]
