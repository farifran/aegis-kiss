{"goal":"Crie src/tokenBucket.ts com a classe TokenBucket e a função obterEstadoBitmask. Re-exporte no src/index.ts.","targets":["src/tokenBucket.ts","src/index.ts"],"imports":[],"types":[],"exports":[{"kind":"class","name":"TokenBucket","privateFields":[{"name":"_maxTokens","type":"bigint","readonly":true},{"name":"_rateBitsPerMs","type":"bigint","readonly":true},{"name":"_tokens","type":"bigint"},{"name":"_lastUpdateMs","type":"bigint"}],"ctorParams":[{"name":"maxBytes","type":"bigint"},{"name":"mbps","type":"number"}],"ctorBody":["if (maxBytes <= 0n) throw new RangeError('maxBytes must be positive');","if (!Number.isFinite(mbps) || mbps <= 0) throw new RangeError('mbps must be positive');","this._maxTokens = maxBytes * 8n;","this._rateBitsPerMs = BigInt(Math.round(mbps * 8000));","this._tokens = this._maxTokens;","this._lastUpdateMs = BigInt(Date.now());"],"methods":[{"name":"update","params":[{"name":"nowMs?","type":"bigint"}],"returns":"void","body":["const now = nowMs !== undefined ? nowMs : BigInt(Date.now());","if (now <= this._lastUpdateMs) return;","const timeDiff = now - this._lastUpdateMs;","const accumulated = timeDiff * this._rateBitsPerMs;","this._tokens = this._tokens + accumulated;","if (this._tokens > this._maxTokens) this._tokens = this._maxTokens;","this._lastUpdateMs = now;"]},{"name":"consume","params":[{"name":"bits","type":"bigint"},{"name":"nowMs?","type":"bigint"}],"returns":"boolean","body":["if (bits < 0n) throw new RangeError('bits must be non-negative');","this.update(nowMs);","if (this._tokens >= bits) {","  this._tokens = this._tokens - bits;","  return true;","}","return false;"]}],"getters":[{"name":"tokens","returns":"bigint","body":"return this._tokens;"},{"name":"maxTokens","returns":"bigint","body":"return this._maxTokens;"},{"name":"rateBitsPerMs","returns":"bigint","body":"return this._rateBitsPerMs;"},{"name":"lastUpdateMs","returns":"bigint","body":"return this._lastUpdateMs;"}],"body":[]},{"kind":"function","name":"obterEstadoBitmask","params":[{"name":"bucket","type":"TokenBucket"}],"returns":"number","body":["let mask = 0;","if (bucket.tokens >= bucket.maxTokens) mask = mask | 1;","if (bucket.tokens === 0n) mask = mask | 2;","if (bucket.tokens * 2n >= bucket.maxTokens) mask = mask | 4;","const pct = Number((bucket.tokens * 63n) / bucket.maxTokens);","mask = mask | ((pct & 63) << 3);","return mask;"],"ctorBody":[],"methods":[],"getters":[]}],"barrelFile":"src/index.ts","barrelFrom":"./tokenBucket.js","questions":[],"behavior":[{"desc":"Initialize TokenBucket with correct maxTokens, rateBitsPerMs and full balance","exports":["TokenBucket","obterEstadoBitmask"],"prelude":["const bucket = new TokenBucket(1000n, 10);"],"assert":"bucket.maxTokens === 8000n && bucket.tokens === 8000n && bucket.rateBitsPerMs === 80000n && (obterEstadoBitmask(bucket) & 1) === 1"},{"desc":"Consume tokens and update balance with monotonic time refill","exports":["TokenBucket","obterEstadoBitmask"],"prelude":["const bucket = new TokenBucket(100n, 1);","const t0 = bucket.lastUpdateMs;","const ok = bucket.consume(400n, t0);","bucket.update(t0 + 10n);"],"assert":"ok === true && bucket.tokens === 400n + (10n * 8000n > 400n ? 400n : 10n * 8000n)"},{"desc":"Bitmask indicates empty when all tokens consumed","exports":["TokenBucket","obterEstadoBitmask"],"prelude":["const bucket = new TokenBucket(100n, 1);","const t0 = bucket.lastUpdateMs;","bucket.consume(800n, t0);","const mask = obterEstadoBitmask(bucket);"],"assert":"bucket.tokens === 0n && (mask & 2) === 2"}],"proofObligations":[{"id":"PROOF-TOKEN-CAP-INVARIANT","invariant":"INV-TOKENS-BOUNDED","prelude":["const bucket = new TokenBucket(500n, 2);","bucket.update(bucket.lastUpdateMs + 10000n);"],"oracle":"bucket.tokens <= bucket.maxTokens && bucket.tokens === bucket.maxTokens"},{"id":"PROOF-CLOCK-SKEW-IMMUNITY","invariant":"INV-MONOTONIC-CLOCK","prelude":["const bucket = new TokenBucket(500n, 2);","const last = bucket.lastUpdateMs;","bucket.update(last - 1000n);"],