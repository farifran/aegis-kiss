          ],
          "returns": "bigint",
          "body": [
            "if (ordA.to !== ordB.from || ordB.to !== ordC.from || ordC.to !== ordA.from) return 0n;",
            "let minFlow = res.resA;",
            "if (res.resB < minFlow) minFlow = res.resB;",
            "if (res.resC < minFlow) minFlow = res.resC;",
            "return minFlow;"
          ]
        },
        {
          "name": "_checkTriangleAtJK",
