{
  "schema": "aegis.proof_registry.v1",
  "policy": {
    "mode": "enforced",
    "maxActiveProofsPerProfile": {
      "fast": 3,
      "targeted": 7,
      "release": 8,
      "forensic": 12
    }
  },
  "profiles": [
    { "id": "fast", "proofIds": ["PO-TYPE-001", "PO-REORG-REVOKE-001", "PO-IDEMPOTENCY-001"] },
    { "id": "targeted", "proofIds": ["PO-TYPE-001", "PO-FAIL-001", "PO-REORG-REVOKE-001", "PO-IDEMPOTENCY-001", "PO-RECOVERY-001", "PO-ADVERSARIAL-001", "PO-INVARIANT-001"] },
    { "id": "release", "proofIds": ["PO-TYPE-001", "PO-FAIL-001", "PO-REORG-REVOKE-001", "PO-IDEMPOTENCY-001", "PO-RECOVERY-001", "PO-WAL-001", "PO-ADVERSARIAL-001", "PO-INVARIANT-001"] },
    { "id": "forensic", "proofIds": ["PO-TYPE-001", "PO-FAIL-001", "PO-REORG-REVOKE-001", "PO-IDEMPOTENCY-001", "PO-RECOVERY-001", "PO-WAL-001", "PO-ADVERSARIAL-001", "PO-INVARIANT-001", "PO-BENCHMARK-001"] }
  ],
