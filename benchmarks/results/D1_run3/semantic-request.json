pe":["object","null"]},"rollback":{"$ref":"#/$defs/shared37"}},"required":["name","description","guardPrecedence","parameters","branches","rollback","noGuardsRationale","returnContract","executionModel"],"type":"object"},"type":"array"}},"required":["entities","operations","observables","canonicalSerializations"],"type":"object"},{"type":"null"}]},"title":{"minLength":1,"type":"string"},"unknowns":{"items":{"additionalProperties":false,"properties":{"basis":{"$ref":"#/$defs/shared4"},"decisionIndex":{"minimum":0,"type":["integer","null"]},"fragmentIndexes":{"items":{"minimum":0,"type":"integer"},"minItems":1,"type":"array"},"material":{"type":"boolean"},"statement":{"minLength":1,"type":"string"}},"required":["statement","material","decisionIndex","fragmentIndexes","basis"],"type":"object"},"type":"array"}},"required":["title","interpretation","changeKind","scope","intentClaims","nonNormativeItems","pathReferences","architectureContexts","policyAssessments","complexityReview","requirements","invariants","riskReview","risks","adversarialReview","determinismReview","boundaryRules","unknowns","decisions","stateModel"],"type":"object"},"id":"aegis.semantic_opinion.v3","strict":true},"policy":{"amendments":[],"contexts":[{"description":"A demanda define comportamento ou fronteira pública do produto.","tag":"product-demand"},{"description":"A demanda cita ou depende de caminhos do produto.","tag":"product-path"},{"description":"A demanda altera ou define estado persistente do harness.","tag":"harness-state"},{"description":"A demanda altera ou define dados transitórios do harness.","tag":"harness-runtime"},{"description":"A demanda altera o núcleo mecânico do harness.","tag":"harness-core"},{"description":"A demanda conecta um provedor externo ou modelo ao harness.","tag":"provider-integration"},{"description":"A demanda exige uma forma técnica específica em TypeScript.","tag":"typescript-form"},{"description":"A demanda solicita dependência externa.","tag":"dependency"},{"description":"A demanda solicita persistência de dados.","tag":"persistence"},{"description":"A demanda solicita concorrência ou paralelismo observável.","tag":"concurrency"},{"description":"A demanda solicita camadas, abstrações ou extensibilidade estrutural.","tag":"structural-complexity"},{"description":"O comportamento público altera estado.","tag":"stateful-operation"},{"description":"O comportamento público produz efeito fora do processo.","tag":"external-effect"},{"description":"O resultado público depende de tempo ou relógio.","tag":"time-dependent"},{"description":"A demanda expõe divisão inteira ou aritmética BigInt.","tag":"integer-arithmetic"},{"description":"A demanda codifica contadores limitados em observabilidade pública.","tag":"bounded-observability"},{"description":"A demanda expõe hash, fingerprint ou raiz pública de integridade.","tag":"integrity-hash"},{"description":"A demanda exige função, API ou export público.","tag":"public-interface"}],"rules":[{"appliesMode":"any","appliesWhen":["product-demand","product-path"],"forbiddenReferences":[],"id":"ARCH-PRODUCT-BOUNDARY","level":"hard","reviewReferences":["src/"],"statement":"Uma demanda de produto observa e cita exclusivamente src/ como fonte do produto, e requisitos de produto não podem alterar o harness."},{"appliesMode":"any","appliesWhen":["harness-state","harness-runtime"],"forbiddenReferences":[],"id":"ARCH-HARNESS-STATE","level":"hard","reviewReferences":[".harness/state/",".harness/runtime/",".harness/config/roles.json"],"statement":"O estado semântico persistente do harness reside em .harness/state/semantic-state.json; dados transitórios residem em .harness/runtime/. A atribuição local de adaptadores reside em .harness/config/roles.json, não contém segredos e nunca é fonte de verdade do produto."},{"appliesMode":"any","appliesWhen":["harness-core","provider-integration"],"forbiddenReferences":[],"id":"ARCH-LOCAL-DETERMINISTIC-CORE","level":"hard","reviewReferences":["provedor de modelo"],"statement":"O core mecânico opera localmente, de forma determinística e sem dependência de rede ou de um provedor de modelo. Integrações externas pertencem a adaptadores."},{"appliesMode":"any","appliesWhen":["typescript-form"],"forbiddenReferences":["any","@ts-ignore"],"id":"ARCH-STRICT-EXPLICIT-MODULES","level":"default","reviewReferences":["TypeScript"],"statement":"Código TypeScript usa tipagem estrita, módulos pequenos e APIs explícitas, sem supressões permissivas que escondam falhas ou contratos públicos."},{"appliesMode":"any","appliesWhen":["dependency","persistence","concurrency","structural-complexity"],"forbiddenReferences":[],"id":"ARCH-PARSIMONY","level":"default","reviewReferences":["classe abstrata","classes abstratas","injeção de dependências","factory","factories","decorador","decoradores"],"statement":"Dependências, persistência, concorrência, camadas e pontos de extensão só são admitidos quando um requisito observável justificar seu custo. A alternativa recomendada deve ser a menor arquitetura suficiente."},{"appliesMode":"any","appliesWhen":["stateful-operation","external-effect"],"forbiddenReferences":["try/catch","catch vazio"],"id":"ARCH-FAILURE-EXPLICIT","level":"hard","reviewReferences":["rollback"],"statement":"Nenhuma falha relevante pode desaparecer silenciosamente; a operação deve expor resultado, erro explícito, estado preservado ou rollback verificável."},{"appliesMode":"any","appliesWhen":["time-dependent"],"forbiddenReferences":["Date.now"],"id":"ARCH-DETERMINISTIC-TIME","level":"hard","reviewReferences":["relógio"],"statement":"Comportamento que depende de tempo deve receber uma referência temporal explícita ou usar uma fonte reproduzível. O relógio do sistema não pode alterar o resultado de forma implícita; uma exceção requer emenda arquitetural aprovada."},{"appliesMode":"any","appliesWhen":["integer-arithmetic"],"forbiddenReferences":[],"id":"ARCH-BIGINT-ARITHMETIC","level":"hard","reviewReferences":["BigInt"],"statement":"Quando uma demanda TypeScript ou JavaScript usa a divisão nativa de `BigInt` sem exigir outra política, o resultado trunca em direção a zero e divisor zero produz rejeição explícita. Esses comportamentos são fatos mecânicos da plataforma e não criam decisões para o Wizard. Divisão inteira não define, por si só, o destino de restos nem autoriza redistribuição, descarte ou rejeição da operação. Quando esse efeito altera o resultado público, ele precisa estar explícito na intenção, em decisão humana ou em política aplicável."},{"appliesMode":"any","appliesWhen":["bounded-observability"],"forbiddenReferences":["wrap"],"id":"ARCH-OBSERVABILITY-COUNTERS","level":"default","reviewReferences":["bitmask","telemetria"],"statement":"Campos públicos de contagem sem sinal usados somente para observabilidade rejeitam valores negativos e saturam no maior valor representável quando a demanda não define outra política. Wrap ou truncamento silencioso são proibidos porque falseiam a telemetria."},{"appliesMode":"any","appliesWhen":["integrity-hash"],"forbiddenReferences":[],"id":"ARCH-HASH-SECURITY-LABEL","level":"hard","reviewReferences":["criptográfica","criptográfico","hash","fingerprint"],"statement":"Um fingerprint determinístico não criptográfico não pode ser apresentado como garantia criptográfica. Quando a propriedade de segurança exigida for incompatível com a primitiva, a largura ou uma projeção solicitada, o preflight deve reabrir esses pontos em vez de aplicar a escolha silenciosamente. Enquanto houver decisão pendente, requisitos e riscos usam terminologia neutra de integridade."},{"appliesMode":"any","appliesWhen":["public-interface"],"forbiddenReferences":[],"id":"ARCH-PUBLIC-INTERFACE","level":"hard","reviewReferences":["função pública","função pura","re-exportadas"],"statement":"Toda função pública exigida pelo contrato possui entradas, saídas e falhas observáveis definidas. Quando a intenção não fornece uma assinatura explícita, o modelo pode propor a interface pública mínima e suficiente estritamente derivada dos observáveis da demanda, declarando-a no contrato para deliberação humana; interfaces especulativas ou sobre-engenharia permanecem proibidas."},{"appliesMode":"any","appliesWhen":["product-demand","harness-core"],"forbiddenReferences":[],"id":"ARCH-CONTRACT-CONSISTENCY","level":"hard","reviewReferences":[],"statement":"Um contrato não pode declarar a mesma propriedade simultaneamente fechada e dependente de decisão humana. Invariantes, casos de aceitação, limites, riscos e alternativas devem ser mutuamente compatíveis, e um risco não pode substituir a resolução de uma contradição semântica. Texto normativo permanece neutro enquanto uma decisão puder alterar a propriedade. Alternativas que mudam apenas um detalhe interno sem alterar resultados observáveis não formam decisão; opções incompatíveis reabrem o preflight. Decisões dependentes são avaliadas em conjunto, e nenhuma recomendação pode descartar entrada silenciosamente. Uma função pública declarada pura exige caso metamórfico que demonstre que chamadas de observação não alteram o comportamento de uma operação posterior."},{"appliesMode":"any","appliesWhen":["stateful-operation"],"forbiddenReferences":[],"id":"ARCH-STATE-TRANSITION-TOTALITY","level":"hard","reviewReferences":["guards","precedência","reset","estado inicial"],"statement":"Operações que leem ou alteram estado devem definir a transição total: precedência determinística de guards (curto-circuito sem efeitos posteriores), valor inicial no primeiro uso, gatilhos de mutação e condições de reset. Nenhuma implementação pode escolher a ordem de verificação de erros ou inferir valores iniciais não contratados."},{"appliesMode":"any","appliesWhen":["time-dependent"],"forbiddenReferences":[],"id":"ARCH-TEMPORAL-INVARIANCE","level":"hard","reviewReferences":["carry","remainder","frequência","amostragem"],"statement":"Comportamento que acumula grandezas com base em tempo decorrido deve preservar frações residuais de tempo (carry/remainder). O resultado de N chamadas com intervalos menores deve ser algebricamente equivalente a uma única chamada com o intervalo acumulado, vedando perda de precisão ou descarte dependente da taxa de amostragem."},{"appliesMode":"any","appliesWhen":["integrity-hash"],"forbiddenReferences":[],"id":"ARCH-CANONICAL-DIGEST-REPRESENTATION","level":"hard","reviewReferences":["payload","encoding","offset basis","vazio"],"statement":"Todo cálculo de hash, digest ou fingerprint de integridade sobre estruturas de memória deve definir o payload canônico exato: campos incluídos, ordem, encoding binário/length-prefixed e o valor canônico do estado vazio (respeitando o offset basis da primitiva ou sentinela contratado). Duas ordens ou serializações diferentes não podem ser permitidas."},{"appliesMode":"any","appliesWhen":["product-demand","harness-core"],"forbiddenReferences":[],"id":"ARCH-MINIMAL-SUFFICIENT-CLOSURE","level":"hard","reviewReferences":[],"statement":"O contrato deve possuir somente as estruturas, modelos e decisões necessários para tornar todos os observáveis demandados computáveis e falsificáveis. Não deve exigir State Model, Transaction Model, Identity Graph ou decisão humana quando a propriedade não se aplica à demanda ou pode ser derivada mecanicamente a partir de premissas autorizadas. Ausência de estado, de transações ou de efeitos externos em computações puras não constitui lacuna. Propriedades deriváveis fecham citando a premissa autorizada sem criar decisões redundantes. Decisões humanas reservam-se exclusivamente a lacunas materiais com alternativas públicas divergentes compatíveis com as fontes autorizadas."}]},"requestDigest":"a1065ed8554c203b865618e724f812ad535eb1d1b33ff6a255fd9a329110133d","revision":null,"schema":"aegis.semantic_request.v10","workspace":{"lexicalEvidence":{"matches":[],"status":"NOT_APPLICABLE","termsTruncated":false},"observedTextPaths":[],"sourceEvidence":[],"status":"EMPTY_SOURCE","unavailablePaths":[]}}
