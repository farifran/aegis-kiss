#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
bash "${ROOT_DIR}/scripts/contract_evidence_gate.sh" --staged

if bash "${ROOT_DIR}/scripts/formal_promotion_authorization.sh" requires "${ROOT_DIR}"; then
  exec bash "${ROOT_DIR}/scripts/formal_promotion_authorization.sh" verify "${ROOT_DIR}"
fi
