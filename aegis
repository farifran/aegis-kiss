cmd_squash() {
  local issue="${1:-}"
  if [[ -z "${issue}" ]]; then
    # Auto-detect latest issue from git log
    issue="$(git log -n 20 --oneline | grep -oE 'issue#[0-9]+' | head -1 | sed 's/issue#//' || true)"
  fi
  if [[ -z "${issue}" ]]; then
    aegis_fatal "missing_issue — uso: ./aegis squash <issue_number>"
  fi

  local task_commits
  task_commits="$(git log -n 30 --oneline | grep -E "aegis: issue#${issue} task " | cut -d' ' -f1 || true)"
  local n_commits
  n_commits="$(printf '%s\n' "${task_commits}" | grep -c . || true)"
  if [[ "${n_commits}" -le 1 ]]; then
    aegis_log "squash: apenas ${n_commits} commit(s) atômico(s) encontrado(s) para a issue #${issue}; nada para fundir"
    return 0
  fi

  aegis_log "squash: a fundir ${n_commits} commits atômicos da issue #${issue} num commit consolidado de feature..."
  local parent_commit
  parent_commit="$(git rev-parse HEAD~"${n_commits}")"

  local msg_title="feat: implement issue #${issue}"
  local issue_file="${ISSUE_CACHE_DIR}/issue_${issue}.md"
  if [[ -f "${issue_file}" ]]; then
    local goal_text
    goal_text="$(awk '/^## Goal[[:space:]]*$/ { p=1; next } /^## / { p=0 } p' "${issue_file}" | tr '\n' ' ' | sed 's/[[:space:]]*$//' | head -c 80 || true)"
    if [[ -n "${goal_text}" ]]; then
      msg_title="feat: ${goal_text} (issue #${issue})"
    fi
  fi

  git reset --soft "${parent_commit}"
  git commit -m "${msg_title}" -m "Consolidated ${n_commits} atomic aegis micro-units for issue #${issue}."
  aegis_log "squash: consolidado com sucesso em $(git rev-parse --short HEAD) — ${msg_title}"
}

main() {
  local verb="${1:-}"
  case "${verb}" in
    --agent|--agentic|--assistant)
      export AEGIS_AGENTIC=1
      shift
      cmd_run "$@"
      ;;
    [0-9]*)
      # Pure issue number: ./aegis 207 -> ./aegis --issue 207
      cmd_run --issue "$@"
      ;;
    context) shift; cmd_context "$@" ;;
    split)   shift; cmd_split "$@" ;;
    setup)   shift; cmd_setup "$@" ;;
    squash)  shift; cmd_squash "$@" ;;
    ""|-h|--help) usage ;;
    *)       cmd_run "$@" ;;
  esac
}

# Sourceable so the contract tests can exercise the helpers directly.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
