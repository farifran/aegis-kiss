#!/usr/bin/env bash

# =========================================================
# AEGIS — OPERATOR / CODING-ASSISTANT ENTRY POINT
# =========================================================
#
# The product surface. run_aegis.sh stays the low-level tool
# used to build and test the harness itself.
#
# Default: one issue = one task = one target. When fit splits a monster
# demand, go runs a multi-unit batch: plan approval once, then per-unit
# checkpoint commits + issue task [x]. Failed unit K keeps 0..K-1.
#
# =========================================================

set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT}"

# Local secrets/models (gitignored). Load before briefing/intake so supervisor
# expand sees OPENAI_API_KEY and AEGIS_SUPERVISOR_MODEL without requiring a
# manual `export` in the operator shell. Skip under test-key sentinels.
if [[ "${AEGIS_SKIP_LOCAL_ENV:-0}" != "1" ]] \
  && [[ -f "${ROOT}/.harness/local.env" ]] \
  && [[ "${OPENAI_API_KEY:-}" != *test-key* ]]; then
  # shellcheck disable=SC1091
  set -a
  # shellcheck disable=SC1091
  source "${ROOT}/.harness/local.env"
  set +a
fi

# shellcheck disable=SC1091
source "${ROOT}/scripts/lib/common.sh"
# shellcheck disable=SC1091
source "${ROOT}/scripts/lib/record.sh"
# shellcheck disable=SC1091
source "${ROOT}/scripts/lib/demand.sh"
# shellcheck disable=SC1091
source "${ROOT}/scripts/lib/briefing.sh"

AEGIS_LOG_TAG="CLI"

readonly RUNTIME_DIR="${ROOT}/.harness/runtime"
readonly OUTCOME_FILE="${RUNTIME_DIR}/last_outcome.json"
readonly ISSUE_CACHE_DIR="${RUNTIME_DIR}/issue_cache"
readonly COMMIT_MSG_FILE="${RUNTIME_DIR}/commit.msg"
readonly DRAFT_FILE="${RUNTIME_DIR}/draft.md"
readonly MICROS_DIR="${ROOT}/.harness/micros_auto"
readonly MICROS_MANUAL_DIR="${ROOT}/.harness/micros"

usage() {
  cat <<'EOF'
Usage:
  ./aegis "<sua instrução>" [--target <path>] [--accept <token>]... [--adversarial-depth low|medium|paranoid]
  ./aegis --issue <N> (ou ./aegis <N>)
  ./aegis squash [issue_number]
  ./aegis split <tasks/sua_issue.md> [diretorio_saida]
  ./aegis context [--target PATH]

Só o pedido é obrigatório. O target, se não o deres, sai do reconhecimento
mecânico do repositório; a acceptance sai do pedido quando ele nomeia código.
No prompt, "e" abre o rascunho no editor para preencheres o que faltar.

Comandos:
  ./aegis "<pedido>"    Abre a issue, corre o pipeline de mutation completo e pára no gate
                        de commit, que é teu. Fatiamento multi-unit determinístico com rollback atômico.
  ./aegis <N>           Retoma a execução de uma issue existente a partir da primeira task aberta.
  ./aegis squash <N>    Funde deliberada e manualmente os commits atômicos de micro-tarefas
                        de uma issue em 1 commit consolidado de feature para Pull Request.
  ./aegis split <file>  Divide mecanicamente uma Issue em Markdown em micro-unidades
                        atômicas de 1 target por vez (100% offline, 0 tokens).
  ./aegis context       Onde o alvo está: branch, worktree e contratos provados (offline).

Opções:
  --issue N             Volta a correr uma issue existente (keep-progress).
  --force-task K        Reabre a task K ([x]→[ ]) e re-corre a partir dela.
  --target PATH         Define o arquivo alvo explicitamente.
  --accept TOKEN        Define símbolos obrigatórios no código.
  --adversarial-depth   Intensidade do Advogado do Diabo: low | medium | paranoid (default: medium).
  --agent / --agentic   Execução em modo assistente AI (sem perguntas interativas TTY).

Sem TTY o gate não commita: deixa os paths em stage, a mensagem pronta, e
imprime os dois comandos que faltam (status PENDING_GATE).
EOF
}

# gh with the token hygiene the runtime already uses (some setups only
# authenticate through GITHUB_TOKEN, hence the retry). The retry keeps
# stderr so a real failure is debuggable instead of silent.
gh_run() {
  if env -u GITHUB_TOKEN gh "$@" 2>/dev/null; then
    return 0
  fi
  gh "$@"
}

default_target() {
  if [[ -d "${ROOT}/src" ]]; then
    printf 'src'
  else
    printf '.'
  fi
}

# Best guess for the file a goal is about, from the same mechanical Layer 0
# recognition the pipeline itself uses: churn fused with lexical resonance
# against the demand tokens. No LLM, no network. Empty when nothing resonates.
propose_target() {
  local goal="$1"
  local scope="$2"
  AEGIS_INVESTIGATION_INPUT="${goal}" \
    bash "${ROOT}/scripts/capabilities/runtime/layer0_facts.sh" "${scope}" 2>/dev/null \
    | jq -r '[.payload.hot_files[]? | select(.resonance == 1)]
             | sort_by(-.score) | .[0].file // empty' 2>/dev/null \
    || true
}

# Code-shaped tokens already present in the goal: camelCase, snake_case, or
# a bare number like 1000. Prose words are deliberately not eligible — an
# acceptance token becomes permanent, so it is extracted, never invented.
derive_accept_tokens() {
  printf '%s\n' "${1-}" \
    | tr ' \t,;()[]{}*+%/=-' '\n' \
    | sed -E 's/[.:!?"'"'"']+$//' \
    | grep -Ev '/' \
    | grep -E '([a-z][A-Z]|[a-zA-Z]_[a-zA-Z]|^[0-9]{3,}$)' \
    | grep -Ev '^(BigInt|Number|String|Boolean|Array|Object|Promise|Date|Math|JSON|MegaBytes|GigaBits|TeraBits|KiloBits|PetaBytes)$' \
    | sort -u \
    || true
}

# Paths the worktree changed under the target, net-new files included:
# git diff is blind to untracked files, and a create demand produces
# exactly that. Porcelain v1 is "XY<space>path", hence cut -c4-.
target_changes() {
  local target="$1"
  if [[ -n "${target}" && -f "${target}" && ! -s "${target}" ]]; then
    if ! git ls-files --error-unmatch "${target}" >/dev/null 2>&1; then
      rm -f "${target}" 2>/dev/null || true
    fi
  fi
  git status --porcelain --untracked-files=all -- "${target}" 2>/dev/null \
    | cut -c4- \
    | grep -v '^$' \
    || true
}

target_is_clean() {
  [[ -z "$(target_changes "$1")" ]]
}

# ---------------------------------------------------------
# context
# ---------------------------------------------------------

cmd_context() {
  local target=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target)
        target="${2:-}"
        shift 2
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        aegis_fatal "unknown_flag:$1"
        ;;
    esac
  done
  [[ -n "${target}" ]] || target="$(default_target)"
  target="${target#./}"
  target="${target%/}"
  [[ -e "${target}" ]] || aegis_fatal "target_not_found:${target}"

  local branch dirty
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || printf 'n/a')"
  if target_is_clean "${target}"; then
    dirty='limpo'
  else
    dirty='sujo — a promoção recusa ficheiros sujos'
  fi

  printf 'branch: %s · worktree: %s\n' "${branch}" "${dirty}"

  # A gate that never closed is real state, and the first thing whoever
  # arrives next needs to know. Truthful by construction: a prepared
  # message whose issue reached the record means the gate is done.
  if [[ -s "${COMMIT_MSG_FILE}" ]]; then
    local pending_issue
    pending_issue="$(
      awk -F': ' '/^Aegis-Issue:/ { print $2; exit }' "${COMMIT_MSG_FILE}"
    )"
    if [[ -n "${pending_issue}" ]] \
      && ! aegis_record_entries "${target}" | cut -f2 \
        | grep -qx "${pending_issue}"; then
      printf 'gate por fechar: issue#%s (%s)\n' \
        "${pending_issue}" "${COMMIT_MSG_FILE}"
    fi
  fi

  aegis_record_digest "${target}"
}

# ---------------------------------------------------------
# go
# ---------------------------------------------------------

# Structured demand from flags. No ## Tasks: one issue is one task, and
# the checklist only exists for issues humans write by hand.
#
# Reads the caller's `accepts` and `changes` arrays through bash dynamic
# scoping: bash cannot pass arrays by value, and threading them through
# positional parameters needs a separator token that buys nothing.
render_body() {
  local goal="$1"
  local target="$2"

  # Same section order as the supervisor render (briefing.sh) and the
  # Briefing skill: Goal → Targets → Acceptance → Briefing → Out of scope
  # → Constraints. Briefing holds pseudocode; the acceptance tokenizer
  # does not read it, so mechanics stay out of the promotion contract.
  # Never invent a filler ## Change — its words used to leak into Acceptance.
  printf '## Goal\n%s\n\n' "${goal}"
  printf '## Targets\n- %s\n\n' "${target}"

  printf '## Acceptance\n'
  local a
  for a in "${accepts[@]+"${accepts[@]}"}"; do
    printf -- '- %s\n' "${a}"
  done
  printf '\n'

  # --change lines are operator pseudocode → ## Briefing (not ## Change).
  # Without --change the section still exists so the draft schema is complete
  # and `e` (edit) has a place to fill; empty is fine.
  printf '## Briefing\n'
  if [[ "${#changes[@]}" -gt 0 ]]; then
    local c
    for c in "${changes[@]+"${changes[@]}"}"; do
      printf '%s\n' "${c}"
    done
  fi
  printf '\n'

  printf '## Out of scope\n- unrelated files\n- e2e tests\n- drive-by refactors\n\n'
  printf '## Constraints\n'
  printf -- '- no any / as any / @ts-ignore\n'
  printf -- '- NodeNext: .js extension in relative imports\n'
  printf -- '- only packages in package.json; builtins are global\n'
}

# ---------------------------------------------------------
# Intake quality (DEFAULT). Escape: --relaxed / AEGIS_INTAKE_RELAXED=1
# ---------------------------------------------------------

aegis_intake_relaxed() {
  case "${AEGIS_INTAKE_RELAXED:-0}" in
    1|true|yes|on) return 0 ;;
  esac
  return 1
}

# Poison tokens that must never appear in ## Acceptance (constructor/state).
aegis_intake_is_poison_accept_token() {
  local tok="${1-}"
  case "${tok}" in
    maxBytes|maxTokens|rateBitsPerMs|timeDiff|lastUpdate|mbps|bits|bytes|tokens|_*) return 0 ;;
  esac
  [[ "${tok}" == *'*'* ]] && return 0
  [[ "${tok}" =~ ^(max|min|rate|time|last)[A-Z] ]] && return 0
  return 1
}

# Strip poison tokens from ## Acceptance section cleanly
aegis_intake_strip_poison_acceptance_tokens() {
  local text="${1-}"
  printf '%s\n' "${text}" | awk '
    BEGIN { in_acc = 0 }
    /^## Acceptance[[:space:]]*$/ { print; in_acc = 1; next }
    /^## / { in_acc = 0 }
    in_acc {
      line = $0
      sub(/^[[:space:]]*-[[:space:]]*/, "", line)
      if (line ~ /^(maxBytes|maxTokens|rateBitsPerMs|timeDiff|lastUpdate|mbps|bits|bytes|tokens)$/) next
      if (line ~ /\*/) next
      if (line ~ /^(max|min|rate|time|last)[A-Z]/) next
      print
      next
    }
    { print }
  '
}

# Extract ## Section body (until next ##).
aegis_intake_md_section() {
  local name="${1-}"
  local text="${2-}"
  printf '%s\n' "${text}" | awk -v name="${name}" '
    index($0, "## " name) == 1 { p = 1; next }
    /^## / { if (p) exit }
    p { print }
  '
}

# If Briefing is empty, inject minimal export stubs from Acceptance tokens
# (and optional --change lines already in Briefing via render_body).
# Prints full demand markdown.
aegis_intake_ensure_briefing() {
  local text="${1-}"
  local briefing acc_lines stubs="" tok stub_file out_file
  briefing="$(aegis_intake_md_section "Briefing" "${text}")"
  if [[ -n "$(printf '%s' "${briefing}" | tr -d '[:space:]')" ]]; then
    printf '%s' "${text}"
    return 0
  fi
  acc_lines="$(
    aegis_intake_md_section "Acceptance" "${text}" \
      | sed -E 's/^[[:space:]]*-[[:space:]]*//' \
      | grep -v '^$' || true
  )"
  while IFS= read -r tok; do
    [[ -n "${tok}" ]] || continue
    aegis_intake_is_poison_accept_token "${tok}" && continue
    # Non-identifier regression tokens (e.g. / 1000) skip stub lines.
    [[ "${tok}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    if [[ "${tok}" =~ ^[A-Z] ]]; then
      stubs+="export class ${tok} { /* … */ }"$'\n'
    else
      stubs+="export function ${tok}(/* … */) { /* … */ }"$'\n'
    fi
  done <<< "${acc_lines}"
  if [[ -z "$(printf '%s' "${stubs}" | tr -d '[:space:]')" ]]; then
    printf '%s' "${text}"
    return 0
  fi
  # File-based inject: awk -v cannot hold multi-line stubs portably.
  stub_file="$(mktemp)"
  out_file="$(mktemp)"
  printf '%s' "${stubs}" > "${stub_file}"
  printf '%s\n' "${text}" | awk -v stubf="${stub_file}" '
    BEGIN {
      in_b = 0
      done = 0
      while ((getline line < stubf) > 0) {
        stubs = stubs line "\n"
      }
      close(stubf)
    }
    /^## Briefing[[:space:]]*$/ {
      print
      printf "%s", stubs
      in_b = 1
      done = 1
      next
    }
    in_b && /^## / { in_b = 0 }
    in_b { next }
    { print }
    END {
      if (!done) {
        print ""
        print "## Briefing"
        printf "%s", stubs
      }
    }
  ' > "${out_file}"
  cat "${out_file}"
  rm -f "${stub_file}" "${out_file}"
}

# Validate demand for quality intake. Prints reason lines on stderr; return 1 if bad.
aegis_intake_quality_check() {
  local text="${1-}"
  local acc briefing tok reasons="" export_hit

  [[ -n "$(printf '%s' "${text}" | tr -d '[:space:]')" ]] || {
    printf 'empty_demand\n' >&2
    return 1
  }
  printf '%s\n' "${text}" | grep -qE '^## Goal[[:space:]]*$' || reasons+=$'missing_section:Goal\n'
  printf '%s\n' "${text}" | grep -qE '^## Targets[[:space:]]*$' || reasons+=$'missing_section:Targets\n'
  printf '%s\n' "${text}" | grep -qE '^## Acceptance[[:space:]]*$' || reasons+=$'missing_section:Acceptance\n'
  printf '%s\n' "${text}" | grep -qE '^## Briefing[[:space:]]*$' || reasons+=$'missing_section:Briefing\n'

  acc="$(aegis_intake_md_section "Acceptance" "${text}")"
  briefing="$(aegis_intake_md_section "Briefing" "${text}")"

  if [[ -z "$(printf '%s' "${briefing}" | tr -d '[:space:]')" ]]; then
    reasons+=$'empty_briefing\n'
  fi
  if [[ -z "$(printf '%s' "${acc}" | tr -d '[:space:]')" ]]; then
    reasons+=$'empty_acceptance\n'
  fi

  while IFS= read -r tok; do
    [[ -n "${tok}" ]] || continue
    tok="$(printf '%s' "${tok}" | sed -E 's/^[[:space:]]*-[[:space:]]*//; s/[[:space:]]+$//')"
    [[ -n "${tok}" ]] || continue
    if aegis_intake_is_poison_accept_token "${tok}"; then
      reasons+="poison_acceptance:${tok}"$'\n'
      continue
    fi
    # Identifier exports must appear as top-level export in Briefing.
    if [[ "${tok}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      export_hit=0
      if printf '%s\n' "${briefing}" | grep -Eq \
        "export[[:space:]]+(async[[:space:]]+)?(function|class|const|let|var)[[:space:]]+${tok}([^A-Za-z0-9_]|$)"; then
        export_hit=1
      elif printf '%s\n' "${briefing}" | grep -Eq "export[[:space:]]*\{[^}]*\b${tok}\b"; then
        export_hit=1
      fi
      if [[ "${export_hit}" -eq 0 ]]; then
        reasons+="acceptance_not_in_briefing_export:${tok}"$'\n'
      fi
    fi
  done < <(printf '%s\n' "${acc}")

  if [[ -n "${reasons}" ]]; then
    printf '%s' "${reasons}" >&2
    return 1
  fi
  return 0
}

# Byte-identical to aegis_fetch_issue_demand's cache format, so the whole
# run reads the approved text from disk and never calls gh again — and the
# demand cannot change under the run if someone edits the issue meanwhile.
seed_issue_cache() {
  local issue="$1"
  local title="$2"
  local body="$3"
  mkdir -p "${ISSUE_CACHE_DIR}" 2>/dev/null || true
  printf '# Issue #%s: %s\n\n%s' "${issue}" "${title}" "${body}" \
    > "${ISSUE_CACHE_DIR}/issue_${issue}.md"
}

# ---------------------------------------------------------
# Multi-unit plan + keep-progress batch
# ---------------------------------------------------------

clear_micro_plan_cache() {
  rm -rf "${MICROS_DIR}" "${MICROS_MANUAL_DIR}" 2>/dev/null || true
}

count_micro_units() {
  local dir="${1:-${MICROS_DIR}}"
  local n=0
  while [[ -f "${dir}/unit-${n}.md" ]]; do
    n=$((n + 1))
  done
  printf '%s' "${n}"
}

# Acceptance bullets → "TokA, TokB" for Aegis-Accept.
unit_acceptance_csv() {
  local file="${1-}"
  [[ -f "${file}" ]] || return 0
  awk '/^## Acceptance$/ { p = 1; next } /^## / { p = 0 } p' "${file}" \
    | sed -E 's/^[[:space:]]*-[[:space:]]*//' \
    | grep -v '^$' \
    | paste -sd',' - \
    | sed 's/,/, /g' \
    || true
}

# Paths listed under ## Targets of a unit demand.
unit_target_paths() {
  local file="${1-}"
  [[ -f "${file}" ]] || return 0
  awk '/^## Targets$/ { p = 1; next } /^## / { p = 0 } p' "${file}" \
    | sed -E 's/^[[:space:]]*-[[:space:]]*//' \
    | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
    | grep -v '^$' \
    || true
}

# Worktree changes under every path named by the unit (incl. untracked).
unit_changed_paths() {
  local file="${1-}"
  local p
  while IFS= read -r p; do
    [[ -n "${p}" ]] || continue
    p="${p#./}"
    target_changes "${p}"
  done < <(unit_target_paths "${file}") | awk 'NF && !seen[$0]++'
}

# Strip an existing ## Tasks section (through the next ## heading).
aegis_md_strip_tasks_section() {
  local text="${1-}"
  printf '%s\n' "${text}" | awk '
    /^## Tasks[[:space:]]*$/ { skip = 1; next }
    /^## / { skip = 0 }
    !skip { print }
  '
}

# How many checklist rows under ## Tasks (open or done).
aegis_md_task_count() {
  local text="${1-}"
  printf '%s\n' "${text}" | awk '
    BEGIN { n = 0; in_tasks = 0 }
    /^## Tasks[[:space:]]*$/ { in_tasks = 1; next }
    /^## / { if (in_tasks) in_tasks = 0 }
    in_tasks && /^-[[:space:]]*\[[[:space:]xX]\]/ { n++ }
    END { print n + 0 }
  '
}

# 1-based index of the first open `- [ ]` task, or empty if none.
aegis_md_first_open_task() {
  local text="${1-}"
  printf '%s\n' "${text}" | awk '
    BEGIN { n = 0; in_tasks = 0 }
    /^## Tasks[[:space:]]*$/ { in_tasks = 1; next }
    /^## / { if (in_tasks) in_tasks = 0 }
    in_tasks && /^-[[:space:]]*\[[[:space:]xX]\]/ {
      n++
      if ($0 ~ /^-[[:space:]]*\[[[:space:]]\]/) {
        print n
        exit
      }
    }
  '
}

# True if task N (1-based) is already [x]/[X].
aegis_md_task_is_done() {
  local text="${1-}"
  local task_n="${2-0}"
  [[ "${task_n}" =~ ^[1-9][0-9]*$ ]] || return 1
  # Note: awk END runs even after exit — do not override a found match there.
  printf '%s\n' "${text}" | awk -v want="${task_n}" '
    BEGIN { n = 0; in_tasks = 0; found = 0; done = 0 }
    /^## Tasks[[:space:]]*$/ { in_tasks = 1; next }
    /^## / { if (in_tasks) in_tasks = 0 }
    in_tasks && /^-[[:space:]]*\[[[:space:]xX]\]/ {
      n++
      if (n == want + 0) {
        found = 1
        if ($0 ~ /\[[xX]\]/) done = 1
        exit
      }
    }
    END { if (found && done) exit 0; exit 1 }
  '
}

# Flip the Nth checklist item under ## Tasks to [x] (1-based).
# Prints the full markdown body. No-op style if index out of range.
aegis_md_check_task() {
  local text="${1-}"
  local task_n="${2-0}"
  [[ "${task_n}" =~ ^[1-9][0-9]*$ ]] || {
    printf '%s' "${text}"
    return 0
  }
  printf '%s\n' "${text}" | awk -v want="${task_n}" '
    BEGIN { n = 0; in_tasks = 0 }
    /^## Tasks[[:space:]]*$/ { in_tasks = 1; print; next }
    /^## / {
      if (in_tasks) in_tasks = 0
      print
      next
    }
    in_tasks && /^-[[:space:]]*\[[[:space:]xX]\]/ {
      n++
      if (n == want + 0) {
        sub(/\[[[:space:]]\]/, "[x]")
      }
      print
      next
    }
    { print }
  '
}

# Reopen the Nth checklist item: [x]/[X] → [ ] (1-based).
aegis_md_uncheck_task() {
  local text="${1-}"
  local task_n="${2-0}"
  [[ "${task_n}" =~ ^[1-9][0-9]*$ ]] || {
    printf '%s' "${text}"
    return 0
  }
  printf '%s\n' "${text}" | awk -v want="${task_n}" '
    BEGIN { n = 0; in_tasks = 0 }
    /^## Tasks[[:space:]]*$/ { in_tasks = 1; print; next }
    /^## / {
      if (in_tasks) in_tasks = 0
      print
      next
    }
    in_tasks && /^-[[:space:]]*\[[[:space:]xX]\]/ {
      n++
      if (n == want + 0) {
        sub(/\[[xX]\]/, "[ ]")
      }
      print
      next
    }
    { print }
  '
}

# Build issue body = parent demand (no Tasks) + checklist of every micro unit.
build_multiunit_plan_body() {
  local parent_body="${1-}"
  local micros_dir="${2:-.harness/micros_auto}"
  local n i title targets_csv accept_csv line tasks="" unit_file fit_json
  local stripped

  n="$(count_micro_units "${micros_dir}")"
  [[ "${n}" -gt 0 ]] || {
    printf '%s' "${parent_body}"
    return 0
  }

  fit_json="${micros_dir}/fit.json"
  for ((i = 0; i < n; i++)); do
    unit_file="${micros_dir}/unit-${i}.md"
    title=""
    if [[ -f "${fit_json}" ]]; then
      title="$(jq -r --argjson i "${i}" \
        '.proposed_units[$i].title // empty' "${fit_json}" 2>/dev/null || true)"
    fi
    if [[ -z "${title}" && -f "${unit_file}" ]]; then
      title="$(
        awk '/^## Goal$/ { p = 1; next } /^## / { p = 0 } p' "${unit_file}" \
          | tr '\n' ' ' | sed 's/[[:space:]]*$//' | cut -c1-60
      )"
    fi
    [[ -n "${title}" ]] || title="unit-${i}"
    targets_csv="$(unit_target_paths "${unit_file}" | paste -sd',' - | sed 's/,/, /g')"
    accept_csv="$(unit_acceptance_csv "${unit_file}")"
    line="- [ ] Task $((i + 1)) — ${title}"
    [[ -n "${targets_csv}" ]] && line+=" (\`${targets_csv}\`)"
    [[ -n "${accept_csv}" ]] && line+=" · accept: ${accept_csv}"
    tasks+="${line}"$'\n'
  done

  stripped="$(aegis_md_strip_tasks_section "${parent_body}")"
  # Drop trailing blank lines so ## Tasks sits cleanly.
  stripped="$(printf '%s\n' "${stripped}" | awk 'NF { for (; c > 0; c--) print ""; print; next } { c++ }')"

  printf '%s\n\n## Tasks\n%s' "${stripped}" "${tasks}"
}

print_micro_plan() {
  local micros_dir="${1:-.harness/micros_auto}"
  local n i unit_file title targets_csv accept_csv fit_json
  n="$(count_micro_units "${micros_dir}")"
  [[ "${n}" -gt 0 ]] || return 0
  fit_json="${micros_dir}/fit.json"
  printf '\n── plano multi-unit (%s tasks) ──\n' "${n}"
  for ((i = 0; i < n; i++)); do
    unit_file="${micros_dir}/unit-${i}.md"
    title=""
    if [[ -f "${fit_json}" ]]; then
      title="$(jq -r --argjson i "${i}" \
        '.proposed_units[$i].title // empty' "${fit_json}" 2>/dev/null || true)"
    fi
    [[ -n "${title}" ]] || title="unit-${i}"
    targets_csv="$(unit_target_paths "${unit_file}" | paste -sd',' - | sed 's/,/, /g')"
    accept_csv="$(unit_acceptance_csv "${unit_file}")"
    printf '  [%s/%s] %s\n' "$((i + 1))" "${n}" "${title}"
    [[ -n "${targets_csv}" ]] && printf '         target: %s\n' "${targets_csv}"
    [[ -n "${accept_csv}" ]] && printf '         accept: %s\n' "${accept_csv}"
  done
  printf '── y aprova o plano inteiro; falha na task K mantém 1..K-1 ──\n\n'
}

# Best-effort: patch issue body via gh and refresh local cache.
# Args: issue, new_body
issue_write_body() {
  local issue="${1-}"
  local new_body="${2-}"
  local tmp
  [[ "${issue}" =~ ^[0-9]+$ ]] || return 1
  [[ -n "${new_body}" ]] || return 1
  tmp="$(mktemp)"
  printf '%s\n' "${new_body}" > "${tmp}"
  if gh_run issue edit "${issue}" --body-file "${tmp}" >/dev/null 2>&1; then
    rm -f "${tmp}"
    if [[ -n "${ISSUE_CACHE_DIR:-}" ]]; then
      local cache="${ISSUE_CACHE_DIR}/issue_${issue}.md" title
      if [[ -f "${cache}" ]]; then
        title="$(head -n 1 "${cache}" | sed -E 's/^# Issue #[0-9]+: //')"
        seed_issue_cache "${issue}" "${title}" "${new_body}"
      fi
    fi
    return 0
  fi
  rm -f "${tmp}"
  return 1
}

# Best-effort: mark Task N done on the GitHub issue body.
issue_mark_task_done() {
  local issue="${1-}"
  local task_n="${2-}"
  local body new_body
  [[ "${issue}" =~ ^[0-9]+$ ]] || return 1
  [[ "${task_n}" =~ ^[1-9][0-9]*$ ]] || return 1

  body="$(gh_run issue view "${issue}" --json body -q .body 2>/dev/null || true)"
  [[ -n "${body}" ]] || return 1
  new_body="$(aegis_md_check_task "${body}" "${task_n}")"
  issue_write_body "${issue}" "${new_body}"
}

# Best-effort: reopen Task N ([x] → [ ]) for --force-task.
issue_mark_task_open() {
  local issue="${1-}"
  local task_n="${2-}"
  local body new_body
  [[ "${issue}" =~ ^[0-9]+$ ]] || return 1
  [[ "${task_n}" =~ ^[1-9][0-9]*$ ]] || return 1

  body="$(gh_run issue view "${issue}" --json body -q .body 2>/dev/null || true)"
  [[ -n "${body}" ]] || return 1
  new_body="$(aegis_md_uncheck_task "${body}" "${task_n}")"
  issue_write_body "${issue}" "${new_body}"
}

# Ensure .harness/micros_auto matches this issue; re-emit from plan body if needed.
# Args: issue_number, issue_body
# Returns 0 when unit-0.md exists.
ensure_micros_for_resume() {
  local issue="${1-}"
  local issue_body="${2-}"
  local micros_dir=".harness/micros_auto"
  local id_file="${micros_dir}/issue.id"
  local parent n_tasks n_units

  n_tasks="$(aegis_md_task_count "${issue_body}")"
  if [[ -f "${micros_dir}/unit-0.md" ]]; then
    if [[ -f "${id_file}" ]] && [[ "$(tr -d '[:space:]' < "${id_file}")" == "${issue}" ]]; then
      n_units="$(count_micro_units "${micros_dir}")"
      if [[ "${n_tasks}" -le 1 ]] || [[ "${n_units}" -ge 1 ]]; then
        return 0
      fi
    fi
    # Stale micros from another issue or broken set — rebuild.
    rm -rf "${micros_dir}" >/dev/null 2>&1 || true
  fi

  parent="$(aegis_md_strip_tasks_section "${issue_body}")"
  [[ -n "$(printf '%s' "${parent}" | tr -d '[:space:]')" ]] || return 1
  mkdir -p "${micros_dir}"
  if ! printf '%s\n' "${parent}" \
    | bash "${ROOT}/scripts/fit_check_demand.sh" --emit-micros "${micros_dir}" \
      >/dev/null 2>&1; then
    # emit still writes files when run_allowed=false; only fail if no units.
    :
  fi
  [[ -f "${micros_dir}/unit-0.md" ]] || return 1
  printf '%s\n' "${issue}" > "${id_file}"
  return 0
}

# Auto-checkpoint after a successful unit (plan already approved).
# Args: issue, unit_idx_0based, unit_total, unit_file
# Prints short sha on success; empty + return 1 on failure.
commit_unit_checkpoint() {
  local issue="${1-}"
  local unit_idx="${2-0}"
  local unit_total="${3-1}"
  local unit_file="${4-}"
  local task_n=$((unit_idx + 1))
  local task_label="${task_n}/${unit_total}"
  local paths accept_csv summary msg_file committed p

  # ONLY paths named by the unit. Never fall back to full `git status` — that
  # once checkpoint-committed harness edits (scripts/lib/*) as issue#92 task 2.
  paths="$(unit_changed_paths "${unit_file}")"
  if [[ -z "$(printf '%s' "${paths}" | tr -d '[:space:]')" ]]; then
    printf ''
    return 1
  fi
  # Refuse anything outside the unit targets (defense in depth).
  local allowed p_ok
  allowed="$(unit_target_paths "${unit_file}")"
  paths="$(
    printf '%s\n' "${paths}" | while IFS= read -r p; do
      [[ -n "${p}" ]] || continue
      p_ok=0
      while IFS= read -r a; do
        [[ -n "${a}" ]] || continue
        if [[ "${p}" == "${a}" || "${p}" == "${a}/"* || "${p}" == *"/${a}" ]]; then
          p_ok=1
          break
        fi
        # allow exact file under target path
        case "${p}" in
          "${a}"|"${a}"/*) p_ok=1; break ;;
        esac
      done <<< "${allowed}"
      [[ "${p_ok}" -eq 1 ]] && printf '%s\n' "${p}"
    done
  )"
  if [[ -z "$(printf '%s' "${paths}" | tr -d '[:space:]')" ]]; then
    printf ''
    return 1
  fi

  accept_csv="$(unit_acceptance_csv "${unit_file}")"
  if [[ -z "${accept_csv}" ]]; then
    # Last-resort token so the commit remains record-eligible.
    local _tp
    _tp="$(unit_target_paths "${unit_file}" | head -1)"
    accept_csv="$(basename "${_tp:-unit}" | sed -E 's/\.[^.]+$//')"
  fi
  [[ -n "${accept_csv}" ]] || accept_csv="unit-${unit_idx}"
  summary="$(printf '%s' "${accept_csv}" | cut -d',' -f1 | sed 's/^[[:space:]]*//')"

  mkdir -p "${RUNTIME_DIR}" 2>/dev/null || true
  msg_file="${COMMIT_MSG_FILE}.unit-${unit_idx}"
  aegis_record_render_message "${issue}" "${summary}" "${accept_csv}" "${task_label}" \
    > "${msg_file}"

  while IFS= read -r p; do
    [[ -n "${p}" ]] || continue
    git add -- "${p}" 2>/dev/null || true
  done <<< "${paths}"

  if git diff --cached --quiet 2>/dev/null; then
    rm -f "${msg_file}" 2>/dev/null || true
    printf ''
    return 1
  fi

  if ! git commit -F "${msg_file}" >/dev/null 2>&1; then
    git reset --quiet HEAD 2>/dev/null || true
    rm -f "${msg_file}" 2>/dev/null || true
    printf ''
    return 1
  fi

  # Scratch for -F only; the commit object already holds the message.
  rm -f "${msg_file}" 2>/dev/null || true

  committed="$(git rev-parse --short HEAD 2>/dev/null || true)"
  printf '%s' "${committed}"
  return 0
}

# First path under ## Targets of an issue, from the cache the run seeds
# or from gh. aegis_extract_operator_named_paths already knows how to
# read that section without inventing ghost paths.
issue_target() {
  local issue="$1"
  local cache="${ISSUE_CACHE_DIR}/issue_${issue}.md"
  local body=""
  if [[ -s "${cache}" ]]; then
    body="$(cat "${cache}")"
  else
    body="$(gh_run issue view "${issue}" --json body -q .body || true)"
  fi
  aegis_extract_operator_named_paths "${body}" | head -1
}

assert_not_blocked() {
  local issue="$1"
  local labels
  labels="$(gh_run issue view "${issue}" --json labels -q '.labels[].name' || true)"
  if printf '%s\n' "${labels}" | grep -qx 'aegis:blocked'; then
    aegis_fatal "issue_blocked:${issue}"
  fi
}

outcome_field() {
  local field="$1"
  [[ -f "${OUTCOME_FILE}" ]] || {
    printf ''
    return 0
  }
  jq -r --arg f "${field}" '.[$f] // empty' "${OUTCOME_FILE}" 2>/dev/null || printf ''
}

emit_result_json() {
  jq -cn \
    --arg status "${1}" \
    --arg issue "${2}" \
    --arg commit "${3}" \
    --arg reason "${4}" \
    '{schema:"aegis.go.v1",status:$status,issue:$issue,commit:$commit,reason:$reason}'
}

# Etapa 1/3 — pausa de intake agêntico. Entrega a evidência real (discovery &
# forensics) ao assistente e pede a demanda como schema JSON. Persiste o
# estado pendente para --resume consumir. Não é um erro: é handover.
emit_pending_assistant() {
  local goal="${1:-}" target="${2:-}" evidence="${3:-}"
  local pending_file="${RUNTIME_DIR}/pending_assistant.json"
  mkdir -p "${RUNTIME_DIR}" 2>/dev/null || true

  # Mapeia evidência estruturada de cada target
  local targets_evidence_json="[]"
  local t
  for t in ${target}; do
    local t_exists=false t_exports="[]" t_snippet=""
    if [[ -f "${t}" ]]; then
      t_exists=true
      local raw_exports
      raw_exports="$(aegis_file_top_level_export_names "$(cat "${t}" 2>/dev/null || true)" 2>/dev/null || true)"
      if [[ -n "${raw_exports}" ]]; then
        t_exports="$(printf '%s\n' "${raw_exports}" | sed '/^$/d' | jq -R . | jq -s . 2>/dev/null || printf '[]')"
      fi
      t_snippet="$(head -n 30 "${t}" 2>/dev/null || true)"
    fi
    targets_evidence_json="$(jq \
      --arg path "${t}" \
      --argjson exists "${t_exists}" \
      --argjson exports "${t_exports}" \
      --arg snippet "${t_snippet}" \
      '. + [{path: $path, exists: $exists, exports: $exports, snippet: $snippet}]' \
      <<< "${targets_evidence_json}" 2>/dev/null || printf '%s' "${targets_evidence_json}")"
  done

  # Pocket map do workspace
  local pocket_map_json="[]"
  if command -v git >/dev/null 2>&1; then
    pocket_map_json="$(git ls-files src/ 2>/dev/null | head -n 50 | jq -R . | jq -s . 2>/dev/null || printf '[]')"
  fi

  jq -cn \
    --arg schema "aegis.pending_assistant.v1" \
    --arg stage "intake" \
    --arg prose "${goal}" \
    --arg target "${target}" \
    --argjson targets_evidence "${targets_evidence_json}" \
    --argjson pocket_map "${pocket_map_json}" \
    --arg evidence "${evidence}" \
    '{
      schema: $schema,
      stage: $stage,
      prose: $prose,
      target: $target,
      targets_evidence: $targets_evidence,
      pocket_map: $pocket_map,
      evidence: $evidence
    }' > "${pending_file}" 2>/dev/null || true

  printf '\n=== PENDING ASSISTANT (intake) ===\n'
  printf 'Prose recebida:\n%s\n\nTargets:\n%s\n\nEvidência estruturada (discovery & forensics):\n' \
    "${goal}" "${target}"
  jq '.' <<< "${targets_evidence_json}" 2>/dev/null || printf '%b\n' "${evidence}"
  printf '\nDetalha a demanda como schema JSON (issue detalhada pelo agente) e retoma com:\n'
  printf '  ./aegis --resume --goal \x27<schema-json>\x27 --target \x27%s\x27\n' "${target}"
  emit_result_json "PENDING_ASSISTANT" "" "" "agentic_requires_schema_json"
  aegis_log "PENDING_ASSISTANT: intake agêntico pausado; evidência entregue ao assistente"
}

# One metrics session for the whole go: intake + all multi-unit tasks append
# into the same pipeline_metrics.jsonl (run_aegis --fresh would otherwise wipe).
aegis_metrics_session_begin() {
  export AEGIS_ROOT_DIR="${ROOT}"
  export AEGIS_METRICS_FILE="${RUNTIME_DIR}/pipeline_metrics.jsonl"
  mkdir -p "${RUNTIME_DIR}" 2>/dev/null || true
  : > "${AEGIS_METRICS_FILE}"
  export AEGIS_METRICS_APPEND=1
  jq -cn \
    --arg at "$(date -u +"%Y-%m-%dT%H:%M:%SZ")" \
    '{kind:"session_start",source:"aegis_go",at:$at}' \
    >> "${AEGIS_METRICS_FILE}" 2>/dev/null || true
}

aegis_is_agentic_execution() {
  if [[ "${AEGIS_AGENTIC:-0}" == "1" ]] \
    || [[ -n "${ANTIGRAVITY_AGENT:-}${ANTIGRAVITY_IDE:-}${GEMINI_CLI:-}${CLAUDE_CODE:-}${CLAUDE_AGENT:-}${ANTHROPIC_CLI:-}${CLAUDE_DESKTOP:-}${CODEX_AGENT:-}${CODEX_CLI:-}${OPENAI_AGENT:-}${CHATGPT_CLI:-}${OPENCODE_AGENT:-}${OPENCODE_CLI:-}${OPENHANDS_AGENT:-}${OPEN_CODE:-}${OPENCODE:-}${CURSOR_AGENT:-}${CURSOR_IDE:-}${WINDSURF_AGENT:-}${CODEIUM_AGENT:-}${COPILOT_AGENT:-}${GITHUB_COPILOT:-}${AIDER_AGENT:-}${GOOSE_AGENT:-}${GOOSE_CLI:-}${CLINE_AGENT:-}${ROO_CODE:-}${DEVIN_AGENT:-}${DEVIN_CLI:-}${CONTINUE_AGENT:-}${AI_AGENT:-}${AGENTIC:-}" ]]; then
    return 0
  fi
  if [[ ! -t 0 ]]; then
    return 0
  fi
  return 1
}

# True AI-assistant detection: an agent env var is set or running in non-TTY pipe.
# Used to auto-approve TTY prompts only for genuine agent runs; a scripted human decline must still be
# honoured.
aegis_is_ai_agent() {
  [[ "${AEGIS_AGENTIC:-0}" == "1" ]] \
    || [[ -n "${ANTIGRAVITY_AGENT:-}${ANTIGRAVITY_IDE:-}${GEMINI_CLI:-}${CLAUDE_CODE:-}${CLAUDE_AGENT:-}${ANTHROPIC_CLI:-}${CLAUDE_DESKTOP:-}${CODEX_AGENT:-}${CODEX_CLI:-}${OPENAI_AGENT:-}${CHATGPT_CLI:-}${OPENCODE_AGENT:-}${OPENCODE_CLI:-}${OPENHANDS_AGENT:-}${OPEN_CODE:-}${OPENCODE:-}${CURSOR_AGENT:-}${CURSOR_IDE:-}${WINDSURF_AGENT:-}${CODEIUM_AGENT:-}${COPILOT_AGENT:-}${GITHUB_COPILOT:-}${AIDER_AGENT:-}${GOOSE_AGENT:-}${GOOSE_CLI:-}${CLINE_AGENT:-}${ROO_CODE:-}${DEVIN_AGENT:-}${DEVIN_CLI:-}${CONTINUE_AGENT:-}${AI_AGENT:-}${AGENTIC:-}" ]] \
    || [[ ! -t 0 ]]
}

cmd_run() {
  local goal="" target="" issue="" assume_yes=0 force_task="" intake_relaxed=0 resume=0
  local brief_why=""
  local -a accepts=() changes=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent|--agentic|--assistant)
        export AEGIS_AGENTIC=1
        shift ;;
      --goal)   goal="${2:-}"; shift 2 ;;
      --target)
        [[ -z "${target}" ]] \
          || aegis_fatal "multiple_targets — um target por vez; corre duas vezes"
        target="${2:-}"; shift 2 ;;
      --accept) accepts+=("${2:-}"); shift 2 ;;
      --change) changes+=("${2:-}"); shift 2 ;;
      --issue)  issue="${2:-}"; shift 2 ;;
      --force-task)
        force_task="${2:-}"
        [[ "${force_task}" =~ ^[1-9][0-9]*$ ]] \
          || aegis_fatal "invalid_force_task:${force_task:-empty} — use --force-task N (1-based)"
        shift 2 ;;
      --adversarial-depth)
        case "${2:-}" in
          low|medium|paranoid) export AEGIS_ADVERSARIAL_DEPTH="${2}"; shift 2 ;;
          *) aegis_fatal "invalid_adversarial_depth:${2:-empty} — use low|medium|paranoid" ;;
        esac
        ;;
      --relaxed)
        intake_relaxed=1
        export AEGIS_INTAKE_RELAXED=1
        shift ;;
      --resume) resume=1; shift ;;
      --yes|-y) assume_yes=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) aegis_fatal "unknown_flag:$1" ;;
      # A bare sentence is the goal: ./aegis "converter X em Y"
      *)
        [[ -z "${goal}" ]] || aegis_fatal "goal_given_twice"
        goal="$1"; shift ;;
    esac
  done

  command -v jq >/dev/null 2>&1 || aegis_fatal "missing_jq"

  if [[ -n "${force_task}" && -z "${issue}" ]]; then
    aegis_fatal "force_task_requires_issue — usa ./aegis --issue N --force-task K"
  fi
  # --relaxed flag or env; local also tracks for logging.
  if aegis_intake_relaxed; then
    intake_relaxed=1
  fi

  # Agentic detection is global: whenever an AI assistant drives the run,
  # AEGIS_AGENTIC=1 disables internal LLM cognition (supervisor expand/split,
  # forensics, adversarial) regardless of API-key presence. The interactive
  # setup wizard below additionally stays off for agents.
  if aegis_is_agentic_execution; then
    export AEGIS_AGENTIC=1
    aegis_log "ambiente agêntico detectado (assistente AI) — operando em modo handover mecânico (sem perguntas TTY)"
  fi

  # Interactive Setup Wizard trigger rule:
  # Trigger interactive setup wizard ONLY if API key is missing AND running interactively by a Human (not AI Agent)
  if [[ -z "${OPENAI_API_KEY:-${NVIDIA_API_KEY:-${GEMINI_API_KEY:-}}}" ]]; then
    if aegis_is_agentic_execution; then
      :
    elif [[ -t 0 ]] && [[ "${assume_yes}" -ne 1 ]]; then
      cmd_setup
    fi
  fi

  # Before briefing/supervisor expand so intake tokens land in the same file
  # as build/optimize tokens for the full demand.
  aegis_metrics_session_begin

  local body="" title=""
  # Multi-unit resume: start_unit is 0-based; empty means single-shot or full batch from 0.
  local resume_start_unit=""
  local multi_unit=0
  local micros_dir=".harness/micros_auto"
  # 1-based task that must run even if it was [x] (after reopen).
  local force_task_n=""

  if [[ -n "${issue}" ]]; then
    [[ "${issue}" =~ ^[0-9]+$ ]] || aegis_fatal "invalid_issue:${issue}"
    command -v gh >/dev/null 2>&1 || aegis_fatal "missing_gh"
    assert_not_blocked "${issue}"
    # Drop the cache first: a re-run must pick up an issue edited since the
    # last attempt, and the target below is read from that same body. The
    # run refetches and re-seeds, so the demand stays stable within the run.
    rm -f "${ISSUE_CACHE_DIR}/issue_${issue}.md"
    title="$(gh_run issue view "${issue}" --json title -q .title 2>/dev/null || true)"
    body="$(gh_run issue view "${issue}" --json body -q .body 2>/dev/null || true)"
    [[ -n "${body}" ]] || aegis_fatal "issue_fetch_failed:${issue}"
    seed_issue_cache "${issue}" "${title:-issue}" "${body}"

    local n_tasks open_task
    n_tasks="$(aegis_md_task_count "${body}")"
    open_task="$(aegis_md_first_open_task "${body}")"

    # Resume multi-unit when the issue has a real checklist, or leftover micros,
    # or the operator forces a specific task.
    if [[ "${n_tasks}" -gt 1 ]] || [[ -f "${micros_dir}/unit-0.md" ]] \
      || [[ -n "${force_task}" ]]; then
      if [[ -n "${force_task}" ]]; then
        force_task_n="${force_task}"
        if issue_mark_task_open "${issue}" "${force_task_n}"; then
          body="$(aegis_md_uncheck_task "${body}" "${force_task_n}")"
          seed_issue_cache "${issue}" "${title:-issue}" "${body}"
          aegis_log "force-task ${force_task_n}: reaberta na issue ([x]→[ ])"
        else
          aegis_warn "force-task ${force_task_n}: não actualizei a issue no gh — corro na mesma"
          body="$(aegis_md_uncheck_task "${body}" "${force_task_n}")"
        fi
        open_task="${force_task_n}"
      fi

      if [[ -z "${open_task}" ]] && [[ "${n_tasks}" -gt 0 ]] && [[ -z "${force_task_n}" ]]; then
        aegis_fatal "issue_tasks_complete:${issue} — todas as Tasks estão [x]; usa --force-task K para reabrir"
      fi
      ensure_micros_for_resume "${issue}" "${body}" \
        || aegis_fatal "resume_micros_failed:${issue} — não consegui regenerar unit-*.md a partir da issue"
      multi_unit=1
      local unit_total_resume
      unit_total_resume="$(count_micro_units "${micros_dir}")"
      if [[ -n "${force_task_n}" ]]; then
        [[ "${force_task_n}" -ge 1 && "${force_task_n}" -le "${unit_total_resume}" ]] \
          || aegis_fatal "force_task_out_of_range:${force_task_n} (units=${unit_total_resume})"
        resume_start_unit=$((force_task_n - 1))
      elif [[ -n "${open_task}" ]]; then
        resume_start_unit=$((open_task - 1))
      else
        resume_start_unit=0
      fi
      printf '%s\n' "${issue}" > "${micros_dir}/issue.id"
      if [[ -n "${force_task_n}" ]]; then
        aegis_log "force-task issue #${issue} task ${force_task_n}/${unit_total_resume}"
      else
        aegis_log "retomar issue #${issue} na task ${open_task:-1}/${unit_total_resume}"
      fi
      print_micro_plan "${micros_dir}"
      if [[ "${assume_yes}" -ne 1 ]] && ! aegis_is_ai_agent; then
        if [[ -n "${force_task_n}" ]]; then
          printf 'Forçar re-run da task %s/%s e continuar? [y/N] ' \
            "${force_task_n}" "${unit_total_resume}"
        else
          printf 'Retomar plano na task %s/%s? [y/N] ' \
            "${open_task:-1}" "${unit_total_resume}"
        fi
        read -r answer || answer=""
        case "${answer}" in
          y|Y|yes|s|S|sim) ;;
          *)
            aegis_log "cancelado; nada foi corrido"
            emit_result_json "CANCELLED" "${issue}" "" "operator_declined"
            return 1
            ;;
        esac
      fi
      target="$(unit_target_paths "${micros_dir}/unit-${resume_start_unit}.md" | head -1)"
      [[ -n "${target}" ]] || target="$(issue_target "${issue}")"
    else
      # Classic single-demand re-run.
      if [[ -z "${target}" ]]; then
        target="$(issue_target "${issue}")"
        [[ -n "${target}" ]] || aegis_fatal "issue_has_no_target:${issue}"
        aegis_log "target da issue: ${target}"
      fi
      # Stale micros from another run must not hijack a single-task issue.
      if [[ -f "${micros_dir}/unit-0.md" ]]; then
        local stale_id=""
        stale_id="$(tr -d '[:space:]' < "${micros_dir}/issue.id" 2>/dev/null || true)"
        if [[ "${stale_id}" != "${issue}" ]]; then
          rm -rf "${micros_dir}" >/dev/null 2>&1 || true
        fi
      fi
      aegis_log "a repetir a issue #${issue}"
    fi
  else
    [[ -n "${goal}" ]] || aegis_fatal "missing_goal"

    # Always clear stale auto micro-unit cache when starting a new goal
    rm -rf .harness/micros_auto >/dev/null 2>&1 || true

    # Unknown target: extract explicit pathspecs from goal or let mechanical recognition propose one.
    if [[ -z "${target}" ]]; then
      local explicit_paths
      explicit_paths="$(printf '%s' "${goal}" | grep -oE 'src/[A-Za-z0-9_/-]+\.[a-z]+' | sort -u | tr '\n' ' ' | sed 's/[[:space:]]*$//' || true)"
      if [[ -n "${explicit_paths}" ]]; then
        target="${explicit_paths}"
        aegis_log "targets extraídos do goal: ${target}"
      else
        target="$(propose_target "${goal}" "$(default_target)")"
        [[ -n "${target}" ]] \
          || aegis_fatal "target_desconhecido — nada ressoou com o goal; dá --target com o ficheiro"
        aegis_log "target proposto pelo reconhecimento: ${target}"
      fi
    fi

    # Intake (DEFAULT = quality). Expand 8B fills Goal/Acceptance/Briefing.
    # Mechanical fallback that greps constructor params into Acceptance is
    # only allowed with --relaxed / AEGIS_INTAKE_RELAXED=1.
    body=""
    if [[ "${resume}" -eq 1 ]]; then
      local pending_file="${RUNTIME_DIR}/pending_assistant.json"
      local pending_stage=""
      if [[ -f "${pending_file}" ]]; then
        pending_stage="$(jq -r '.stage // "intake"' "${pending_file}" 2>/dev/null || printf 'intake')"
      fi
      # Etapa 1/3 (intake): o assistente devolveu schema JSON e retoma do intake.
      if [[ "${pending_stage}" == "intake" || "${pending_stage}" == "" ]] && [[ -f "${pending_file}" ]]; then
        aegis_log "resume: a consumir estado pendente do intake..."
        if [[ -z "${target}" ]]; then
          target="$(jq -r '.target // empty' "${pending_file}" 2>/dev/null || true)"
          aegis_log "resume: target restaurado: ${target}"
        fi
        rm -f "${pending_file}"
      fi
      # Etapa 5/6 (pipeline): o pending mantém-se — o resume continua via run_aegis.sh --resume.
    fi
    if aegis_briefing_enabled; then
      local brief_err intake_evidence="" t
      brief_err="$(mktemp)"
      aegis_log "intake: a analisar o workspace (discovery & forensics) antes de estruturar a demanda..."
      for t in ${target}; do
        if [[ -f "${t}" ]]; then
          local t_exports t_snippet
          t_exports="$(aegis_file_top_level_export_names "$(cat "${t}" 2>/dev/null || true)" 2>/dev/null || true)"
          t_snippet="$(head -n 20 "${t}" 2>/dev/null || true)"
          intake_evidence="${intake_evidence}File: ${t}\nExisting Exports: ${t_exports}\nSnippet:\n${t_snippet}\n\n"
        fi
      done
      if [[ -n "$(aegis_intake_md_section "Briefing" "${goal}" | tr -d '[:space:]')" ]] \
        || aegis_briefing_is_schema_json "${goal}"; then
        export AEGIS_BRIEFING_SOURCE=user
        aegis_log "briefing: brief do operador (proveniência=user)"
      else
        export AEGIS_BRIEFING_SOURCE=supervisor
        aegis_log "briefing: brief inventado pelo supervisor (proveniência=supervisor)"
      fi
      aegis_log "briefing: a expandir a demanda com o supervisor (com evidência epistêmica)..."
      body="$(aegis_briefing_generate "${goal}" "${target}" "${intake_evidence}" 2>"${brief_err}")" || body=""
      if [[ -n "${body}" ]]; then
        aegis_log "briefing: demanda estruturada aceite"
        mkdir -p "${RUNTIME_DIR}" 2>/dev/null || true
        jq -n \
          --arg target "${target}" \
          --arg goal "${goal}" \
          '{
            artifact_snapshot: {
              status: "interpreted",
              mode: "forensics",
              evidence_refs: ["filesystem.read:intake"],
              operational_context: {
                status: "interpreted",
                mode: "forensics",
                mutation_candidates: [
                  {
                    id: $target,
                    reason: ("Demand: " + $goal)
                  }
                ],
                handover_attention: {
                  next_attention_targets: [$target],
                  attention_scope: "intake_forensics",
                  attention_reason: "ATTENTION_REASON_FORENSICS"
                }
              }
            },
            epistemic_state: {
              next_attention_targets: [$target],
              attention_scope: "intake_forensics",
              attention_reason: "ATTENTION_REASON_FORENSICS"
            }
          }' > "${RUNTIME_DIR}/epistemic_handover.json" 2>/dev/null || true
      else
        # Function-scoped: reused below for intake_failed diagnostics.
        brief_why="$(tail -n 1 "${brief_err}" 2>/dev/null || true)"
        if [[ "${intake_relaxed}" -eq 1 ]]; then
          aegis_warn "briefing: recusado (${brief_why:-?}) — relaxed: corpo mecânico"
        else
          aegis_warn "briefing: recusado (${brief_why:-?})"
        fi
      fi
      rm -f "${brief_err}"
    fi

    if [[ -z "${body}" ]]; then
      if [[ "${intake_relaxed}" -eq 1 ]]; then
        # Legacy path: derive accept from goal camelCase (can poison — opt-out only).
        if [[ "${#accepts[@]}" -eq 0 ]]; then
          local derived
          derived="$(derive_accept_tokens "${goal}")"
          if [[ -z "${derived}" ]]; then
            local p path_base
            for p in ${target}; do
              path_base="$(basename "${p}" | sed -E 's/\.[a-z]+$//')"
              if [[ "${path_base}" != "index" ]]; then
                derived="${path_base}"
                break
              fi
            done
          fi
          if [[ -n "${derived}" ]]; then
            while IFS= read -r t; do
              [[ -n "${t}" ]] && accepts+=("${t}")
            done <<< "${derived}"
            aegis_log "relaxed: acceptance do goal: $(printf '%s ' "${accepts[@]+"${accepts[@]}"}")"
          else
            aegis_fatal "missing_accept — o goal não nomeia código; dá --accept com o nome exacto (ex: --accept converterXEmY)"
          fi
        fi
        body="$(render_body "${goal}" "${target}")"
      else
        # Quality default: operator --accept builds a micro demand; free prose
        # without expand and without --accept is a hard fail (no Goal grepping)
        # — except transient provider rate-limit, where we derive acceptance
        # from named tokens in the goal so ./aegis --yes still progresses.
        if [[ "${#accepts[@]}" -eq 0 ]]; then
          # Agentic mode delegates all cognition to the assistant: a prose
          # demand that the supervisor refused must NOT fall back to grepping
          # poisoned acceptance tokens from the goal. Require structured
          # schema JSON (or explicit --accept) from the assistant instead.
          if [[ "${AEGIS_AGENTIC:-0}" == "1" ]]; then
            # Etapa 1/3: em modo agêntico, prosa sem --accept é handover, não
            # erro. Discovery & forensics já correram: entrega a evidência real
            # ao assistente e pausa (PENDING_ASSISTANT) para ele detalhar a
            # issue como schema JSON. Resume: ./aegis --resume --goal '<schema>'.
            emit_pending_assistant "${goal}" "${target}" "${intake_evidence:-}"
            return 1
          fi
          local _why_hint=""
          case "${brief_why:-}" in
            http_429*|*"rate_limit"*) _why_hint=" Provider em rate-limit (HTTP 429)." ;;
            missing_api_key)        _why_hint=" OPENAI_API_KEY / NVIDIA_API_KEY em falta." ;;
            http_401*|http_403*)      _why_hint=" Chave API rejeitada (401/403)." ;;
            empty_response*)          _why_hint=" Resposta do supervisor vazia." ;;
          esac

          local derived
          derived="$(derive_accept_tokens "${goal}")"
          if [[ -z "${derived}" ]]; then
            local p path_base
            for p in ${target}; do
              path_base="$(basename "${p}" | sed -E 's/\.[a-z]+$//')"
              if [[ "${path_base}" != "index" ]]; then
                derived="${path_base}"
                break
              fi
            done
          fi
          if [[ -n "${derived}" ]]; then
            while IFS= read -r t; do
              [[ -n "${t}" ]] && accepts+=("${t}")
            done <<< "${derived}"
            aegis_warn "briefing fallback (${brief_why:-offline}) — acceptance do goal: $(printf '%s ' "${accepts[@]+"${accepts[@]}"}")"
          fi

          if [[ "${#accepts[@]}" -eq 0 ]]; then
            aegis_fatal "intake_failed — expand supervisor (${AEGIS_SUPERVISOR_MODEL:-$(aegis_briefing_model 2>/dev/null || echo '?')}) recusado (${brief_why:-empty_response}).${_why_hint} Alternativas: re-tentar; --accept TokenBucket --accept obterEstadoBitmask; ou --relaxed (não recomendado)"
          fi
        fi
        body="$(render_body "${goal}" "${target}")"
        body="$(aegis_intake_ensure_briefing "${body}")"
        if [[ -n "${brief_why}" ]]; then
          aegis_log "intake: corpo mecânico (supervisor=${brief_why})"
        else
          aegis_log "intake: corpo a partir de --accept (sem expand)"
        fi
      fi
    fi

    # Quality gates (default): Briefing + Acceptance clean before fit/split/run.
    if [[ "${intake_relaxed}" -ne 1 ]]; then
      body="$(aegis_intake_strip_poison_acceptance_tokens "${body}")"
      body="$(aegis_intake_ensure_briefing "${body}")"
      local q_err
      q_err="$(mktemp)"
      if ! aegis_intake_quality_check "${body}" 2>"${q_err}"; then
        aegis_fatal "intake_quality_failed — $(tr '\n' ' ' < "${q_err}" | sed 's/[[:space:]]*$//') (corrige demanda ou --relaxed)"
      fi
      rm -f "${q_err}"
      aegis_log "intake: quality check ok"
    fi

    # Show → ask → maybe edit → re-check. fit_check owns the verdict and
    # the auto-fixes; go only reads them. The editor is the friendly
    # format: whatever you leave blank you can fill in here.
    local fit_json="" answer=""
    fit_json="$(printf '%s' "${body}" | bash scripts/fit_check_demand.sh 2>/dev/null || true)"
    if ! printf '%s' "${fit_json}" | jq -e '.schema == "aegis.fit_check.v1"' >/dev/null 2>&1; then
      aegis_fatal "fit_check_failed"
    fi
    body="$(printf '%s' "${fit_json}" | jq -r '.fixed_demand')"

    # fit_check may rewrite Acceptance via goal grepping — re-assert quality.
    if [[ "${intake_relaxed}" -ne 1 ]]; then
      body="$(aegis_intake_ensure_briefing "${body}")"
      # Strip poison tokens fit may have re-injected into Acceptance.
      body="$(aegis_intake_strip_poison_acceptance_tokens "${body}")"
      local q_err2
      q_err2="$(mktemp)"
      if ! aegis_intake_quality_check "${body}" 2>"${q_err2}"; then
        # Re-inject briefing stubs if fit emptied Briefing, then recheck once.
        body="$(aegis_intake_ensure_briefing "${body}")"
        if ! aegis_intake_quality_check "${body}" 2>"${q_err2}"; then
          aegis_fatal "intake_quality_failed_after_fit — $(tr '\n' ' ' < "${q_err2}" | sed 's/[[:space:]]*$//')"
        fi
      fi
      rm -f "${q_err2}"
    fi

    printf '%s\n\n' "${body}"
    printf 'fit: run_allowed=%s model_fit=%s score=%s\n' \
      "$(printf '%s' "${fit_json}" | jq -r '.run_allowed')" \
      "$(printf '%s' "${fit_json}" | jq -r '.model_fit')" \
      "$(printf '%s' "${fit_json}" | jq -r '.score')"

    # Multi-unit plan (when fit cannot run the demand as one shot).
    local parent_body="${body}"

    if ! printf '%s' "${fit_json}" | jq -e '.run_allowed == true' >/dev/null 2>&1; then
      printf 'blockers: %s\n' "$(printf '%s' "${fit_json}" | jq -r '.blockers | join(", ")')"
      parent_body="${body}"
      mkdir -p "${micros_dir}"
      local split_ok=0 split_err
      split_err="$(mktemp)"

      # Prefer mechanical multi-export (export_slice) when ## Briefing names 2+
      # top-level exports. Supervisor often packs class+function into one create
      # unit; the 8B coder then demotes the helper to a method and the pipeline
      # "succeeds" with wrong shape. Offline export_slice is deterministic.
      # (fit_check.sh is not always sourced here — count exports from Briefing text.)
      local export_n_parent=0
      export_n_parent="$(
        printf '%s\n' "${parent_body}" \
          | awk '/^## Briefing[[:space:]]*$/ { p=1; next } /^## / { p=0 } p' \
          | grep -oE 'export[[:space:]]+(class|function|const|let|var)[[:space:]]+[A-Za-z_][A-Za-z0-9_]*' 2>/dev/null \
          | awk '{ print $3 }' \
          | awk 'NF && !seen[$0]++' \
          | grep -c . || true
      )"
      export_n_parent="${export_n_parent//[^0-9]/}"
      export_n_parent="${export_n_parent:-0}"

      if [[ "${export_n_parent}" -ge 2 ]]; then
        aegis_log "briefing multi-export (${export_n_parent}) — split mecânico export_slice..."
        rm -f "${micros_dir}"/unit-*.md "${micros_dir}/fit.json" 2>/dev/null || true
        printf '%s\n' "${parent_body}" \
          | bash scripts/fit_check_demand.sh --emit-micros "${micros_dir}" \
            >/dev/null 2>&1 || true
        if [[ -f "${micros_dir}/unit-0.md" ]] \
          && [[ "$(count_micro_units "${micros_dir}")" -ge 2 ]]; then
          split_ok=1
          aegis_log "split mecânico ok — $(count_micro_units "${micros_dir}") tasks"
        fi
      fi

      # Supervisor split: intent + export load when mechanical multi-export did not apply.
      if [[ "${split_ok}" -eq 0 ]] && aegis_supervisor_split_enabled 2>/dev/null; then
        local _sup_model
        _sup_model="$(aegis_briefing_model 2>/dev/null || printf 'supervisor')"
        aegis_log "demanda complexa — supervisor split (${_sup_model})..."
        if aegis_supervisor_split_generate "${parent_body}" "${micros_dir}" 2>"${split_err}"; then
          if [[ -f "${micros_dir}/unit-0.md" ]] \
            && [[ "$(count_micro_units "${micros_dir}")" -ge 2 ]]; then
            split_ok=1
            aegis_log "supervisor split ok — $(count_micro_units "${micros_dir}") tasks"
          fi
        else
          aegis_warn "supervisor split recusado ($(tail -n 1 "${split_err}" 2>/dev/null || true)) — fallback mecânico"
        fi
      fi

      # Mechanical path/reexport split (always available offline).
      if [[ "${split_ok}" -eq 0 ]]; then
        aegis_log "fatiando mecanicamente para micro-unidades..."
        rm -f "${micros_dir}"/unit-*.md "${micros_dir}/fit.json" 2>/dev/null || true
        printf '%s\n' "${parent_body}" \
          | bash scripts/fit_check_demand.sh --emit-micros "${micros_dir}" \
            >/dev/null 2>&1 || true
        if [[ -f "${micros_dir}/unit-0.md" ]]; then
          split_ok=1
          aegis_log "split mecânico ok — $(count_micro_units "${micros_dir}") tasks"
        fi
      fi
      rm -f "${split_err}"

      if [[ "${split_ok}" -eq 1 ]]; then
        multi_unit=1
        resume_start_unit=0
        body="$(build_multiunit_plan_body "${parent_body}" "${micros_dir}")"
        print_micro_plan "${micros_dir}"
        printf '%s\n\n' "${body}"
      else
        aegis_fatal "demand_does_not_fit — aperta o Goal ou parte em dois go"
      fi
    fi

    if [[ "${assume_yes}" -ne 1 ]] && ! aegis_is_ai_agent; then
      while true; do
        if [[ "${multi_unit}" -eq 1 ]]; then
          printf 'Aprovar plano (%s tasks) e correr? [y/N/e (editar plano)] ' \
            "$(count_micro_units "${micros_dir}")"
        else
          printf 'Criar issue e correr? [y/N/e (editar)] '
        fi
        read -r answer || answer=""
        case "${answer}" in
          y|Y|yes|s|S|sim) break ;;
          e|E|editar)
            printf '%s' "${body}" > "${DRAFT_FILE}"
            "${EDITOR:-vi}" "${DRAFT_FILE}" || true
            body="$(cat "${DRAFT_FILE}")"
            [[ -n "$(printf '%s' "${body}" | tr -d '[:space:]')" ]] \
              || aegis_fatal "draft_vazio"
            if [[ "${multi_unit}" -eq 1 ]]; then
              # Plan body is multi-target by design — do not re-fit as one demand.
              # Unit files on disk remain the execution contract.
              printf '%s\n\n' "${body}"
              print_micro_plan "${micros_dir}"
            else
              if [[ "${intake_relaxed}" -ne 1 ]]; then
                body="$(aegis_intake_ensure_briefing "${body}")"
                local qe
                qe="$(mktemp)"
                if ! aegis_intake_quality_check "${body}" 2>"${qe}"; then
                  aegis_fatal "intake_quality_failed_after_edit — $(tr '\n' ' ' < "${qe}" | sed 's/[[:space:]]*$//')"
                fi
                rm -f "${qe}"
              fi
              fit_json="$(printf '%s' "${body}" | bash scripts/fit_check_demand.sh 2>/dev/null || true)"
              body="$(printf '%s' "${fit_json}" | jq -r '.fixed_demand // empty')"
              [[ -n "${body}" ]] || aegis_fatal "draft_vazio"
              if [[ "${intake_relaxed}" -ne 1 ]]; then
                body="$(aegis_intake_ensure_briefing "${body}")"
                body="$(aegis_intake_strip_poison_acceptance_tokens "${body}")"
                qe="$(mktemp)"
                if ! aegis_intake_quality_check "${body}" 2>"${qe}"; then
                  aegis_fatal "intake_quality_failed_after_edit_fit — $(tr '\n' ' ' < "${qe}" | sed 's/[[:space:]]*$//')"
                fi
                rm -f "${qe}"
              fi
              printf '%s\n\n' "${body}"
              printf 'fit: run_allowed=%s\n' \
                "$(printf '%s' "${fit_json}" | jq -r '.run_allowed')"
              printf '%s' "${fit_json}" | jq -e '.run_allowed == true' >/dev/null 2>&1 \
                || aegis_fatal "demand_does_not_fit — o draft editado não cabe"
            fi
            ;;
          *)
            aegis_log "cancelado; nada foi criado"
            rm -rf "${micros_dir}" >/dev/null 2>&1 || true
            emit_result_json "CANCELLED" "" "" "operator_declined"
            return 1
            ;;
        esac
      done
    fi

    # The demand is the single source of truth for the target: an edited
    # ## Targets must win over whatever was proposed or passed.
    # Multi-unit: first unit target (batch walks each unit's own paths).
    if [[ "${multi_unit}" -eq 1 ]]; then
      target="$(unit_target_paths "${micros_dir}/unit-0.md" | head -1)"
    else
      target="$(aegis_extract_operator_named_paths "${body}" | head -1)"
    fi
    [[ -n "${target}" ]] || aegis_fatal "demand_sem_target"

    title="$(printf '%s' "${goal}" | tr '\n' ' ' | cut -c1-72)"

    command -v gh >/dev/null 2>&1 || aegis_fatal "missing_gh"
    gh_run label create aegis --force >/dev/null 2>&1 \
      || aegis_warn "label 'aegis' não criada; a issue fica sem label"

    local url=""
    url="$(printf '%s' "${body}" | gh_run issue create \
      --title "${title}" --body-file - --label aegis || true)"
    # gh may print progress lines before the URL; only the last line is it.
    # Parsing the whole output would report a created issue as failed, and
    # the retry would open a second one.
    issue="$(
      printf '%s' "${url}" | grep -E '/[0-9]+$' | tail -1 \
        | sed -E 's|.*/([0-9]+)$|\1|'
    )"
    [[ "${issue}" =~ ^[0-9]+$ ]] || aegis_fatal "issue_create_failed"
    aegis_log "issue #${issue} criada"

    seed_issue_cache "${issue}" "${title}" "${body}"
    if [[ "${multi_unit}" -eq 1 ]]; then
      mkdir -p "${micros_dir}" 2>/dev/null || true
      printf '%s\n' "${issue}" > "${micros_dir}/issue.id"
    fi
  fi

  # A net-new module is a legitimate target (the canonical example is
  # "Create src/tokenBucket.ts"), so only the parent has to exist.
  target="${target#./}"
  case "${target}" in
    /*|*..*) aegis_fatal "unsafe_target:${target}" ;;
  esac
  [[ -d "$(dirname "${target}")" ]] || aegis_fatal "target_dir_not_found:${target}"

  local auto_micros_present=0
  local micros_dir=".harness/micros_auto"
  if [[ -d "${micros_dir}" && -f "${micros_dir}/unit-0.md" ]]; then
    auto_micros_present=1
  fi

  # Dirty check: single-shot uses one target; multi-unit checks every unit path.
  if [[ "${auto_micros_present}" -eq 1 ]]; then
    local _up _ui=0
    local _all_paths=""
    while [[ -f "${micros_dir}/unit-${_ui}.md" ]]; do
      _all_paths+="$(unit_target_paths "${micros_dir}/unit-${_ui}.md")"$'\n'
      _ui=$((_ui + 1))
    done
    while IFS= read -r _up; do
      [[ -n "${_up}" ]] || continue
      _up="${_up#./}"
      case "${_up}" in
        /*|*..*) aegis_fatal "unsafe_target:${_up}" ;;
      esac
      if [[ -e "${_up}" ]] || [[ -d "$(dirname "${_up}")" ]]; then
        target_is_clean "${_up}" \
          || aegis_fatal "target_dirty:${_up} — a promoção recusa ficheiros sujos; commit ou stash primeiro"
      fi
    done < <(printf '%s' "${_all_paths}" | awk 'NF && !seen[$0]++')
  else
    target_is_clean "${target}" \
      || aegis_fatal "target_dirty:${target} — a promoção recusa ficheiros sujos; commit ou stash primeiro"
  fi

  # Preserve issue identity across runtime wipe (run_aegis --fresh cleans residue).
  local cached_issue_title="" cached_issue_body=""
  if [[ -n "${issue}" && -f "${ISSUE_CACHE_DIR}/issue_${issue}.md" ]]; then
    cached_issue_title="$(
      head -n 1 "${ISSUE_CACHE_DIR}/issue_${issue}.md" \
        | sed -E 's/^# Issue #[0-9]+: //'
    )"
    cached_issue_body="$(
      tail -n +3 "${ISSUE_CACHE_DIR}/issue_${issue}.md" 2>/dev/null || true
    )"
  fi

  # Pre-flight workspace sanitization (clean stale runtime residue & stale worktrees).
  # Preserve pipeline_metrics.jsonl: session already holds intake (supervisor)
  # tokens; a full rm -rf .harness/runtime used to wipe them before multi-unit.
  local _metrics_save="" _handover_save="" _agentic_save=""
  if [[ -n "${AEGIS_METRICS_FILE:-}" && -f "${AEGIS_METRICS_FILE}" ]]; then
    _metrics_save="$(mktemp "${TMPDIR:-/tmp}/aegis_metrics.XXXXXX")"
    cp "${AEGIS_METRICS_FILE}" "${_metrics_save}" 2>/dev/null || _metrics_save=""
  fi
  if [[ -f "${RUNTIME_DIR}/epistemic_handover.json" ]]; then
    _handover_save="$(mktemp "${TMPDIR:-/tmp}/aegis_handover.XXXXXX")"
    cp "${RUNTIME_DIR}/epistemic_handover.json" "${_handover_save}" 2>/dev/null || _handover_save=""
  fi
  # Etapa 5/6: preserva o estado agêntico (pending + verdicts de optimize/
  # adversarial) através do wipe — o resume do pipeline precisa deles.
  if [[ -f "${RUNTIME_DIR}/pending_assistant.json" ]] \
    || [[ -f "${RUNTIME_DIR}/optimize_verdict.json" ]] \
    || [[ -f "${RUNTIME_DIR}/adversarial_verdict.json" ]]; then
    _agentic_save="$(mktemp -d "${TMPDIR:-/tmp}/aegis_agentic.XXXXXX")"
    cp "${RUNTIME_DIR}/pending_assistant.json" "${_agentic_save}/" 2>/dev/null || true
    cp "${RUNTIME_DIR}/optimize_verdict.json" "${_agentic_save}/" 2>/dev/null || true
    cp "${RUNTIME_DIR}/adversarial_verdict.json" "${_agentic_save}/" 2>/dev/null || true
  fi
  rm -rf .harness/runtime .harness/execution_surfaces >/dev/null 2>&1 || true
  git worktree prune >/dev/null 2>&1 || true
  mkdir -p "${RUNTIME_DIR}" 2>/dev/null || true
  if [[ -n "${_handover_save}" && -f "${_handover_save}" ]]; then
    mv "${_handover_save}" "${RUNTIME_DIR}/epistemic_handover.json" 2>/dev/null || true
  fi
  if [[ -n "${_agentic_save}" ]]; then
    mv "${_agentic_save}/pending_assistant.json" "${RUNTIME_DIR}/" 2>/dev/null || true
    mv "${_agentic_save}/optimize_verdict.json" "${RUNTIME_DIR}/" 2>/dev/null || true
    mv "${_agentic_save}/adversarial_verdict.json" "${RUNTIME_DIR}/" 2>/dev/null || true
    rm -rf "${_agentic_save}" 2>/dev/null || true
  fi
  if [[ -n "${_metrics_save}" && -f "${_metrics_save}" ]]; then
    export AEGIS_METRICS_FILE="${RUNTIME_DIR}/pipeline_metrics.jsonl"
    mv "${_metrics_save}" "${AEGIS_METRICS_FILE}" 2>/dev/null || true
    export AEGIS_METRICS_APPEND=1
  else
    rm -f "${_metrics_save}" 2>/dev/null || true
    # Session may not have started yet (resume-only path) — begin now.
    if [[ -z "${AEGIS_METRICS_FILE:-}" || ! -f "${AEGIS_METRICS_FILE:-/dev/null}" ]]; then
      aegis_metrics_session_begin
    fi
  fi
  if [[ -n "${issue}" && -n "${cached_issue_body}" ]]; then
    seed_issue_cache "${issue}" "${cached_issue_title:-issue}" "${cached_issue_body}"
  fi

  local committed="" last_commit=""

  if [[ "${auto_micros_present}" -eq 1 ]]; then
    # ── Multi-unit batch ──────────────────────────────────────────
    # Policy (operator decisions):
    #   1) keep-progress: unit K fails → units 0..K-1 stay committed
    #   2) y already approved the whole plan (resume confirms retake)
    #   3) per-unit Aegis-Accept commit + issue Task [x]
    #   4) resume: skip [x], start at first open task
    #   5) --force-task K: reopen K, run K even if was [x], then continue
    #   6) AEGIS_SQUASH_BATCH=1: soft-squash unit commits into one at the end
    local unit_total unit_idx unit_file u_status unit_sha task_n
    local issue_body_live="" ran_any=0 batch_start_commit=""
    local brief_corrected=0
    local -a batch_accepts=()
    unit_total="$(count_micro_units "${micros_dir}")"
    unit_idx=0
    if [[ -n "${resume_start_unit}" && "${resume_start_unit}" =~ ^[0-9]+$ ]]; then
      unit_idx="${resume_start_unit}"
    fi
    last_commit=""
    batch_start_commit="$(git rev-parse HEAD 2>/dev/null || true)"
    printf '%s\n' "${issue}" > "${micros_dir}/issue.id" 2>/dev/null || true

    # Latest checklist from GitHub (resume may have [x] already).
    issue_body_live="$(gh_run issue view "${issue}" --json body -q .body 2>/dev/null || true)"
    [[ -n "${issue_body_live}" ]] || issue_body_live="${cached_issue_body:-}"
    # Local force-task reopen may not have reached gh yet.
    if [[ -n "${force_task_n}" ]]; then
      issue_body_live="$(aegis_md_uncheck_task "${issue_body_live}" "${force_task_n}")"
    fi

    aegis_log "batch multi-unit: ${unit_total} tasks, start unit-${unit_idx} (keep-progress)"

    while [[ "${unit_idx}" -lt "${unit_total}" ]]; do
      unit_file="${micros_dir}/unit-${unit_idx}.md"
      task_n=$((unit_idx + 1))

      if [[ -n "${issue_body_live}" ]] && aegis_md_task_is_done "${issue_body_live}" "${task_n}"; then
        # force-task: never skip the forced task on this run.
        if [[ -z "${force_task_n}" || "${task_n}" -ne "${force_task_n}" ]]; then
          aegis_log "task ${task_n}/${unit_total} já [x] — skip"
          unit_idx=$((unit_idx + 1))
          continue
        fi
      fi

      aegis_log "executando task ${task_n}/${unit_total} [unit-${unit_idx}]..."
      ran_any=1

      set +e
      # Etapa 5/6: se há pending de optimize/adversarial cujos targets casam
      # com os da unit actual, retoma via --resume (sem wipe) em vez de --fresh.
      local _pending_resume=0
      if [[ -f "${RUNTIME_DIR}/pending_assistant.json" ]] \
        && [[ "$(jq -r '.stage // "intake"' "${RUNTIME_DIR}/pending_assistant.json" 2>/dev/null || printf 'intake')" != "intake" ]]; then
        local _p_targets _u_targets
        _p_targets="$(
          jq -r '.demand_anchors.seed_targets[]? // .demand_anchors.operator_named_paths[]? // empty' \
            "${RUNTIME_DIR}/pending_assistant.json" 2>/dev/null | sort -u
        )"
        _u_targets="$(unit_target_paths "${unit_file}" | sort -u)"
        if [[ -n "${_p_targets}" ]] && [[ "${_p_targets}" == "${_u_targets}" ]]; then
          _pending_resume=1
        fi
      fi
      if [[ "${_pending_resume}" -eq 1 ]]; then
        aegis_log "resume: task ${task_n} com pending agêntico — a retomar sem --fresh"
        # Passa a demanda da unit (a mesma que criou o handover) em vez de
        # --issue: --issue re-buscaria o corpo completo com as 3 tasks e
        # causaria investigation_input_mismatch contra o handover da unit.
        AEGIS_METRICS_APPEND=1 \
          AEGIS_METRICS_UNIT="${unit_idx}" \
          AEGIS_METRICS_FILE="${AEGIS_METRICS_FILE}" \
          AEGIS_ROOT_DIR="${ROOT}" \
          bash "${ROOT}/run_aegis.sh" --resume --pipeline mutation "$(cat "${unit_file}")"
      else
        AEGIS_METRICS_APPEND=1 \
          AEGIS_METRICS_UNIT="${unit_idx}" \
          AEGIS_METRICS_FILE="${AEGIS_METRICS_FILE}" \
          AEGIS_ROOT_DIR="${ROOT}" \
          bash "${ROOT}/run_aegis.sh" --fresh --from-fit "${micros_dir}" --unit "${unit_idx}"
      fi
      set -e

      u_status="$(outcome_field pipeline_status)"
      [[ -n "${u_status}" ]] || u_status="$(outcome_field status)"

      # Etapa 5/6: a unit concluiu a pausa — limpa o estado agêntico desta
      # unit para não contaminar a próxima (targets podem repetir-se).
      if [[ "${u_status}" == "SUCCESS" ]]; then
        rm -f "${RUNTIME_DIR}/pending_assistant.json" \
          "${RUNTIME_DIR}/optimize_verdict.json" \
          "${RUNTIME_DIR}/adversarial_verdict.json" 2>/dev/null || true
      fi

      if [[ "${u_status}" != "SUCCESS" ]]; then
        # Briefing-correction loop (semantic backstop). When the brief was
        # invented by the supervisor and the adversarial found contradictions
        # against the original Goal, regenerate the unit Briefing from the
        # original intent + findings and re-run (bounded).
        if [[ "${AEGIS_BRIEFING_SOURCE:-}" == "supervisor" ]] \
          && [[ "${brief_corrected}" -lt "${AEGIS_BRIEFING_CORRECT_MAX:-1}" ]]; then
          local _findings _ug _ut _corr_body _corr_brief
          _findings="$(
            jq -c '.artifact_snapshot.operational_context.findings // []' \
              "${RUNTIME_DIR}/epistemic_handover.json" 2>/dev/null || printf '[]'
          )"
          if [[ "$(printf '%s' "${_findings}" | jq 'length' 2>/dev/null || printf '0')" -gt 0 ]]; then
            _ug="$(awk '/^## Goal[[:space:]]*$/ {p=1; next} /^## / && p {p=0} p' "${unit_file}" | paste -sd' ' -)"
            _ut="$(unit_target_paths "${unit_file}" | head -1)"
            aegis_log "briefing: findings do adversarial — regerando brief com supervisor..."
            _corr_body="$(
              aegis_briefing_generate "${_ug}" "${_ut}" \
"ADVERSARIAL FINDINGS against the original demand semantics:
${_findings}

Rewrite the Briefing so the implementation satisfies the original Goal. Fix algorithm/behavior contradictions; keep the same exported API shape." \
                2>/dev/null
            )" || _corr_body=""
            _corr_brief="$(
              printf '%s' "${_corr_body}" \
                | awk '/^## Briefing[[:space:]]*$/ {p=1; print; next} /^## / && p {p=0} p'
            )"
            if [[ -n "$(printf '%s' "${_corr_brief}" | tr -d '[:space:]')" ]]; then
              local _tmp_b
              _tmp_b="$(mktemp)"
              if awk -v nb="${_corr_brief}" '
                  /^## Briefing[[:space:]]*$/ {inb=1; print nb; next}
                  /^## / && inb {inb=0}
                  !inb {print}
                ' "${unit_file}" > "${_tmp_b}" 2>/dev/null && mv "${_tmp_b}" "${unit_file}"; then
                brief_corrected=$((brief_corrected + 1))
                aegis_log "brief corrigido (${brief_corrected}/${AEGIS_BRIEFING_CORRECT_MAX:-1}) — re-executando task ${task_n}"
                continue
              fi
              rm -f "${_tmp_b}" 2>/dev/null || true
            fi
          fi
        fi

        aegis_warn "task ${task_n}/${unit_total} falhou (${u_status:-UNKNOWN}) — progresso anterior mantido"
        [[ -n "${last_commit}" ]] && printf 'last_ok_commit: %s\n' "${last_commit}"
        printf 'next: ./aegis %s   # retoma; ou --force-task %s para reabrir\n' \
          "${issue}" "${task_n}"
        gh_run issue comment "${issue}" --body "$(
          cat <<EOF
### AEGIS OUTCOME (partial)
- status: \`${u_status:-UNKNOWN}\`
- failed_task: ${task_n}/${unit_total} (unit-${unit_idx})
- last_ok_commit: \`${last_commit:-n/a}\`
- policy: keep-progress — tasks anteriores permanecem no git e na checklist
- next: \`./aegis ${issue}\` or \`--force-task ${task_n}\`
EOF
        )" >/dev/null 2>&1 || true
        # Keep micros_auto for resume/debug; do not roll back commits.
        emit_result_json "PARTIAL" "${issue}" "${last_commit}" "unit_${unit_idx}_failed"
        return 1
      fi

      unit_sha="$(commit_unit_checkpoint "${issue}" "${unit_idx}" "${unit_total}" "${unit_file}" || true)"
      if [[ -z "${unit_sha}" ]]; then
        aegis_warn "task ${task_n}/${unit_total} SUCCESS no pipeline mas nada a commitar — a parar (keep-progress)"
        gh_run issue comment "${issue}" --body "$(
          printf '### AEGIS OUTCOME (partial)\n- status: NO_CHANGE\n- failed_task: %s/%s\n- last_ok_commit: `%s`\n- next: `./aegis %s`\n' \
            "${task_n}" "${unit_total}" "${last_commit:-n/a}" "${issue}"
        )" >/dev/null 2>&1 || true
        emit_result_json "PARTIAL" "${issue}" "${last_commit}" "unit_${unit_idx}_empty_promotion"
        return 1
      fi

      last_commit="${unit_sha}"
      aegis_log "task ${task_n}/${unit_total} commit ${unit_sha}"

      # Collect accepts for optional end-of-batch squash.
      local _acc
      _acc="$(unit_acceptance_csv "${unit_file}")"
      if [[ -n "${_acc}" ]]; then
        local _tok
        while IFS= read -r _tok; do
          [[ -n "${_tok}" ]] && batch_accepts+=("${_tok}")
        done < <(printf '%s' "${_acc}" | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | grep -v '^$')
      fi

      if issue_mark_task_done "${issue}" "${task_n}"; then
        aegis_log "issue #${issue}: Task ${task_n} → [x]"
        issue_body_live="$(aegis_md_check_task "${issue_body_live}" "${task_n}")"
      else
        aegis_warn "issue #${issue}: não marquei Task ${task_n} [x] (gh) — commit ${unit_sha} mantém-se"
      fi

      gh_run issue comment "${issue}" --body "$(
        printf '### AEGIS OUTCOME\n- status: SUCCESS\n- task: %s/%s\n- commit: `%s`\n' \
          "${task_n}" "${unit_total}" "${unit_sha}"
      )" >/dev/null 2>&1 || true

      unit_idx=$((unit_idx + 1))
    done

    if [[ "${ran_any}" -eq 0 && -z "${last_commit}" ]]; then
      aegis_log "nada a correr — todas as tasks já estavam [x]"
      emit_result_json "SUCCESS" "${issue}" "" "all_tasks_already_done"
      return 0
    fi

    # Optional cosmetic squash: one managed commit with the union of accepts.
    # Default off — per-unit commits remain the source of truth for keep-progress.
    case "${AEGIS_SQUASH_BATCH:-0}" in
      1|true|yes)
        if [[ -n "${batch_start_commit}" ]] \
          && [[ "$(git rev-parse HEAD 2>/dev/null || true)" != "${batch_start_commit}" ]]; then
          local squash_accept squash_summary squash_msg
          squash_accept="$(
            printf '%s\n' "${batch_accepts[@]+"${batch_accepts[@]}"}" \
              | awk 'NF && !seen[$0]++' \
              | paste -sd',' - | sed 's/,/, /g'
          )"
          [[ -n "${squash_accept}" ]] || squash_accept="batch"
          squash_summary="$(printf '%s' "${squash_accept}" | cut -d',' -f1 | sed 's/^[[:space:]]*//')"
          mkdir -p "${RUNTIME_DIR}" 2>/dev/null || true
          squash_msg="${COMMIT_MSG_FILE}.batch-squash"
          aegis_record_render_message "${issue}" "${squash_summary}" "${squash_accept}" \
            "1/${unit_total}" > "${squash_msg}"
          # Soft-reset unit checkpoints; keep tree; one new commit.
          if git reset --soft "${batch_start_commit}" >/dev/null 2>&1 \
            && ! git diff --cached --quiet 2>/dev/null \
            && git commit -F "${squash_msg}" >/dev/null 2>&1; then
            last_commit="$(git rev-parse --short HEAD 2>/dev/null || true)"
            aegis_log "AEGIS_SQUASH_BATCH: commits das units fundidos em ${last_commit}"
          else
            aegis_warn "AEGIS_SQUASH_BATCH falhou — commits por unit mantêm-se"
          fi
          rm -f "${squash_msg}" 2>/dev/null || true
        fi
        ;;
    esac

    # Ephemeral -F inputs (unit-* / batch-squash); never leave as repo litter.
    rm -f "${COMMIT_MSG_FILE}".unit-* "${COMMIT_MSG_FILE}.batch-squash" 2>/dev/null || true
    rm -rf "${micros_dir}" >/dev/null 2>&1 || true

    gh_run issue close "${issue}" --comment "$(
      printf '### AEGIS OUTCOME\n- status: SUCCESS\n- batch: %s/%s tasks\n- last_commit: `%s`\n' \
        "${unit_total}" "${unit_total}" "${last_commit}"
    )" >/dev/null 2>&1 || aegis_warn "issue #${issue} não fechada (gh falhou)"

    emit_result_json "SUCCESS" "${issue}" "${last_commit}" ""
    return 0
  fi

  # ── Single-unit path (human commit gate) ──────────────────────
  set +e
  if [[ "${resume}" -eq 1 ]] \
    && [[ -f "${RUNTIME_DIR}/pending_assistant.json" ]] \
    && [[ "$(jq -r '.stage // "intake"' "${RUNTIME_DIR}/pending_assistant.json" 2>/dev/null || printf 'intake')" != "intake" ]]; then
    # Etapas 5/6: pausa de optimize/adversarial — retoma o pipeline pelo
    # handover (verdict file já gravado pelo assistente), sem --fresh.
    aegis_log "resume: pipeline pausado — retomando sem --fresh"
    bash "${ROOT}/run_aegis.sh" --resume --pipeline mutation --issue "${issue}"
  else
    bash "${ROOT}/run_aegis.sh" --fresh --pipeline mutation --issue "${issue}"
  fi
  set -e

  local status reason_class reason_code next_step
  status="$(outcome_field pipeline_status)"
  [[ -n "${status}" ]] || status="$(outcome_field status)"
  reason_class="$(outcome_field reason_class)"
  reason_code="$(outcome_field reason_code)"
  next_step="$(outcome_field next_step)"

  if [[ "${status}" != "SUCCESS" ]]; then
    aegis_warn "run ${status:-UNKNOWN} class=${reason_class:-—} reason=${reason_code:-—}"
    [[ -n "${next_step}" ]] && printf 'next: %s\n' "${next_step}"
    gh_run issue comment "${issue}" --body "$(
      printf '### AEGIS OUTCOME\n- status: %s\n- class: %s\n- reason: %s\n- commit: n/a\n' \
        "${status:-UNKNOWN}" "${reason_class:-—}" "${reason_code:-—}"
    )" >/dev/null 2>&1 || true
    emit_result_json "${status:-UNKNOWN}" "${issue}" "" "${reason_code}"
    return 1
  fi

  # The target was clean before the run over this same pathspec, so what
  # changed under it now is exactly what the promotion applied.
  local paths
  paths="$(target_changes "${target}")"
  if [[ -z "${paths}" ]]; then
    aegis_warn "nada promovido no worktree — nada a commitar"
    emit_result_json "NO_CHANGE" "${issue}" "" "empty_promotion"
    return 1
  fi

  # Always from the demand that actually ran, never from the flags: the
  # draft may have been edited, and the record has to match what was asked.
  local accept_csv summary
  accept_csv="$(
    awk '/^## Acceptance$/ { p = 1; next } /^## / { p = 0 } p' \
      "${ISSUE_CACHE_DIR}/issue_${issue}.md" 2>/dev/null \
      | sed -E 's/^[[:space:]]*-[[:space:]]*//' \
      | grep -v '^$' | paste -sd',' - | sed 's/,/, /g'
  )"
  # No Acceptance means no Aegis-Accept, and a managed commit without it
  # would not be record at all — a silent hole in the very thing the gate
  # exists to write. Refuse instead.
  [[ -n "${accept_csv}" ]] \
    || aegis_fatal "issue_has_no_acceptance:${issue} — sem tokens não há registo a escrever"
  summary="$(printf '%s' "${accept_csv}" | cut -d',' -f1)"

  aegis_record_render_message "${issue}" "${summary}" "${accept_csv}" \
    > "${COMMIT_MSG_FILE}"

  # Stage first: the gate has to show what is being approved, and a
  # net-new file only appears in a diff once it is in the index.
  local p=""
  while IFS= read -r p; do
    [[ -n "${p}" ]] && git add -- "${p}" || true
  done <<< "${paths}"

  printf '\n[GATE] issue#%s\n' "${issue}"
  git diff --cached --stat -- "${target}" || true
  printf '\nO editor abre com a mensagem pronta. Grava para commitar,\n'
  printf 'esvazia o buffer para cancelar. Acrescenta Aegis-Why se quiseres.\n\n'

  # Without a TTY there is nobody at the gate, and a commit nobody
  # approved is exactly what the gate exists to prevent. Leave the paths
  # staged with the message ready and hand over the one command.
  if [[ ! -t 0 ]]; then
    aegis_warn "sem TTY: o gate não commita sozinho"
    printf '\nPara fechar:\n\n  git commit -e -F "%s"\n' "${COMMIT_MSG_FILE}"
    printf '  gh issue close %s --comment "commit $(git rev-parse --short HEAD)"\n\n' \
      "${issue}"
    emit_result_json "PENDING_GATE" "${issue}" "" "no_tty"
    return 1
  fi

  set +e
  git commit -e -F "${COMMIT_MSG_FILE}"
  local commit_rc=$?
  set -e

  if [[ "${commit_rc}" -ne 0 ]]; then
    while IFS= read -r p; do
      [[ -n "${p}" ]] && git reset --quiet HEAD -- "${p}" 2>/dev/null || true
    done <<< "${paths}"
    # Keep commit.msg: status "gate por fechar" + operator can re-run -F.
    aegis_warn "commit cancelado — as alterações ficam no worktree"
    emit_result_json "UNCOMMITTED" "${issue}" "" "gate_cancelled"
    return 1
  fi

  # Gate closed; message lives in the commit object only.
  rm -f "${COMMIT_MSG_FILE}" 2>/dev/null || true

  committed="$(git rev-parse --short HEAD)"
  aegis_log "commit ${committed}"

  gh_run issue close "${issue}" --comment "$(
    printf '### AEGIS OUTCOME\n- status: SUCCESS\n- commit: `%s`\n- paths: %s\n' \
      "${committed}" "$(printf '%s' "${paths}" | tr '\n' ' ')"
  )" >/dev/null 2>&1 || aegis_warn "issue #${issue} não fechada (gh falhou)"

  # Clean transient micro plan files upon success
  clear_micro_plan_cache

  emit_result_json "SUCCESS" "${issue}" "${committed}" ""
}

cmd_split() {
  local input="${1:-}"
